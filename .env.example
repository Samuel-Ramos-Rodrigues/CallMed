# Banco PostgreSQL / Neon
ConnectionStrings__MKSANContextConnection=
Database__AutoMigrate=false
Database__ApplyV12Patch=true
Database__ApplyV13Patch=true
Database__ApplyV14Patch=true
Database__ApplyV15Patch=true
Database__ApplyV16Patch=true
Database__ApplyV21Patch=true

# Dados da clínica exibidos pelo sistema e usados pelo assistente
Clinica__Nome=CallMed
Clinica__Endereco=
Clinica__Telefone=
Clinica__Whatsapp=
Clinica__Email=
Clinica__HorarioFuncionamento=
Clinica__FormasPagamento=
Clinica__ConveniosAceitos=

# Gemini
Gemini__ApiKey=
Gemini__Model=gemini-3.1-flash-lite
Gemini__TimeoutSeconds=60
Gemini__MaxToolRounds=8
Gemini__MaxHistoryMessages=30

# Envio de e-mail via Brevo SMTP
# Gere credenciais em Brevo > SMTP & API e verifique o remetente.
Smtp__Host=smtp-relay.brevo.com
Smtp__Port=2525
Smtp__Username=
Smtp__Password=
Smtp__FromEmail=
Smtp__FromName=CallMed
Smtp__ReplyToEmail=
Smtp__EnableSsl=true


# Leitura Gmail API: respostas administrativas elegíveis podem ser automáticas conforme Atendimento__Email__EnviarRespostasAutomaticamente; casos sensíveis exigem revisão.
# Gere OAuth Client ID/Client Secret no Google Cloud e um refresh token com o escopo gmail.modify.
GmailInbox__Enabled=false
GmailInbox__MailboxEmail=callmed.atendimento@gmail.com
GmailInbox__ClientId=
GmailInbox__ClientSecret=
GmailInbox__RefreshToken=
# Timestamp ISO-8601 em UTC para início da leitura; configure pouco antes do deploy.
GmailInbox__StartAfterUtc=
GmailInbox__PollIntervalSeconds=90
GmailInbox__MaxMessagesPerCycle=20
GmailInbox__MarkProcessedAsRead=true
GmailInbox__ProcessedLabelName=CALLMED_PROCESSADO

# Bootstrap opcional do primeiro administrador.
# Habilite apenas no primeiro deploy e desabilite depois.
# A senha deve ter 8+ caracteres, maiúscula, minúscula, número e símbolo/pontuação (espaços não contam).
BootstrapAdmin__Enabled=false
BootstrapAdmin__Email=
BootstrapAdmin__Password=
BootstrapAdmin__Name=

# Atendimento multicanal - WhatsApp via Evolution API
Atendimento__WhatsApp__Evolution__Enabled=false
Atendimento__WhatsApp__Evolution__BaseUrl=
Atendimento__WhatsApp__Evolution__ApiKey=
Atendimento__WhatsApp__Evolution__InstanceName=callmed
Atendimento__WhatsApp__Evolution__PublicNumber=
Atendimento__WhatsApp__Evolution__WebhookSecret=

# SMS - httpSMS (https://api.httpsms.com/v1)
# Guia: docs/HTTP-SMS.md
Atendimento__Sms__Http__Enabled=false
Atendimento__Sms__Http__BaseUrl=https://api.httpsms.com/v1
Atendimento__Sms__Http__SendPath=/messages/send
Atendimento__Sms__Http__ApiKey=SUA_API_KEY_DO_HTTPSMS
Atendimento__Sms__Http__From=+55DDDNUMERO_DO_CHIP_VINCULADO
Atendimento__Sms__Http__WebhookSecret=SUA_SIGNING_KEY_ALEATORIA_COM_32_OU_MAIS_CARACTERES

# TWA / Android
Twa__Enabled=true
Twa__PackageName=com.callmed.app
Twa__Origin=https://callmed.onrender.com

# Atendimento administrativo automático por e-mail. O portal conclui o agendamento.
Atendimento__Email__EnviarRespostasAutomaticamente=true
Atendimento__Email__RetomarPendencias=true
Atendimento__Email__JanelaPendenciasHoras=24
# Opcional: URL HTTPS pública da clínica. Vazio usa RENDER_EXTERNAL_URL ou Twa__Origin.
Atendimento__Email__PortalBaseUrl=
# Debug/teste. Em produção, troque pela SHA-256 da assinatura Play/App Signing.
Twa__Sha256CertFingerprints__0=DE:D7:D2:5E:3F:33:F8:E3:C2:7B:88:42:FC:D0:F0:0E:C7:65:58:C2:5B:D3:B6:0D:53:4A:0F:00:A2:D3:03:E3
# Depois de ativar Play App Signing, coloque aqui a SHA-256 da App signing key certificate:
Twa__Sha256CertFingerprints__1=

# Google Play / Política de Privacidade
PlayStore__SupportEmail=

# Integração opcional com HIS/agendas legadas. Gere uma chave longa e aleatória no ambiente.
LegacyIntegration__ApiKey=
# Render/Linux: evita esgotamento do limite de inotify/FileSystemWatcher.
DOTNET_USE_POLLING_FILE_WATCHER=1
DOTNET_HOSTBUILDER__RELOADCONFIGONCHANGE=false


Database__ApplyV24Patch=true

# Matriz de convênios e estado de elegibilidade por consulta
Database__ApplyV25Patch=true

# Jornada de consultas 24.0.0 — consulte docs/NOVA-DEMANDA-V24.md
Database__ApplyV31Patch=true
RENDER_EXTERNAL_URL=https://callmed.onrender.com
Clinica__Encaixe__PrazoMinutos=15
# Informe STUN/TURN do fornecedor escolhido. Sem TURN, redes distintas podem não conectar.
Clinica__Tele__IceUrls__0=
Clinica__Tele__IceUrls__1=
# Metered e outros provedores: username e credential exibidos no painel.
Clinica__Tele__TurnUsername=
Clinica__Tele__TurnPassword=
# Apenas para coturn com use-auth-secret. Deixe vazio ao usar o Metered.
Clinica__Tele__TurnSecret=

# PEP opcional, desabilitado até homologação. Chaves independentes de 32+ caracteres.
PepIntegration__Enabled=false
PepIntegration__ApiKey=
PepIntegration__ClientName=
PepIntegration__WebhookUrl=
PepIntegration__WebhookSecret=

# Psicologia V25: adaptação de domínio sem credenciais novas obrigatórias.
Database__ApplyV32Patch=true
# V26: patch aditivo para pedidos de privacidade e saúde das rotinas. Padrão true.
Database__ApplyV33Patch=true
PepIntegration__Fhir__Enabled=false
PepIntegration__Fhir__BaseUrl=
PepIntegration__Fhir__BearerToken=
PepIntegration__Fhir__IdentifierSystem=

# V27: medição de resultados, aditiva e reaplicável (ativa por padrão)
Database__ApplyV34Patch=true

# V28: cadastro multiprofissional, aplicado por padrão
Database__ApplyV35Patch=true
