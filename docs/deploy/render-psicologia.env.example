# Psicologia V25. A atualização do domínio não exige novas credenciais.
# A V32 já é aplicada por padrão na inicialização.
Database__ApplyV32Patch=true

# Somente se houver fornecedor PEP com FHIR R4 homologado.
# Não habilitar antes de configurar ambiente de homologação e autorização da clínica.
PepIntegration__Fhir__Enabled=false
PepIntegration__Fhir__BaseUrl=
PepIntegration__Fhir__BearerToken=
PepIntegration__Fhir__IdentifierSystem=
