# Preencha com os dados reais de Get credential > Show ICE Servers Array.
# Acrescente IceUrls__2, __3, __4 conforme as URLs fornecidas no painel.
Clinica__Tele__IceUrls__0=
Clinica__Tele__IceUrls__1=
Clinica__Tele__IceUrls__2=
Clinica__Tele__IceUrls__3=
Clinica__Tele__IceUrls__4=
Clinica__Tele__TurnUsername=
Clinica__Tele__TurnPassword=
# Este campo fica vazio ao usar as credenciais Metered acima.
Clinica__Tele__TurnSecret=
