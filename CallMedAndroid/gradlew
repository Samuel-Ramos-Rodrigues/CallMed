#!/bin/sh
set -e
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
if [ ! -f "$JAR" ]; then
  echo "Baixando Gradle Wrapper 8.13..."
  mkdir -p "$(dirname "$JAR")"
  if command -v curl >/dev/null 2>&1; then
    curl -L --fail --silent --show-error -o "$JAR" "https://raw.githubusercontent.com/gradle/gradle/v8.13.0/gradle/wrapper/gradle-wrapper.jar"
  elif command -v wget >/dev/null 2>&1; then
    wget -O "$JAR" "https://raw.githubusercontent.com/gradle/gradle/v8.13.0/gradle/wrapper/gradle-wrapper.jar"
  else
    echo "Instale curl ou wget, ou abra o projeto no Android Studio."
    exit 1
  fi
  if command -v sha256sum >/dev/null 2>&1; then
    echo "2db75c40782f5e8ba1fc278a5574bab070adccb2d21ca5a6e5ed840888448046  $JAR" | sha256sum -c - || { rm -f "$JAR"; exit 1; }
  fi
fi
exec java ${JAVA_OPTS:-} ${GRADLE_OPTS:-} -classpath "$JAR" org.gradle.wrapper.GradleWrapperMain "$@"
