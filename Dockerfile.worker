FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY src/CallMed.Domain/CallMed.Domain.csproj src/CallMed.Domain/
COPY src/CallMed.Persistence/CallMed.Persistence.csproj src/CallMed.Persistence/
COPY src/CallMed.Application/CallMed.Application.csproj src/CallMed.Application/
COPY src/CallMed.Worker/CallMed.Worker.csproj src/CallMed.Worker/
RUN dotnet restore src/CallMed.Worker/CallMed.Worker.csproj
COPY src/ src/
RUN dotnet publish src/CallMed.Worker/CallMed.Worker.csproj -c Release --no-restore -o /publish /p:UseAppHost=false
FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /publish .
ENTRYPOINT ["dotnet", "CallMed.Worker.dll"]
