@model MKSANCrud.ViewModels.MedicoFormViewModel
@{
    var horarios = (IReadOnlyList<string>)(ViewBag.HorariosPadrao ?? Array.Empty<string>());
}

<div asp-validation-summary="ModelOnly" class="validation"></div>

<div class="doctor-form-v16">
    <section class="cm25-panel v16-card doctor-form-section-v16">
        <div class="doctor-section-head-v16">
            <span>01</span>
            <div><h2>Dados profissionais</h2><p>Identificação, profissão, registro no conselho e especialidade.</p></div>
        </div>
        <div class="form-grid v16-form-grid">
            <div class="field full">
                <label asp-for="Nome">Nome completo</label>
                <input asp-for="Nome" autocomplete="off" placeholder="Ex.: Dra. Ana Souza" />
                <span asp-validation-for="Nome" class="validation"></span>
            </div>
            <div class="field">
                <label asp-for="Especialidade"></label>
                <input asp-for="Especialidade" placeholder="Ex.: Cardiologia, Psicologia clínica ou Nutrição" autocomplete="off" />
                <span asp-validation-for="Especialidade" class="validation"></span>
                <small class="field-help">Uma nova área de atuação é criada automaticamente ao salvar.</small>
            </div>
            <div class="field"><label asp-for="AreaProfissional" for="prof-area">Profissão</label><select asp-for="AreaProfissional" id="prof-area"><option value="">Selecione para revisar o cadastro legado</option>@foreach(var area in MKSANCrud.Services.Clinica.RegistroProfissional.Areas){<option value="@area">@area</option>}</select><span asp-validation-for="AreaProfissional" class="validation"></span></div>
            <div class="field"><label asp-for="RegistroConselho" for="prof-conselho">Conselho profissional</label><input asp-for="RegistroConselho" id="prof-conselho" placeholder="CRM, CRP ou conselho da profissão" maxlength="20"/><span asp-validation-for="RegistroConselho" class="validation"></span></div>
            <div class="field"><label asp-for="RegistroNumero">Número do registro</label><input asp-for="RegistroNumero" placeholder="CRP: regional/número. Demais: número no conselho." maxlength="30"/><span asp-validation-for="RegistroNumero" class="validation"></span></div>
            <div class="field"><label asp-for="RegistroUf" for="prof-uf">UF do registro (exceto CRP)</label><select asp-for="RegistroUf" id="prof-uf"><option value="">Para CRP, a regional está no número</option>@foreach(var uf in MKSANCrud.Services.Clinica.RegistroProfissional.Estados){<option value="@uf">@uf</option>}</select><span asp-validation-for="RegistroUf" class="validation"></span></div>
            <p class="field full">O administrador deve conferir o registro no conselho correspondente. Alterar profissão ou registro exige nova conferência. Registros antigos são preservados; CRM não é convertido em CRP.</p>
            <div class="field"><label asp-for="DuracaoPadraoMinutos"></label><input asp-for="DuracaoPadraoMinutos" type="number" min="5" max="240"/><span asp-validation-for="DuracaoPadraoMinutos"></span></div>
            <div class="field full">
                <label class="v16-switch-row">
                    <input asp-for="Ativo" />
                    <span class="v16-switch"></span>
                    <div><strong>Profissional ativo</strong><small>Profissionais inativos não recebem novas disponibilidades.</small></div>
                </label>
            </div>
        </div>
    </section>

    <section class="cm25-panel v16-card doctor-form-section-v16">
        <div class="doctor-section-head-v16">
            <span>02</span>
            <div><h2>Agenda semanal</h2><p>Ative os dias de atendimento e adicione horários pelo seletor.</p></div>
        </div>

        <div class="weekly-schedule-v16">
            @for (var i = 0; i < Model.Agenda.Count; i++)
            {
                var agendaDia = Model.Agenda[i];
                <article class="schedule-day-v16 @(agendaDia.Trabalha ? "enabled" : "")" data-schedule-day data-index="@i">
                    <input type="hidden" asp-for="Agenda[i].DiaSemana" />
                    <input type="hidden" asp-for="Agenda[i].Nome" />
                    <div class="schedule-day-v16-head">
                        <label class="schedule-day-toggle-v16">
                            <input asp-for="Agenda[i].Trabalha" data-schedule-toggle />
                            <span class="schedule-toggle-ui"></span>
                            <strong>@agendaDia.Nome</strong>
                        </label>
                        <small data-schedule-count>@agendaDia.Horarios.Count horário@(agendaDia.Horarios.Count == 1 ? "" : "s")</small>
                    </div>

                    <div class="schedule-day-v16-body">
                        <div class="schedule-add-time">
                            <select data-time-picker aria-label="Adicionar horário em @agendaDia.Nome">
                                <option value="">Selecione um horário</option>
                                @foreach (var horario in horarios)
                                {
                                    <option value="@horario">@horario</option>
                                }
                            </select>
                            <button type="button" class="btn secondary small" data-add-time>+ Adicionar</button>
                        </div>

                        <div class="schedule-chip-list" data-chip-list>
                            @foreach (var horario in agendaDia.Horarios.OrderBy(x => x))
                            {
                                <span class="schedule-time-chip" data-time="@horario">
                                    <input type="hidden" name="Agenda[@i].Horarios" value="@horario" />
                                    <b>@horario</b>
                                    <button type="button" data-remove-time aria-label="Remover @horario">×</button>
                                </span>
                            }
                        </div>
                        <span asp-validation-for="Agenda[i].Horarios" class="validation"></span>
                        <div class="schedule-empty-hint" data-empty-hint>Adicione ao menos um horário para este dia.</div>
                    </div>
                </article>
            }
        </div>
    </section>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const area=document.getElementById('prof-area'),conselho=document.getElementById('prof-conselho'),uf=document.getElementById('prof-uf');
    function registro(){if(area.value==='Psicologia')conselho.value='CRP';if(area.value==='Medicina')conselho.value='CRM';conselho.readOnly=area.value==='Psicologia'||area.value==='Medicina';uf.disabled=area.value==='Psicologia';if(uf.disabled)uf.value='';}
    area.addEventListener('change',registro);registro();
    document.querySelectorAll('[data-schedule-day]').forEach(day => {
        const toggle = day.querySelector('[data-schedule-toggle]');
        const picker = day.querySelector('[data-time-picker]');
        const add = day.querySelector('[data-add-time]');
        const list = day.querySelector('[data-chip-list]');
        const count = day.querySelector('[data-schedule-count]');
        const hint = day.querySelector('[data-empty-hint]');
        const index = day.dataset.index;

        const values = () => [...list.querySelectorAll('[data-time]')].map(x => x.dataset.time);

        const refresh = () => {
            const active = !!toggle.checked;
            const total = values().length;
            day.classList.toggle('enabled', active);
            picker.disabled = !active;
            add.disabled = !active;
            count.textContent = `${total} horário${total === 1 ? '' : 's'}`;
            hint.hidden = !active || total > 0;
            [...picker.options].forEach(opt => {
                if (!opt.value) return;
                opt.disabled = values().includes(opt.value);
            });
        };

        const addTime = value => {
            if (!value || values().includes(value)) return;
            const chip = document.createElement('span');
            chip.className = 'schedule-time-chip';
            chip.dataset.time = value;
            chip.innerHTML = `<input type="hidden" name="Agenda[${index}].Horarios" value="${value}"><b>${value}</b><button type="button" data-remove-time aria-label="Remover ${value}">×</button>`;
            list.appendChild(chip);
            picker.value = '';
            refresh();
        };

        add.addEventListener('click', () => addTime(picker.value));
        picker.addEventListener('change', () => {
            if (picker.value) addTime(picker.value);
        });
        list.addEventListener('click', event => {
            const button = event.target.closest('[data-remove-time]');
            if (!button) return;
            button.closest('[data-time]')?.remove();
            refresh();
        });
        toggle.addEventListener('change', refresh);
        refresh();
    });
});
</script>
