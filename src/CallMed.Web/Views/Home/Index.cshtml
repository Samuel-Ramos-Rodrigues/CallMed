@model MKSANCrud.ViewModels.HomeViewModel
@{
    Layout = Model.Autenticado ? "_Layout" : "_PublicLayout";
    ViewData["Title"] = Model.Autenticado ? "Meu início" : "Sua saúde, mais perto";
    var proxima = Model.ProximasConsultas.FirstOrDefault();
    var culturaPt = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
    string StatusPedido(MKSANCrud.Models.StatusSolicitacaoAtendimento status) => status switch
    {
        MKSANCrud.Models.StatusSolicitacaoAtendimento.Nova => "Aguardando agendamento",
        MKSANCrud.Models.StatusSolicitacaoAtendimento.EmTriagem => "Solicitação recebida",
        MKSANCrud.Models.StatusSolicitacaoAtendimento.BuscandoHorario => "Buscando horário",
        MKSANCrud.Models.StatusSolicitacaoAtendimento.AguardandoPaciente => "Aguardando sua resposta",
        MKSANCrud.Models.StatusSolicitacaoAtendimento.Confirmada => "Consulta marcada",
        MKSANCrud.Models.StatusSolicitacaoAtendimento.Cancelada => "Cancelada",
        _ => "Encerrada"
    };
}
@if (Model.Autenticado)
{
    <section class="cm37-dashboard cm37-patient patient-home" aria-labelledby="cm37-patient-title">
        <section class="cm21-simple-home" aria-label="Modo simplificado">
            <h1>Olá, @Model.NomePaciente!</h1><p>O que você deseja fazer?</p>
            <div class="cm21-simple-actions">
                <a asp-controller="Consulta" asp-action="Create">Marcar consulta</a>
                <a asp-controller="Consulta" asp-action="Index">Minhas consultas</a>
                <a asp-controller="Jornada" asp-action="Index">Preparar minha consulta</a>
                <button type="button" data-open-callmed-ai>Falar com atendimento</button>
                <a asp-controller="ListaEspera" asp-action="Index">Lista de espera</a>
            </div>
            <button type="button" class="btn secondary" data-a11y-toggle="simple">Sair do modo fácil</button>
        </section>
        <div class="patient-standard cm37-stack">
            <header class="cm37-head">
                <div><span class="cm37-eyebrow">MEU CUIDADO</span><h1 id="cm37-patient-title">Olá, @Model.NomePaciente!</h1><p>Veja sua próxima consulta e o que precisa fazer agora.</p></div>
                <button type="button" class="cm37-linkbtn" data-a11y-toggle="simple">Ativar modo fácil</button>
            </header>
            <div class="cm37-main-grid">
                <section class="cm37-card cm37-feature" aria-labelledby="cm37-next-appointment">
                    <span class="cm37-eyebrow">PRÓXIMA CONSULTA</span>
                    @if (proxima is not null)
                    {
                        <div class="cm37-between"><h2 id="cm37-next-appointment">@(proxima.Medico?.Nome ?? "Profissional")</h2><span class="status-pill status-@proxima.Status.ToLowerInvariant()">@proxima.Status</span></div>
                        <p>@(proxima.Medico?.Especialidade ?? "Consulta")</p>
                        <p class="cm37-date">@proxima.Data.ToString("dd/MM/yyyy") · @proxima.Horario</p>
                        <div class="cm37-actions">
                            <a class="cm37-button" asp-controller="Consulta" asp-action="Details" asp-route-id="@proxima.Id">Ver consulta e orientações</a>
                            <a class="cm37-button-secondary" asp-controller="Jornada" asp-action="Index">Preparar / check-in</a>
                        </div>
                    }
                    else
                    {
                        <h2 id="cm37-next-appointment">Nenhuma consulta futura</h2>
                        <p>Escolha um horário disponível para começar.</p>
                        <a class="cm37-button" asp-controller="Consulta" asp-action="Create">Marcar minha consulta</a>
                    }
                </section>
                <nav class="cm37-card cm37-quick" aria-label="Ações principais">
                    <h2>O que você quer fazer?</h2>
                    <a asp-controller="Consulta" asp-action="Create"><span>Marcar uma consulta</span><span aria-hidden="true">↗</span></a>
                    <a asp-controller="Consulta" asp-action="Index"><span>Minhas consultas</span><span aria-hidden="true">↗</span></a>
                    <a asp-controller="Jornada" asp-action="Index" asp-fragment="j-consultas"><span>Acessar teleconsulta</span><span aria-hidden="true">↗</span></a>
                    <button type="button" data-open-callmed-ai><span>Falar com atendimento</span><span aria-hidden="true">↗</span></button>
                </nav>
            </div>
            <section class="cm37-card cm37-tele" aria-labelledby="cm37-patient-tele">
                <div><span class="cm37-eyebrow">CONSULTAS ONLINE</span><h2 id="cm37-patient-tele">Teleconsulta sem complicação</h2><p>Confira a preparação e acesse a sala no horário autorizado.</p></div>
                <a class="cm37-button-secondary" asp-controller="Jornada" asp-action="Index" asp-fragment="j-consultas">Preparar e entrar na sala</a>
            </section>
            <div class="cm37-columns">
                <section class="cm37-card" aria-labelledby="cm37-patient-requests">
                    <div class="cm37-between"><h2 id="cm37-patient-requests">Meus pedidos</h2><a asp-controller="Solicitacoes" asp-action="Index">Ver todos</a></div>
                    @if (Model.SolicitacoesRecentes.Any())
                    {
                        @foreach(var pedido in Model.SolicitacoesRecentes.Take(3))
                        {
                            <div class="cm37-listrow"><div><strong>@(pedido.Especialidade?.Nome ?? "Solicitação de consulta")</strong><small>@ClinicaClock.ConverterUtc(pedido.CriadoEm).ToString("dd/MM · HH:mm")</small></div><span class="cm37-status">@StatusPedido(pedido.Status)</span></div>
                        }
                    }
                    else { <p class="cm37-muted">Nenhuma solicitação aberta neste momento.</p> }
                </section>
                <section class="cm37-card" aria-labelledby="cm37-patient-more">
                    <h2 id="cm37-patient-more">Seu acompanhamento</h2>
                    <div class="cm37-listrow"><div><strong>Pré-atendimento</strong><small>Preencha dados necessários antes de sair de casa</small></div><a asp-controller="Jornada" asp-action="Index">Abrir</a></div>
                    <div class="cm37-listrow"><div><strong>Lista de espera</strong><small>Acompanhe ofertas de vagas</small></div><a asp-controller="ListaEspera" asp-action="Index">Abrir</a></div>
                    <div class="cm37-listrow"><div><strong>Exames e documentos</strong><small>Histórico de exames</small></div><a asp-controller="HistoricoExames" asp-action="Index">Abrir</a></div>
                    <div class="cm37-listrow"><div><strong>Dados pessoais</strong><small>Convênio e preferências</small></div><a asp-controller="MinhaConta" asp-action="Index">Abrir</a></div>
                </section>
            </div>
            @if (Model.ProximasConsultas.Skip(1).Any())
            {
                <section class="cm37-card" aria-labelledby="cm37-patient-upcoming"><div class="cm37-between"><h2 id="cm37-patient-upcoming">Depois da próxima consulta</h2><a asp-controller="Consulta" asp-action="Index">Ver agenda</a></div>
                @foreach(var item in Model.ProximasConsultas.Skip(1).Take(3))
                {
                    <a class="cm37-listrow" asp-controller="Consulta" asp-action="Details" asp-route-id="@item.Id"><div><strong>@(item.Medico?.Nome ?? "Profissional")</strong><small>@item.Data.ToString("dd/MM") · @item.Horario</small></div><span aria-hidden="true">↗</span></a>
                }
                </section>
            }
        </div>
    </section>
}
else
{
    <section class="public-hero"><div class="public-hero-copy"><span class="eyebrow">MENOS DISTÂNCIA. MAIS CUIDADO.</span><h1>Sua saúde,<br /><em>mais perto.</em></h1><p>Marcar uma consulta pode ser simples. Encontre um horário, acompanhe sua agenda e conte com a clínica em cada etapa.</p><div class="public-actions"><a class="btn" href="/acesso?returnUrl=%2FConsulta%2FCreate">Quero marcar uma consulta <span aria-hidden="true"><svg class="cm-direction-icon" aria-hidden="true"><use href="/icons/callmed-ui.svg#arrow-up-right"></use></svg></span></a><a class="text-link" href="#como-funciona">Conhecer a CallMed ↓</a></div><div class="public-channel-note"><svg aria-hidden="true"><use href="/icons/callmed-ui.svg#chat"></use></svg><span>No site, pelo telefone ou na recepção.<br /><strong>O atendimento continua perto de você.</strong></span></div></div>
    <div class="care-illustration" aria-label="Da escolha do horário ao atendimento"><div class="care-orbit orbit-one"></div><div class="care-orbit orbit-two"></div><span class="care-plus" aria-hidden="true">+</span><div class="care-ticket"><div class="care-ticket-top"><div><span class="eyebrow">CADA ETAPA CONTA</span><p class="care-ticket-subtitle">Acompanhamento simples e acolhedor</p></div><div class="care-ticket-art"><img src="~/images/ilustracao-cuidado-clinico.svg" asp-append-version="true" alt="" aria-hidden="true" /></div></div><h2>Um tempo<br />para você.</h2><div class="care-step"><span>01</span><strong>Escolha a especialidade</strong><svg aria-hidden="true"><use href="/icons/callmed-ui.svg#check"></use></svg></div><div class="care-step"><span>02</span><strong>Encontre seu horário</strong><svg aria-hidden="true"><use href="/icons/callmed-ui.svg#check"></use></svg></div><div class="care-step"><span>03</span><strong>Acompanhe sua consulta</strong><svg aria-hidden="true"><use href="/icons/callmed-ui.svg#check"></use></svg></div><small>CallMed · cuidado em conexão</small></div><span class="care-caption">SIMPLES PARA AGENDAR.<br />PRÓXIMO PARA CUIDAR.</span></div></section>
    <section class="public-how" id="como-funciona"><header><span class="eyebrow">COMECE POR AQUI</span><h2>Mais clareza.<br />Em cada passo.</h2></header><div class="public-how-item"><div class="public-feature-icon" aria-hidden="true"><svg><use href="/icons/callmed-ui.svg#user-round-check"></use></svg></div><span>01 / ACESSO</span><h3>Seu espaço, sempre à mão.</h3><p>Crie sua conta de paciente e reúna seus dados e consultas em um só lugar.</p><a asp-area="Identity" asp-page="/Account/Register">Criar minha conta <svg class="cm-direction-icon" aria-hidden="true"><use href="/icons/callmed-ui.svg#arrow-up-right"></use></svg></a></div><div class="public-how-item"><div class="public-feature-icon" aria-hidden="true"><svg><use href="/icons/callmed-ui.svg#calendar-check"></use></svg></div><span>02 / AGENDA</span><h3>Um horário que funciona.</h3><p>Escolha entre as datas e os horários disponíveis para a especialidade desejada.</p><a href="/acesso?returnUrl=%2FConsulta%2FCreate">Encontrar um horário <svg class="cm-direction-icon" aria-hidden="true"><use href="/icons/callmed-ui.svg#arrow-up-right"></use></svg></a></div><div class="public-how-item"><div class="public-feature-icon" aria-hidden="true"><svg><use href="/icons/callmed-ui.svg#heart-pulse"></use></svg></div><span>03 / ACOMPANHAMENTO</span><h3>Saiba o que vem depois.</h3><p>Veja as orientações, confirme sua presença e acompanhe o atendimento.</p><a href="/acesso?returnUrl=%2FConsulta">Ver minhas consultas <svg class="cm-direction-icon" aria-hidden="true"><use href="/icons/callmed-ui.svg#arrow-up-right"></use></svg></a></div></section>
    <section class="public-install"><div><span class="eyebrow">CALLMED NO SEU DIA</span><h2>Um toque.<br />E você já está perto.</h2><p>Baixe o aplicativo para Android e tenha a CallMed sempre à mão.</p></div><div class="cm-public-install-actions"><a class="btn light" asp-controller="Aplicativo" asp-action="Index">Baixar para Android <svg aria-hidden="true"><use href="/icons/callmed-ui.svg#download"></use></svg></a><button type="button" class="cm-install-web" data-pwa-install>Adicionar à tela inicial</button></div></section>
}
