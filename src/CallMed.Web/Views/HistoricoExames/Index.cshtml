@model MKSANCrud.ViewModels.HistoricoExamesViewModel
@{ ViewData["Title"] = "Histórico de exames"; var equipe = User.IsInRole("Funcionario") || User.IsInRole("Admin"); }
<section class="cm25-screen cm25-exams-page">
    <section class="r3-module-bar r4-command-strip r5-module-brief" aria-label="Orientações e ações desta página"><div class="r4-command-title"><span class="r4-command-breadcrumb">ESPAÇO DE TRABALHO / AÇÃO</span><span class="r3-overline">EXAMES E DOCUMENTOS</span><p>Acompanhe somente os documentos liberados; pendências passam pela triagem.</p></div><nav aria-label="Ações relacionadas">@if(User.IsInRole("Paciente")) { <a asp-controller="MinhaConta" asp-action="Index">Minha conta <span aria-hidden="true">↗</span></a> } else { <a asp-controller="Paciente" asp-action="Index">Pacientes <span aria-hidden="true">↗</span></a> }</nav></section>

    <header class="cm25-page-hero"><div class="cm25-hero-mark" aria-hidden="true"><svg><use href="/icons/callmed-ui.svg#file-medical"></use></svg></div><div><span class="cm25-kicker">ACOMPANHAMENTO</span><h1>Histórico de exames</h1><p>@Model.Paciente.Nome · Registro dos exames realizados. Laudos e interpretações permanecem com o serviço responsável.</p></div></header>
    @if (equipe)
    {
        <div class="cm25-panel v16-card cm25-content-card">
            <p>Novos registros passam por triagem administrativa e só aparecem no histórico após aprovação.</p>
            <a class="btn secondary" asp-action="Pendentes">Revisar exames pendentes (@(ViewBag.ExamesPendentes ?? 0))</a>
        </div>
        <form asp-action="Create" method="post" class="cm25-panel v16-card cm25-content-card">
            <h2>Registrar exame para triagem</h2>
            <div asp-validation-summary="All" class="validation"></div>
            <input asp-for="Novo.PacienteId" type="hidden" />
            <div class="form-grid">
                <div class="field"><label asp-for="Novo.Nome">Nome do exame</label><input asp-for="Novo.Nome" /></div>
                <div class="field"><label asp-for="Novo.DataRealizacao">Data de realização</label><input asp-for="Novo.DataRealizacao" type="date" /></div>
                <div class="field"><label asp-for="Novo.LocalRealizacao">Local (opcional)</label><input asp-for="Novo.LocalRealizacao" /></div>
            </div>
            <button class="btn" type="submit">Enviar para triagem</button>
        </form>
    }
    @if (Model.Exames.Count == 0) { <div class="cm25-panel v16-empty"><strong>Nenhum exame aprovado registrado.</strong><p>Exames aguardando triagem não aparecem neste histórico.</p></div> }
    @foreach (var exame in Model.Exames)
    {
        <article class="cm25-panel v16-card cm25-content-card cm25-exam-record">
            <div>
            <h2>@exame.Nome</h2>
            <p>@exame.DataRealizacao.ToString("dd/MM/yyyy") · @(exame.LocalRealizacao ?? "Local não informado")</p>
            </div>
            @if (equipe)
            {
                <form asp-action="Desativar" method="post" data-cm-confirm="Retirar este registro da lista? A auditoria será preservada." data-cm-confirm-title="Retirar registro" data-cm-confirm-accept="Retirar registro" data-cm-confirm-tone="danger">
                    <input type="hidden" name="id" value="@exame.Id" />
                    <button class="btn secondary" type="submit">Desativar registro</button>
                </form>
            }
        </article>
    }
    @if (Model.Exames.Count == 200) { <p>Exibindo os 200 registros mais recentes.</p> }
</section>
