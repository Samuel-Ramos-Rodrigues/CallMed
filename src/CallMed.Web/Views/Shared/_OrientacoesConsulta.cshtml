@model Consulta
@inject MKSANCrud.Services.Clinica.OrientacoesConsultaService Orientacoes
<section class="cm25-panel v16-card cm25-content-card" aria-labelledby="orientacoes-title">
    <h2 id="orientacoes-title">Prepare-se para a consulta</h2>
    <ul>
        @if (ViewBag.Modalidade == "Online")
        {
            <li>Sua consulta será online, por vídeo. Acesse a preparação pelo CallMed e leia o consentimento.</li>
            <li>A sala abre 30 minutos antes da consulta. Confira câmera, microfone e conexão.</li>
            <li>Tenha seu documento disponível e escolha um ambiente reservado.</li>
        }
        else
        {
        @foreach (var item in Orientacoes.Obter(Model))
        {
            <li>@item</li>
        }
        }
    </ul>
</section>
