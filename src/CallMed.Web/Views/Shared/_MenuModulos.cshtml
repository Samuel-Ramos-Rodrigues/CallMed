@using MKSANCrud.Services.Usuarios
<p>Use a rotina diária ou abra uma das áreas abaixo.</p><a class="btn secondary" asp-controller="Organizacao" asp-action="Index">Buscar uma função</a>
@foreach(var grupo in NavegacaoCallMed.Itens(User).OrderBy(x=>NavegacaoCallMed.OrdemGrupo(x.Grupo)).GroupBy(x=>x.Grupo)){<details class="cm-modulo-grupo" open="@(grupo.Key is "Hoje" or "Meu cuidado" or "Meu atendimento")"><summary>@grupo.Key</summary><nav class="module-grid" aria-label="@grupo.Key">@foreach(var i in grupo){<a asp-controller="@i.Controller" asp-action="@i.Action"><span class="nav-icon" aria-hidden="true"><svg><use href="/icons/callmed-ui.svg#@(i.Controller=="Salas"?"hospital":i.Controller=="Atendimento"?"chat":i.Controller=="MinhaConta"?"user":i.Controller=="Configuracoes"?"settings":i.Controller=="Relatorios"||i.Controller=="Operacao"?"chart":i.Controller=="Medico"?"doctor":i.Controller=="Paciente"?"team":"clipboard-check")"></use></svg></span><b>@i.Titulo</b></a>}</nav></details>}
@if(User.IsInRole("Paciente")){<button type="button" class="btn secondary" data-open-callmed-ai>Falar com a assistente</button>}
