@model MKSANCrud.ViewModels.FuncionarioPainelViewModel
@using System.Globalization
@{
    var admin=User.IsInRole("Admin");
    ViewData["Title"]=admin?"Visão geral da clínica":"Recepção de hoje";
    var nome=Model.NomeUsuario.Split(' ',StringSplitOptions.RemoveEmptyEntries).FirstOrDefault()??"equipe";
    var pt=CultureInfo.GetCultureInfo("pt-BR");
    var proximas=Model.ProximasConsultas.OrderBy(x=>x.Data).ThenBy(x=>x.Horario).Take(6).ToList();
}
<section class="cm37-dashboard cm37-operations" aria-labelledby="cm37-ops-title">
    <header class="cm37-head">
        <div><span class="cm37-eyebrow">@(admin?"GESTÃO DA CLÍNICA":"RECEPÇÃO · HOJE")</span><h1 id="cm37-ops-title">@(admin?"Visão geral da operação":"Olá, "+nome+"!")</h1>
            <p>@(admin?"Acompanhe indicadores e acesse a operação sem misturar configurações com tarefas do dia.":"Resolva as pendências do dia. Os check-ins automáticos não precisam da sua confirmação.")</p></div>
        <div class="cm37-date">@Model.Hoje.ToString("dddd, dd 'de' MMMM",pt)</div>
    </header>
    @if(admin)
    {
        <section class="cm37-card cm37-feature cm37-admin-lead" aria-labelledby="cm37-admin-focus">
            <div><span class="cm37-eyebrow">ACOMPANHAMENTO OPERACIONAL</span><h2 id="cm37-admin-focus">Sua clínica em um só lugar</h2><p>Consultas, atendimento e encaixes com dados da operação. As configurações ficam na área de gestão.</p></div>
            <div class="cm37-actions"><a class="cm37-button" asp-controller="Operacao" asp-action="Index">Ver indicadores e automações</a><a class="cm37-button-secondary" asp-controller="RecepcaoPendencias" asp-action="Index">Acompanhar recepção</a></div>
        </section>
    }
    else
    {
        <section class="cm37-card cm37-feature" aria-labelledby="cm37-reception-focus">
            <div><span class="cm37-eyebrow">PRÓXIMA AÇÃO</span><h2 id="cm37-reception-focus">O que precisa da recepção?</h2><p>Pré-cadastros incompletos, chegadas assistidas e solicitações que precisam de uma pessoa.</p></div>
            <div class="cm37-actions"><a class="cm37-button" asp-controller="RecepcaoPendencias" asp-action="Index">Resolver pendências</a><a class="cm37-button-secondary" asp-controller="Checkin" asp-action="Terminal">Exibir QR de check-in</a></div>
        </section>
    }
    <div class="cm37-metrics" aria-label="Resumo da clínica">
        <a class="cm37-card cm37-metric" asp-controller="Agenda" asp-action="Index"><small>Consultas hoje</small><strong>@Model.ConsultasHoje</strong><span>@Model.ConfirmadasHoje confirmadas</span></a>
        <a class="cm37-card cm37-metric" asp-controller="Atendimento" asp-action="Index"><small>Conversas abertas</small><strong>@Model.ConversasAbertas</strong><span>@Model.ConversasHumano com a equipe</span></a>
        <a class="cm37-card cm37-metric" asp-controller="Solicitacoes" asp-action="Index"><small>Solicitações pendentes</small><strong>@Model.SolicitacoesPendentes</strong><span>@Model.SolicitacoesAtrasadas atrasadas</span></a>
        <a class="cm37-card cm37-metric" asp-controller="ListaEspera" asp-action="Index"><small>Na fila de espera</small><strong>@Model.ListaEsperaAtiva</strong><span>@Model.VagasRecuperadasListaEspera vagas recuperadas</span></a>
    </div>
    <div class="cm37-columns cm37-ops-grid">
        <section class="cm37-card" aria-labelledby="cm37-ops-day">
            <div class="cm37-between"><div><span class="cm37-eyebrow">AGENDA</span><h2 id="cm37-ops-day">Próximas consultas</h2></div><a asp-controller="Agenda" asp-action="Index">Abrir agenda</a></div>
            @if(proximas.Count==0){<p class="cm37-muted">Nenhuma consulta futura encontrada.</p>}
            else
            {
                <div class="cm37-table-scroll" tabindex="0" aria-label="Lista de próximas consultas">
                    <table class="cm37-table"><thead><tr><th>Quando</th><th>Paciente</th><th>Profissional</th><th>Status</th><th>Detalhes</th></tr></thead><tbody>
                    @foreach(var consulta in proximas)
                    {
                        var paciente=consulta.Paciente?.Nome??"Paciente";
                        <tr><td><strong>@consulta.Horario</strong><small>@consulta.Data.ToString("dd/MM")</small></td><td>@paciente</td><td>@(consulta.Medico?.Nome??"A definir")</td><td><span class="status-pill status-@consulta.Status.ToString().ToLowerInvariant()">@consulta.Status</span></td><td><a asp-controller="Consulta" asp-action="Details" asp-route-id="@consulta.Id" aria-label="Ver consulta de @paciente">Abrir</a></td></tr>
                    }
                    </tbody></table>
                </div>
            }
        </section>
        <aside class="cm37-card cm37-quick" aria-labelledby="cm37-ops-pending">
            <h2 id="cm37-ops-pending">@(admin?"Pontos de atenção":"Pendências da equipe")</h2>
            <a asp-controller="Solicitacoes" asp-action="Index"><span><strong>Pedidos aguardando equipe</strong><small>@Model.SolicitacoesPendentes solicitações</small></span><span class="cm37-count">@Model.SolicitacoesPendentes</span></a>
            <a asp-controller="Confirmacoes" asp-action="Index"><span><strong>Confirmações pendentes</strong><small>@Model.AguardandoHoje consultas de hoje</small></span><span class="cm37-count">@Model.AguardandoHoje</span></a>
            <a asp-controller="RecepcaoPendencias" asp-action="Index"><span><strong>Exceções do check-in</strong><small>Mostrar somente casos que precisam de ajuda</small></span><span aria-hidden="true">↗</span></a>
            <a asp-controller="ListaEspera" asp-action="Index"><span><strong>Fila inteligente</strong><small>Ofertas e prazos de encaixe</small></span><span aria-hidden="true">↗</span></a>
        </aside>
    </div>
    <section class="cm37-card cm37-tele" aria-labelledby="cm37-ops-online">
        <div><span class="cm37-eyebrow">TELECONSULTAS</span><h2 id="cm37-ops-online">Atendimentos online</h2><p>Acompanhe a presença e as salas virtuais sem abrir outro sistema.</p></div>
        <a class="cm37-button-secondary" asp-controller="Salas" asp-action="Index" asp-route-aba="online">Abrir teleconsultas</a>
    </section>
    @if(admin)
    {
        <section class="cm37-card" aria-labelledby="cm37-admin-areas">
            <div class="cm37-between"><h2 id="cm37-admin-areas">Gestão da clínica</h2><a asp-controller="Organizacao" asp-action="Index">Todas as funções</a></div>
            <nav class="cm37-action-grid" aria-label="Áreas administrativas">
                <a asp-controller="Piloto" asp-action="Index"><strong>Indicadores SENAI</strong><small>Ocupação, faltas e resultados</small></a>
                <a asp-controller="Integracoes" asp-action="Index"><strong>Integrações e canais</strong><small>WhatsApp, Gmail e httpSMS</small></a>
                <a asp-controller="Configuracoes" asp-action="Index"><strong>Configurações</strong><small>Preferências operacionais</small></a>
                <a asp-controller="Acessos" asp-action="Index"><strong>Equipe e acessos</strong><small>Permissões do sistema</small></a>
            </nav>
        </section>
    }
    else
    {
        <nav class="cm37-action-grid" aria-label="Ações frequentes de recepção">
            <a asp-controller="Consulta" asp-action="Create"><strong>Agendar consulta</strong><small>Encontrar horários disponíveis</small></a>
            <a asp-controller="Atendimento" asp-action="Index"><strong>Central de Atendimento</strong><small>Mensagens, IA e equipe</small></a>
            <a asp-controller="Confirmacoes" asp-action="Index"><strong>Confirmações</strong><small>Acompanhar respostas</small></a>
            <a asp-controller="Checkin" asp-action="Terminal"><strong>QR de chegada</strong><small>Autoatendimento presencial</small></a>
        </nav>
    }
</section>
