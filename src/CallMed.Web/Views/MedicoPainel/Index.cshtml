@model MKSANCrud.ViewModels.MedicoPainelViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Agenda clínica";
    var culturaPt = CultureInfo.GetCultureInfo("pt-BR");
    var agendaOrdenada = Model.AgendaHoje.OrderBy(x => x.Horario).ToList();
    var proximaHoje = agendaOrdenada.FirstOrDefault(c => c.Status is ConsultaStatus.Pendente or ConsultaStatus.Confirmada or ConsultaStatus.Remarcada);
    var concluidasHoje = agendaOrdenada.Count(c => c.Status == ConsultaStatus.Realizada);
}
<section class="cm9 cm9-doctor" aria-labelledby="cm9-doctor-title">
  <header class="cm9-page-heading cm9-doctor-heading"><div><span class="cm9-overline">ESTAÇÃO DO MÉDICO</span><h1 id="cm9-doctor-title">Agenda clínica<span class="cm9-title-dot">.</span></h1><p>Seu dia de consultas, organizado para atender melhor.</p></div><nav class="cm9-heading-actions" aria-label="Ações clínicas"><a class="cm9-secondary-btn" asp-controller="Jornada" asp-action="Index">Todas as consultas</a><a class="cm9-primary-btn" asp-controller="Salas" asp-action="Index" asp-route-aba="online">Teleconsultas ↗</a></nav></header>
  <div class="cm9-doctor-toolbar"><div class="cm9-doctor-date"><span class="cm9-date-mark">▦</span><strong>@ClinicaClock.Hoje.ToString("dddd, dd 'de' MMMM", culturaPt)</strong></div><div class="cm9-doctor-switch" aria-label="Período exibido"><span class="is-selected" aria-current="date">Hoje</span></div><span class="cm9-toolbar-total">@Model.ConsultasHoje @(Model.ConsultasHoje == 1 ? "consulta prevista" : "consultas previstas")</span></div>
  <div class="cm9-doctor-workspace">
    <section class="cm9-doctor-list" id="cm9-agenda" aria-labelledby="cm9-doctor-agenda-title"><div class="cm9-card-heading"><div><h2 id="cm9-doctor-agenda-title">Atendimentos de hoje</h2><p>@concluidasHoje concluídos · @agendaOrdenada.Count no total</p></div><span class="cm9-soft-badge">@agendaOrdenada.Count @(agendaOrdenada.Count == 1 ? "registro" : "registros")</span></div>
      @if (!agendaOrdenada.Any()) { <div class="cm9-empty">Nenhuma consulta prevista para hoje. Confira as disponibilidades abaixo.</div> }
      else { <ol class="cm9-appointment-list">@foreach (var c in agendaOrdenada) { <li class="@(proximaHoje?.Id == c.Id ? "cm9-appointment-active" : "")"><time>@c.Horario</time><span class="cm9-appt-line" aria-hidden="true"></span><a asp-controller="Jornada" asp-action="Consulta" asp-route-id="@c.Id"><span><strong>@(c.Paciente?.Nome ?? "Paciente")</strong><small>@(c.Status == ConsultaStatus.Realizada ? "Consulta concluída" : proximaHoje?.Id == c.Id ? "Próximo atendimento" : c.Status.ToString())</small></span><em class="@(c.Status == ConsultaStatus.Realizada ? "cm9-pill-ok" : proximaHoje?.Id == c.Id ? "cm9-pill-next" : "cm9-pill-idle")">@(c.Status == ConsultaStatus.Realizada ? "Concluída" : proximaHoje?.Id == c.Id ? "Próxima" : c.Status.ToString())</em><b aria-hidden="true">›</b></a></li> }</ol> }
    </section>
    <aside class="cm9-clinical-focus" aria-labelledby="cm9-clinical-focus-title"><div class="cm9-clinical-head"><span class="cm9-overline">PACIENTE EM FOCO</span><span class="cm9-soft-badge">PRÓXIMO</span></div>
      @if (proximaHoje is not null) { <div class="cm9-clinical-person"><span class="cm9-avatar" aria-hidden="true">@(proximaHoje.Paciente?.Nome?.Substring(0,1).ToUpperInvariant() ?? "P")</span><div><h2 id="cm9-clinical-focus-title">@(proximaHoje.Paciente?.Nome ?? "Paciente")</h2><p>Próximo atendimento disponível</p></div></div><div class="cm9-clinical-facts"><div><span>HORÁRIO</span><strong>@proximaHoje.Horario</strong></div><div><span>DATA</span><strong>@proximaHoje.Data.ToString("dd/MM/yyyy")</strong></div><div><span>ESTADO</span><strong>@proximaHoje.Status.ToString()</strong></div></div><a class="cm9-primary-btn cm9-block-btn" asp-controller="Jornada" asp-action="Consulta" asp-route-id="@proximaHoje.Id">Iniciar atendimento ↗</a><a class="cm9-secondary-btn cm9-block-btn" asp-controller="Salas" asp-action="Index" asp-route-aba="online">Ver teleconsultas</a><div class="cm9-clinical-bottom"><strong>Resumo clínico</strong><p>Dados de histórico, exames e documentos são consultados dentro do atendimento autorizado.</p><a asp-controller="HistoricoExames" asp-action="Index" asp-route-pacienteId="@proximaHoje.PacienteId">Ver exames disponíveis ↗</a></div> }
      else { <h2 id="cm9-clinical-focus-title">Agenda organizada</h2><p>Não há atendimento pendente nesta lista. Sua próxima consulta aparecerá automaticamente aqui.</p><a class="cm9-primary-btn cm9-block-btn" asp-controller="Jornada" asp-action="Index">Consultar agenda ↗</a> }
    </aside>
  </div>
  <section class="cm9-doctor-bottom"><div class="cm9-section-top"><div><span class="cm9-overline">GESTÃO PROFISSIONAL</span><h2>Disponibilidade e bloqueios</h2></div></div>
    <details class="cm50-availability"><summary>Gerenciar vagas disponíveis (@Model.ProximasVagasLivres.Count) e bloqueios (@Model.BloqueiosManuais.Count)</summary><div class="cm50-availability-grid"><section><h3>Vagas disponíveis</h3>@if (!Model.ProximasVagasLivres.Any()) { <p>Nenhuma vaga livre nos próximos 14 dias.</p> } else { @foreach (var vaga in Model.ProximasVagasLivres) { <form asp-action="BloquearHorario" method="post">@Html.AntiForgeryToken()<input type="hidden" name="disponibilidadeId" value="@vaga.Id"/><span>@vaga.Data!.Value.ToString("dd/MM") · @vaga.Horario</span><button type="submit" class="cm50-minilink">Bloquear</button></form> } }</section><section><h3>Bloqueios manuais</h3>@if (!Model.BloqueiosManuais.Any()) { <p>Nenhum bloqueio manual ativo.</p> } else { @foreach (var vaga in Model.BloqueiosManuais) { <form asp-action="DesbloquearHorario" method="post">@Html.AntiForgeryToken()<input type="hidden" name="disponibilidadeId" value="@vaga.Id"/><span>@vaga.Data!.Value.ToString("dd/MM") · @vaga.Horario</span><button type="submit" class="cm50-minilink">Desbloquear</button></form> } }</section></div></details>
    @if (Model.Medico.HabilitadoPsicologia && Model.Medico.ResponsavelTecnico) { <a class="cm9-subtle-link" asp-controller="Psicologia" asp-action="Acervo">Acervo de Psicologia sob guarda técnica ↗</a> }
  </section>
</section>
