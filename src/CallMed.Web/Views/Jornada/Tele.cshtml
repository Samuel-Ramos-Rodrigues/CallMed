@model TeleconsultaAcesso
@{ViewData["Title"]="Consulta online";var estado=Model.Estado;}

<section class="jornada tele-jornada" id="tele-preparacao" data-id="@Model.Consulta.Id" data-estado="@estado">
    <a class="tele-back" asp-controller="Jornada" asp-action="Consulta" asp-route-id="@Model.Consulta.Id">← Voltar aos detalhes da consulta</a>
    <header class="cm-journey-heading tele-heading"><span class="tele-tag">@(Model.Online?"Atendimento por vídeo":"Detalhes do atendimento")</span><h1>Consulta online</h1>
        <p><strong>@Model.Consulta.Medico?.Nome</strong> · @Model.Consulta.Data.ToString("dd/MM/yyyy") às @Model.Consulta.Horario</p>
        @if(Model.Medico){<p>Paciente: @Model.Consulta.Paciente?.Nome</p>}
        @if(Model.Online&&Model.Inicio!=null){<p class="tele-horario">A sala abre em <strong>@Model.Abertura?.ToString("dd/MM/yyyy 'às' HH:mm")</strong> e fica disponível até @Model.Encerramento?.ToString("dd/MM/yyyy 'às' HH:mm"). Horário de Brasília.</p>}
    </header>
    @if(Model.PodeEntrar){
        <section class="tele-room" id="tele" data-id="@Model.Consulta.Id" data-paciente="@Model.Paciente.ToString().ToLowerInvariant()" data-call-state="idle" aria-label="Sala de consulta por vídeo">
            @Html.AntiForgeryToken()
            <div class="tele-session-layout">
                <div class="tele-stage">
                    <div class="tele-stage-heading">
                        <span><svg aria-hidden="true"><use href="/icons/callmed-ui.svg#shield-check"></use></svg> Sala de atendimento</span>
                        <span class="tele-connection" id="tele-connection">Antes de entrar</span>
                    </div>
                    <div class="tele-lobby" id="tele-lobby">
                        <span class="tele-lobby-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="12" height="14" rx="3"/><path d="m15 10 6-3v10l-6-3"/></svg></span>
                        <h2>Um espaço para cuidar de você</h2>
                        <p>Quando você entrar, a chamada aparecerá aqui.</p>
                        <span class="tele-privacy"><svg aria-hidden="true"><use href="/icons/callmed-ui.svg#shield"></use></svg> O CallMed não grava esta chamada</span>
                    </div>
                    <div class="tele-grid" id="tele-videos" hidden>
                        <figure class="tele-remote">
                            <div class="tele-remote-placeholder" id="tele-remote-placeholder">
                                <span class="tele-avatar" aria-hidden="true"><svg><use href="/icons/callmed-ui.svg#@(Model.Paciente ? "doctor" : "user")"></use></svg></span>
                                <strong>@(Model.Paciente ? Model.Consulta.Medico?.Nome : Model.Consulta.Paciente?.Nome)</strong>
                                <p id="tele-remote-note">@(Model.Paciente ? "Aguardando o profissional entrar…" : "Aguardando o paciente entrar…")</p>
                            </div>
                            <video id="remote" autoplay playsinline aria-label="Vídeo da outra pessoa"></video>
                            <figcaption><span class="tele-participant-dot" aria-hidden="true"></span>@(Model.Paciente?"Profissional":"Paciente")</figcaption>
                        </figure>
                        <figure class="tele-local">
                            <video id="local" autoplay playsinline muted aria-label="Seu vídeo"></video>
                            <div class="tele-camera-off" id="tele-camera-off" hidden><svg aria-hidden="true"><use href="/icons/callmed-ui.svg#user"></use></svg><span>Câmera desligada</span></div>
                            <figcaption>Você <span id="tele-local-mic" hidden>· Microfone desligado</span></figcaption>
                        </figure>
                    </div>
                    <div class="tele-callbar">
                        <p id="tele-status" role="status" aria-live="polite">Pronto para entrar.</p>
                        <div class="tele-call-actions">
                            <div id="tele-controles" class="tele-media-controls" hidden>
                                <button class="btn secondary tele-control" id="microfone" type="button" aria-pressed="false" disabled><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="9" y="3" width="6" height="12" rx="3"/><path d="M5 10v2a7 7 0 0 0 14 0v-2M12 19v3M8 22h8"/></svg><span>Desligar microfone</span></button>
                                <button class="btn secondary tele-control" id="camera" type="button" aria-pressed="false" disabled><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="12" height="14" rx="3"/><path d="m15 10 6-3v10l-6-3"/></svg><span>Desligar câmera</span></button>
                            </div>
                            <button class="btn tele-leave" id="sair" type="button" hidden disabled><svg aria-hidden="true"><use href="/icons/callmed-ui.svg#phone"></use></svg><span>Sair da chamada</span></button>
                        </div>
                    </div>
                </div>
                <div class="tele-sidebar">
                    <section class="tele-prepare" aria-labelledby="tele-prepare-title">
                        <span class="tele-section-label">Sua consulta</span>
                        <h2 id="tele-prepare-title">Tudo pronto para entrar?</h2>
                        <p>Escolha um local reservado e permita o uso da câmera e do microfone.</p>
                        @if(Model.Paciente){<p>Se o profissional ainda não entrou, aguarde na sala. Você não precisa ir até a recepção.</p>}
                        else{<p>Confira a identidade do paciente na chamada antes de registrar o início do atendimento.</p>}
                        <button class="btn tele-enter" id="entrar" type="button"><svg aria-hidden="true"><use href="/icons/callmed-ui.svg#video"></use></svg>Entrar na chamada</button>
                    </section>
                    <section class="cm-device-check" aria-labelledby="tele-device-title">
                        <h3 id="tele-device-title"><svg aria-hidden="true"><use href="/icons/callmed-ui.svg#settings"></use></svg> Câmera e microfone</h3>
                        <p>Confira seus dispositivos. O teste fica só neste aparelho.</p>
                        <div class="tele-device-actions"><button class="btn secondary" id="testar-dispositivos" type="button">Testar câmera e microfone</button><button class="btn secondary" id="fechar-teste" type="button" hidden>Encerrar teste</button></div>
                        <p id="teste-status" role="status"></p>
                        <div id="teste-preview" hidden><video id="teste-camera" autoplay playsinline muted aria-label="Prévia da sua câmera"></video><label for="teste-microfone">Nível do microfone: fale para testar</label><meter id="teste-microfone" min="0" max="1" value="0">0</meter></div>
                    </section>
                    <details class="tele-help"><summary>Preciso de ajuda para conectar</summary><p>Permita câmera e microfone no navegador e feche outros aplicativos que estejam usando esses dispositivos. Se a conexão falhar, tente novamente ou entre em contato com a clínica.</p></details>
                </div>
            </div>
            @if(Model.Medico){<section class="cm-tele-lifecycle" data-iniciada="@((Model.Jornada?.InicioEm!=null).ToString().ToLowerInvariant())"><div><span class="tele-section-label">Área do profissional</span><h3>Andamento da consulta</h3><p id="tele-atendimento-status" role="status">Registrar o início mantém a chamada aberta. Concluir encerra o atendimento e o acesso à sala.</p></div><form id="tele-iniciar" asp-controller="Teleconsulta" asp-action="Atendimento" asp-route-id="@Model.Consulta.Id" method="post" hidden="@(Model.Jornada?.InicioEm!=null)"><input type="hidden" name="acao" value="iniciar"/><label class="j-check"><input name="confirmar" value="true" type="checkbox" required/><span>Conferi a identidade do paciente na chamada e posso iniciar o atendimento.</span></label><button class="btn secondary" type="submit">Registrar início do atendimento</button></form><form id="tele-concluir" asp-controller="Teleconsulta" asp-action="Atendimento" asp-route-id="@Model.Consulta.Id" method="post" hidden="@(Model.Jornada?.InicioEm==null)"><input type="hidden" name="acao" value="concluir"/><button class="btn secondary" type="submit">Concluir atendimento</button></form></section>}
        </section>
    }else{
        <section class="j-card tele-aviso" aria-labelledby="tele-motivo">
            @switch(estado){
                case "equipe":<h2 id="tele-motivo">A chamada é exclusiva dos participantes</h2><p>A recepção e a administração acompanham a organização nos detalhes da consulta. O vídeo fica disponível apenas para o paciente e o profissional responsável, com suas próprias contas.</p>break;
                case "encerrada":<h2 id="tele-motivo">Esta consulta está encerrada</h2><p>A situação atual é <strong>@Model.Consulta.Status</strong>. A sala de vídeo não está disponível. Fale com a clínica se precisar agendar outro atendimento.</p>break;
                case "presencial":<h2 id="tele-motivo">Esta consulta está marcada como presencial</h2><p>Por isso ela não possui uma sala de vídeo. Confira as orientações nos detalhes. Para solicitar a modalidade online, entre em contato com a clínica.</p>break;
                case "revisao-profissional":<h2 id="tele-motivo">A clínica precisa revisar a preparação</h2><p>@Model.Bloqueio</p><p>Os detalhes do agendamento continuam disponíveis em sua conta.</p>break;
                case "horario-invalido":<h2 id="tele-motivo">Precisamos conferir o horário</h2><p>O horário cadastrado não permite abrir a sala. Entre em contato com a clínica para corrigir o agendamento.</p>break;
                case "prazo-encerrado":<h2 id="tele-motivo">O período de acesso à sala terminou</h2><p>O acesso encerrou em @Model.Encerramento?.ToString("dd/MM/yyyy 'às' HH:mm"). Fale com a clínica para confirmar o atendimento ou solicitar um novo horário.</p>break;
                case "consentimento":
                    <h2 id="tele-motivo">@(Model.Paciente?"Autorize seu atendimento por vídeo":"Aguardando autorização do paciente")</h2>
                    @if(Model.PodeConsentir){
                        <p><strong>@Model.Consulta.Medico?.Nome · @Model.Consulta.Medico?.RegistroExibicao</strong></p><p>@MKSANCrud.Services.Clinica.ConsentimentoAtendimento.Texto(Model.Consulta)</p><p>Versão @MKSANCrud.Services.Clinica.ConsentimentoAtendimento.Versao(Model.Consulta)</p>
                        <form asp-controller="Teleconsulta" asp-action="Consentimento" asp-route-id="@Model.Consulta.Id" method="post" class="j-form">
                            <label class="j-check"><input type="checkbox" name="confirmar" value="true" required/><span>Li as informações e autorizo a transmissão de imagem e voz para esta consulta.</span></label>
                            <button type="submit" class="btn">Autorizar e continuar</button>
                        </form>
                    }else{<p>O paciente precisa abrir esta consulta com a própria conta e selecionar “Autorizar e continuar”. A sala será liberada quando essa autorização e o horário estiverem confirmados.</p>}
                    break;
                case "aguardando-horario":<h2 id="tele-motivo">Está tudo pronto. Aguarde a abertura da sala.</h2><p>Sua autorização já foi registrada. Você poderá entrar em <strong>@Model.Abertura?.ToString("dd/MM/yyyy 'às' HH:mm")</strong>, 30 minutos antes da consulta. Esta página verifica a liberação automaticamente.</p>break;
            }
            <div class="j-actions"><a class="btn secondary" href="/Jornada/Tele/@Model.Consulta.Id">Atualizar disponibilidade</a><a asp-controller="Jornada" asp-action="Consulta" asp-route-id="@Model.Consulta.Id">Ver detalhes da consulta</a></div>
        </section>
    }
</section>
<script src="~/js/jornada/teleconsulta.js" asp-append-version="true" defer></script>
