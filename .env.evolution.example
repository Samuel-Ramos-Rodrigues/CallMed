# Copie para .env.evolution; nunca publique o arquivo preenchido.
# Exemplo de tag fixa. Homologue a versao escolhida com seu numero antes de producao.
EVOLUTION_IMAGE=evoapicloud/evolution-api:v2.3.7
CALLMED_ENVIRONMENT=Development
CALLMED_DATABASE_CONNECTION='Host=SEU_HOST_NEON;Port=5432;Database=neondb;Username=SEU_USUARIO;Password=SUA_SENHA;SSL Mode=Require'
# true apenas para aplicar migrations; em banco existente mantenha sua politica atual.
CALLMED_AUTO_MIGRATE=false
# Gere valores aleatorios diferentes (32 bytes em hexadecimal e uma opcao).
EVOLUTION_API_KEY=
CALLMED_WEBHOOK_SECRET=
EVOLUTION_DB_PASSWORD=
EVOLUTION_INSTANCE=callmed
EVOLUTION_PUBLIC_URL=http://localhost:8080
WHATSAPP_NUMBER=
GEMINI_API_KEY=
CLINICA_ENDERECO=
CLINICA_TELEFONE=
# Opcional para um banco novo. Desative depois de criar o administrador.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
