@page
@model MKSANCrud.Areas.Identity.Pages.Account.LogoutModel
@{
    Layout = "_AuthLayout";
}
<main class="identity-shell identity-logout">
        <section class="identity-panel">
            <div class="identity-card">
                <div class="cm-logout-brand cm-brand-plate"><img src="~/images/logo-callmed-horizontal.png" alt="CallMed" width="260" height="82" /></div>
                <div class="identity-state-icon" aria-hidden="true"><svg class="cm-direction-icon" aria-hidden="true"><use href="/icons/callmed-ui.svg#arrow-up-right"></use></svg></div>
                <div class="identity-card-header cm25-identity-card-header"><h2>Encerrando sua sessão</h2><p>Estamos finalizando seu acesso com segurança.</p></div>
            </div>
        </section>
    </main>
