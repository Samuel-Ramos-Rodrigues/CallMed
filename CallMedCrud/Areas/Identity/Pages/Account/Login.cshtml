@page
@model MKSANCrud.Areas.Identity.Pages.Account.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Entrar";
}
<!DOCTYPE html>
<html lang="pt-br">
    <head>
        <meta charset="utf-8"  />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, interactive-widget=resizes-content" />
        <meta name="theme-color" content="#f6f7fc"  />
        <script>
            (function () {
                var pref = 'system';
                try {
                    var saved = localStorage.getItem('callmed-theme');
                    if (saved === 'light' || saved === 'dark' || saved === 'system') pref = saved;
                } catch { }
                var dark = pref === 'dark' || (pref === 'system' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
                document.documentElement.dataset.themePreference = pref;
                document.documentElement.dataset.theme = dark ? 'dark' : 'light';
                document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
                var themeMeta = document.querySelector('meta[name="theme-color"]');
                if (themeMeta) themeMeta.setAttribute('content', dark ? '#0a0b16' : '#f6f7fc');
            })();
        </script>
        <meta name="mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
        <meta name="apple-mobile-web-app-title" content="CallMed" />
        <meta name="application-name" content="CallMed" />
        <link rel="manifest" href="~/manifest.json" />
        <link rel="apple-touch-icon" sizes="180x180" href="~/icons/apple-touch-icon.png" />
        <title>Entrar | CallMed</title>
        <link rel="stylesheet" href="~/css/identity.css?v=2165"  />
        <link rel="stylesheet" href="~/css/design-v2165.css?v=2165" />
        <link rel="stylesheet" href="~/css/flow-v221.css?v=2210" />
    </head>
    <body data-cm25-view="Identity/Login" class="identity-body cm-flow-login cm25-design cm24-design cm23-design">
        <main class="flow-login-shell">
            <section class="flow-login-brand-panel">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="flow-login-brand" aria-label="CallMed">
                    <img src="~/images/logo-callmed-horizontal.png?v=2165" alt="CallMed" />
                </a>
                <div class="flow-login-statement">
                    <span>DOIS JEITOS DE USAR. UMA SÓ CALLMED.</span>
                    <h1>Seu acesso muda conforme o seu papel.</h1>
                    <p>Pacientes entram para acompanhar o próprio cuidado. Equipe e médicos entram para operar a clínica. A autenticação continua sendo a mesma e o sistema direciona cada perfil automaticamente.</p>
                </div>
                <div class="flow-login-role-cards" aria-label="Escolha a experiência de acesso">
                    <button type="button" class="active" data-flow-login-role="patient">
                        <span class="flow-role-icon">P</span>
                        <span><strong>Sou paciente</strong><small>Consultas, lista de espera, dados e atendimento.</small></span>
                    </button>
                    <button type="button" data-flow-login-role="staff">
                        <span class="flow-role-icon">E</span>
                        <span><strong>Sou da equipe</strong><small>Recepção, administração, médico ou operação.</small></span>
                    </button>
                </div>
                <div class="flow-login-footnote">CallMed · cuidado conectado à operação</div>
            </section>

            <section class="flow-login-form-panel">
                <div class="flow-login-form-card">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="identity-back">← Voltar ao início</a>
                    <div class="flow-login-context" data-flow-login-context>
                        <span>ACESSO DO PACIENTE</span>
                        <h2>Entre para continuar.</h2>
                        <p>Use seu CPF ou e-mail e sua senha.</p>
                    </div>

                    @if (TempData["SenhaRedefinida"] is string senhaRedefinida)
                    {
                        <div class="identity-note"><span>✓</span><span>@senhaRedefinida</span></div>
                    }
                    @if (Request.Query["contaInativa"] == "1")
                    {
                        <div class="mensagem erro">Esta conta está inativa. Procure a clínica para regularizar o acesso.</div>
                    }

                    <form method="post" class="identity-form flow-login-form">
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                        <div asp-validation-summary="ModelOnly" class="mensagem erro"></div>
                        <div class="input-group">
                            <label asp-for="Input.Usuario"></label>
                            <input asp-for="Input.Usuario" autocomplete="username" autofocus placeholder="CPF ou e-mail" />
                            <span asp-validation-for="Input.Usuario" class="field-error"></span>
                        </div>
                        <div class="input-group">
                            <label asp-for="Input.Password"></label>
                            <div class="password-wrap">
                                <input asp-for="Input.Password" id="login-password" autocomplete="current-password" placeholder="Digite sua senha" />
                                <button class="password-toggle" id="login-password-toggle" type="button">Mostrar</button>
                            </div>
                            <span asp-validation-for="Input.Password" class="field-error"></span>
                        </div>
                        <div class="identity-options">
                            <label><input asp-for="Input.RememberMe" /> Lembrar acesso</label>
                            <a asp-page="./ForgotPassword">Esqueci minha senha</a>
                        </div>
                        <button type="submit" class="identity-submit">Entrar na CallMed</button>
                    </form>

                    <div class="flow-login-patient-only" data-flow-patient-only>
                        <div class="identity-divider"><span>NOVO NA CALLMED?</span></div>
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="identity-secondary">Criar conta de paciente</a>
                    </div>
                    <div class="flow-login-security"><span>🔒</span><p>O perfil é identificado após o login. Permissões continuam controladas pelo ASP.NET Identity e pelas Roles do sistema.</p></div>
                </div>
            </section>
        </main>
        <script>
(() => {
    const input = document.getElementById('login-password');
    const roleButtons = [...document.querySelectorAll('[data-flow-login-role]')];
    const context = document.querySelector('[data-flow-login-context]');
    const patientOnly = document.querySelector('[data-flow-patient-only]');
    roleButtons.forEach(button => button.addEventListener('click', () => {
        roleButtons.forEach(x => x.classList.toggle('active', x === button));
        const staff = button.dataset.flowLoginRole === 'staff';
        if (context) context.innerHTML = staff
            ? '<span>ACESSO DA EQUIPE</span><h2>Entre no espaço de trabalho.</h2><p>Use seu e-mail institucional ou credencial cadastrada.</p>'
            : '<span>ACESSO DO PACIENTE</span><h2>Entre para continuar.</h2><p>Use seu CPF ou e-mail e sua senha.</p>';
        if (patientOnly) patientOnly.hidden = staff;
    }));
    const button = document.getElementById('login-password-toggle');
    button?.addEventListener('click', () => {
        const showing = input.type === 'text';
        input.type = showing ? 'password' : 'text';
        button.textContent = showing ? 'Mostrar' : 'Ocultar';
    });
})();
</script>
            <script src="~/js/theme.js?v=2165"></script>
            <script src="~/js/pwa.js?v=2165"></script>
    </body>
</html>
