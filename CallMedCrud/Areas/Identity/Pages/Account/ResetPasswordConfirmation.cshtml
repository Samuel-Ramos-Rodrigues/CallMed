@page
@model MKSANCrud.Areas.Identity.Pages.Account.ResetPasswordConfirmationModel
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Senha alterada"; }
<main class="identity-shell">
    <section class="identity-showcase">
        <a href="/" class="identity-brand cm-brand-plate"><img src="~/images/logo-callmed-horizontal.png" alt="CallMed" class="cm-auth-brand-mark" width="260" height="82" /></a>
        <div class="identity-copy"><span class="identity-kicker">ACESSO RECUPERADO</span><h1>Pronto para voltar.</h1><p>Sua conta continua no mesmo lugar. Entre usando a senha que acabou de criar.</p></div>
    </section>
    <section class="identity-panel"><div class="identity-card">
        <div class="identity-card-header"><h2>Senha alterada com sucesso</h2><p>@Model.Mensagem</p></div>
        <a href="@Url.Content("~/acesso")" class="identity-submit identity-secondary-note">Entrar com a nova senha</a>
    </div></section>
</main>
