@page
@model MKSANCrud.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    Layout = null;
    ViewData["Title"] = "Recuperar senha";
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, interactive-widget=resizes-content" />
        <meta name="theme-color" content="#eef6f2"  />
        <script>
            (function () {
                var pref = 'system';
                try {
                    var saved = localStorage.getItem('callmed-theme');
                    if (saved === 'light' || saved === 'dark' || saved === 'system') pref = saved;
                } catch { }
                var dark = pref === 'dark' || (pref === 'system' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
                document.documentElement.dataset.themePreference = pref;
                document.documentElement.dataset.theme = dark ? 'dark' : 'light';
                document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
                var themeMeta = document.querySelector('meta[name="theme-color"]');
                if (themeMeta) themeMeta.setAttribute('content', dark ? '#071611' : '#eef6f2');
            })();
        </script>
        <meta name="mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
        <meta name="apple-mobile-web-app-title" content="CallMed" />
        <meta name="application-name" content="CallMed" />
        <link rel="manifest" href="~/manifest.json" />
        <link rel="apple-touch-icon" sizes="180x180" href="~/icons/apple-touch-icon.png" />
    <title>Recuperar senha | CallMed</title>
    <link rel="stylesheet" href="~/css/identity.css?v=2160" />
</head>
<body class="identity-body">
    <main class="identity-shell">
        <section class="identity-showcase">
            <a href="/" class="identity-brand">
                <img src="~/images/logo-callmed-horizontal.png?v=2160" alt="CallMed" class="identity-brand-horizontal" />
            </a>
            <div class="identity-copy">
                <span class="identity-kicker">Recuperação de acesso</span>
                <h1>Volte para sua conta com segurança.</h1>
                <p>O link de redefinição é enviado para o e-mail cadastrado. O código nunca é exibido no site.</p>
            </div>
            <small style="position:relative;z-index:1;color:#bcd8ce">CallMed · Recuperação de conta</small>
        </section>

        <section class="identity-panel">
            <div class="identity-card">
                <a asp-page="./Login" class="identity-back">← Voltar para o login</a>

                <div class="identity-card-header">
                    <h2>Recuperar senha</h2>
                    <p>Use seu CPF ou e-mail para receber um link seguro.</p>
                </div>

                <div asp-validation-summary="All" class="validation"></div>

                @if (Model.SolicitacaoEnviada)
                {
                    <div class="identity-note">
                        <span>✉</span>
                        <span>
                            Se existir uma conta com esses dados e o envio de e-mail estiver configurado,
                            você receberá as instruções de recuperação.
                        </span>
                    </div>
                    <a asp-page="./Login" class="identity-submit" style="display:block;text-align:center;margin-top:16px">
                        Voltar para o login
                    </a>
                }
                else if (!Model.MostrarRedefinicao)
                {
                    <form method="post" asp-page-handler="Gerar" class="identity-form">
                        <div class="input-group">
                            <label asp-for="Input.Usuario">CPF ou e-mail</label>
                            <input asp-for="Input.Usuario"
                                   autocomplete="username"
                                   placeholder="CPF ou seuemail@email.com" />
                            <span asp-validation-for="Input.Usuario" class="field-error"></span>
                        </div>
                        <button type="submit" class="identity-submit">Enviar link de recuperação</button>
                    </form>
                }
                else
                {
                    <form method="post" asp-page-handler="Redefinir" class="identity-form">
                        <input asp-for="Reset.Email" type="hidden" />
                        <input asp-for="Reset.Codigo" type="hidden" />

                        <div class="input-group">
                            <label asp-for="Reset.NovaSenha">Nova senha</label>
                            <input asp-for="Reset.NovaSenha"
                                   autocomplete="new-password"
                                   placeholder="Mínimo de 8 caracteres" />
                            <span asp-validation-for="Reset.NovaSenha" class="field-error"></span>
                        </div>

                        <div class="input-group">
                            <label asp-for="Reset.ConfirmarSenha">Confirmar nova senha</label>
                            <input asp-for="Reset.ConfirmarSenha"
                                   autocomplete="new-password"
                                   placeholder="Repita a nova senha" />
                            <span asp-validation-for="Reset.ConfirmarSenha" class="field-error"></span>
                        </div>

                        <button type="submit" class="identity-submit">Redefinir senha</button>
                    </form>
                }
            </div>
        </section>
    </main>
        <script src="~/js/theme.js?v=2160"></script>
            <script src="~/js/pwa.js?v=2160"></script>
    </body>
</html>
