@page
@model MKSANCrud.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Recuperar senha";
}
<main class="identity-shell cm25-identity-shell">
        <section class="identity-showcase cm25-identity-showcase">
            <a href="/" class="identity-brand">
                <img src="~/images/logo-callmed-horizontal.png" alt="CallMed" class="identity-brand-horizontal" />
            </a>
            <div class="identity-copy">
                <span class="identity-kicker">Recuperação de acesso</span>
                <h1>Volte para sua conta com segurança.</h1>
                <p>O link de redefinição é enviado para o e-mail cadastrado. O código nunca é exibido no site.</p>
            </div>
            <small style="position:relative;z-index:1;color:#bbc3d9">CallMed · Recuperação de conta</small>
        </section>

        <section class="identity-panel cm25-identity-panel">
            <div class="identity-card cm25-identity-card">
                <a asp-page="./Login" class="identity-back">← Voltar para o login</a>

                <div class="identity-card-header cm25-identity-card-header">
                    <h2>Recuperar senha</h2>
                    <p>Use seu CPF ou e-mail para receber um link seguro.</p>
                </div>

                <div asp-validation-summary="All" class="validation"></div>

                @if (Model.SolicitacaoEnviada)
                {
                    <div class="identity-note">
                        <span>✉</span>
                        <span>
                            Se existir uma conta com esses dados e o envio de e-mail estiver configurado,
                            você receberá as instruções de recuperação.
                        </span>
                    </div>
                    <a asp-page="./Login" class="identity-submit" style="display:block;text-align:center;margin-top:16px">
                        Voltar para o login
                    </a>
                }
                else if (!Model.MostrarRedefinicao)
                {
                    <form method="post" asp-page-handler="Gerar" class="identity-form">
                        <div class="input-group">
                            <label asp-for="Input.Usuario">CPF ou e-mail</label>
                            <input asp-for="Input.Usuario"
                                   autocomplete="username"
                                   placeholder="CPF ou seuemail@email.com" />
                            <span asp-validation-for="Input.Usuario" class="field-error"></span>
                        </div>
                        <button type="submit" class="identity-submit">Enviar link de recuperação</button>
                    </form>
                }
                else
                {
                    <form method="post" asp-page-handler="Redefinir" class="identity-form">
                        <input asp-for="Reset.Email" type="hidden" />
                        <input asp-for="Reset.Codigo" type="hidden" />

                        <div class="input-group">
                            <label asp-for="Reset.NovaSenha">Nova senha</label>
                            <input asp-for="Reset.NovaSenha"
                                   autocomplete="new-password"
                                   placeholder="Mínimo de 8 caracteres" />
                            <span asp-validation-for="Reset.NovaSenha" class="field-error"></span>
                        </div>

                        <div class="input-group">
                            <label asp-for="Reset.ConfirmarSenha">Confirmar nova senha</label>
                            <input asp-for="Reset.ConfirmarSenha"
                                   autocomplete="new-password"
                                   placeholder="Repita a nova senha" />
                            <span asp-validation-for="Reset.ConfirmarSenha" class="field-error"></span>
                        </div>

                        <button type="submit" class="identity-submit">Redefinir senha</button>
                    </form>
                }
            </div>
        </section>
    </main>
