@page
@model MKSANCrud.Areas.Identity.Pages.Account.RegisterModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Criar conta";
    var loginHref = Url.Content("~/acesso");
    if (!string.IsNullOrWhiteSpace(Model.ReturnUrl) && Url.IsLocalUrl(Model.ReturnUrl))
    {
        loginHref += "?returnUrl=" + Uri.EscapeDataString(Model.ReturnUrl);
    }
    var errorKeys = ViewData.ModelState
        .Where(entry => entry.Value is not null && entry.Value.Errors.Count > 0)
        .Select(entry => entry.Key)
        .ToArray();
    var initialStep = errorKeys.Any(key => key.StartsWith("Input.Nome", StringComparison.OrdinalIgnoreCase)
        || key.StartsWith("Input.Cpf", StringComparison.OrdinalIgnoreCase)
        || key.StartsWith("Input.DataNascimento", StringComparison.OrdinalIgnoreCase)) ? 1
        : errorKeys.Any(key => key.StartsWith("Input.TemConvenio", StringComparison.OrdinalIgnoreCase)
            || key.StartsWith("Input.NomeConvenio", StringComparison.OrdinalIgnoreCase)
            || key.StartsWith("Input.NumeroConvenio", StringComparison.OrdinalIgnoreCase)
            || key.StartsWith("Input.ValidadeConvenio", StringComparison.OrdinalIgnoreCase)) ? 2
        : errorKeys.Length > 0 ? 3 : 1;
}
<main class="identity-shell cm25-identity-shell register-shell">
            <section class="identity-showcase cm25-identity-showcase">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="identity-brand">
                    <img src="~/images/logo-callmed-horizontal.png" alt="CallMed" class="identity-brand-horizontal" />
                </a>
                <div class="identity-copy">
                    <span class="identity-kicker">Novo paciente</span>
                    <h1>Crie sua conta e cuide da sua agenda.</h1>
                    <p>
                        O cadastro é dividido em etapas curtas para manter seus dados pessoais, convênio e acesso bem organizados.
                    </p>

                    <div class="register-preview">
                        <div class="register-preview-head">
                            <div class="register-preview-avatar" id="previewAvatar">P</div>
                            <div>
                                <h3 id="previewNome">Paciente CallMed</h3>
                                <p id="previewEmail">seuemail@email.com</p>
                            </div>
                        </div>
                        <div class="register-preview-grid">
                            <div>
                                <span>CPF</span>
                                <strong id="previewCpf">000.000.000-00</strong>
                            </div>
                            <div>
                                <span>Atendimento</span>
                                <strong id="previewConvenio">Particular</strong>
                            </div>
                        </div>
                    </div>
                </div>
                <small style="position:relative;z-index:1;color:#bbc3d9">Cadastro protegido · CallMed</small>
            </section>

            <section class="identity-panel cm25-identity-panel register-panel">
                <div class="identity-card cm25-identity-card register-card">
                    <a href="@loginHref" class="identity-back">← Já tenho uma conta</a>
                    <div class="identity-card-header cm25-identity-card-header">
                        <h2>Cadastro do paciente</h2>
                        <p>Preencha as três etapas. Você poderá atualizar seus dados depois.</p>
                    </div>

                    <div class="steps" aria-label="Etapas do cadastro">
                        <div class="step ativo" id="step-1">
                            <span>1</span>
                            <p>Dados</p>
                        </div>
                        <div class="linha"></div>
                        <div class="step" id="step-2">
                            <span>2</span>
                            <p>Convênio</p>
                        </div>
                        <div class="linha"></div>
                        <div class="step" id="step-3">
                            <span>3</span>
                            <p>Acesso</p>
                        </div>
                    </div>

                    <form method="post" id="form-cadastro" class="identity-form" data-initial-step="@initialStep" novalidate>
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl"  />
                        <div asp-validation-summary="ModelOnly" class="mensagem erro"></div>

                        <div class="form-etapa ativa" data-etapa="1">
                            <div class="input-group">
                                <label asp-for="Input.Nome"></label>
                                <input asp-for="Input.Nome" id="nome" autocomplete="name" placeholder="Seu nome completo"  />
                                <span asp-validation-for="Input.Nome" class="field-error"></span>
                            </div>
                            <div class="input-group">
                                <label asp-for="Input.Cpf"></label>
                                <input asp-for="Input.Cpf" id="cpf" inputmode="numeric" placeholder="000.000.000-00"  />
                                <span asp-validation-for="Input.Cpf" class="field-error"></span>
                            </div>
                            <div class="input-group">
                                <label asp-for="Input.Telefone"></label>
                                <input asp-for="Input.Telefone" id="telefone" autocomplete="tel" placeholder="(79) 99999-9999"  />
                            </div>
                            <div class="input-group">
                                <label asp-for="Input.DataNascimento"></label>
                                <input asp-for="Input.DataNascimento" type="hidden" id="dataNascimento"  />
                                <div class="date-select" data-date-select data-target="dataNascimento" data-mode="birth"></div>
                            </div>
                        </div>

                        <div class="form-etapa" data-etapa="2">
                            <div class="input-group">
                                <label asp-for="Input.TemConvenio"></label>
                                <select asp-for="Input.TemConvenio" id="temConvenio">
                                    <option value="false">Não, atendimento particular</option>
                                    <option value="true">Sim, possuo convênio</option>
                                </select>
                            </div>
                            <div id="camposConvenio" class="campos-convenio">
                                <div class="input-group">
                                    <label asp-for="Input.NomeConvenio"></label>
                                    <input asp-for="Input.NomeConvenio" id="nomeConvenio" placeholder="Ex.: Unimed"  />
                                </div>
                                <div class="input-group">
                                    <label asp-for="Input.NumeroConvenio"></label>
                                    <input asp-for="Input.NumeroConvenio" placeholder="Número da carteirinha"  />
                                </div>
                                <div class="input-group">
                                    <label asp-for="Input.ValidadeConvenio"></label>
                                    <input asp-for="Input.ValidadeConvenio" type="hidden" id="validadeConvenioRegistro"  />
                                    <div class="date-select" data-date-select data-target="validadeConvenioRegistro" data-mode="validity"></div>
                                </div>
                            </div>
                            <div class="aviso">
                                <strong>Observação:</strong>
                                os dados do convênio poderão ser conferidos durante o atendimento.
                            </div>
                        </div>

                        <div class="form-etapa" data-etapa="3">
                            <div class="input-group">
                                <label asp-for="Input.Email">E-mail</label>
                                <input asp-for="Input.Email" id="email" autocomplete="email" placeholder="seuemail@email.com"  />
                                <span asp-validation-for="Input.Email" class="field-error"></span>
                            </div>
                            <div class="input-group">
                                <label asp-for="Input.Password"></label>
                                <div class="password-wrap">
                                    <input asp-for="Input.Password" id="senha" autocomplete="new-password" placeholder="Crie uma senha segura" aria-describedby="passwordGuidance" />
                                    <button type="button" class="password-toggle" id="btnMostrarSenha" aria-label="Mostrar senha">Mostrar</button>
                                </div>
                                <span asp-validation-for="Input.Password" class="field-error"></span>
                                <div class="password-guidance" id="passwordGuidance">
                                    <strong>A senha precisa conter:</strong>
                                    <ul>
                                        <li data-password-rule="length">Pelo menos 8 caracteres</li>
                                        <li data-password-rule="upper">Uma letra maiúscula</li>
                                        <li data-password-rule="lower">Uma letra minúscula</li>
                                        <li data-password-rule="digit">Um número</li>
                                        <li data-password-rule="special">Um caractere especial, como ! ou #</li>
                                    </ul>
                                </div>
                            </div>
                            <div class="input-group">
                                <label asp-for="Input.ConfirmPassword"></label>
                                <input asp-for="Input.ConfirmPassword" id="confirmarSenha" autocomplete="new-password" placeholder="Repita sua senha" />
                                <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
                            </div>
                            <div class="checklist">
                                <strong>Seu acesso permitirá:</strong>
                                <div>✓ Entrar com CPF ou e-mail</div>
                                <div>✓ Gerenciar suas consultas</div>
                                <div>✓ Usar o assistente virtual CallMed</div>
                            </div>

                            <div class="terms-consent">
                                <input asp-for="Input.AceitaTermos" type="checkbox" id="aceitaTermos" aria-describedby="termosError" />
                                <label for="aceitaTermos">
                                    Li e concordo com os <a href="/termos-de-uso" target="_blank" rel="noopener noreferrer">Termos de Serviço</a>
                                    e com a <a href="/privacidade" target="_blank" rel="noopener noreferrer">Política de Privacidade</a> da CallMed.
                                </label>
                            </div>
                            <span asp-validation-for="Input.AceitaTermos" id="termosError" class="field-error"></span>
                        </div>

                        <div class="register-client-feedback mensagem erro" id="registerClientFeedback" role="alert" aria-live="assertive" hidden></div>
                        <div class="botoes-form">
                            <button type="button" id="btnVoltar" class="btn-secundario">Voltar</button>
                            <button type="button" id="btnProximo">Continuar</button>
                            <button type="submit" id="btnCadastrar">Criar minha conta</button>
                        </div>
                    </form>
                </div>
            </section>
        </main>
@section Scripts {
<script src="~/js/date-select.js" asp-append-version="true"></script>
<script src="~/js/identity-register.js" asp-append-version="true"></script>


}
