@model MKSANCrud.ViewModels.MedicoFormViewModel
@{ ViewData["Title"] = "Novo médico"; }
<section class="v16-page doctor-edit-page">
    <div class="v16-page-head compact-head">
        <div><span class="v16-eyebrow">MÉDICOS</span><h1>Novo médico</h1><p>Cadastre o profissional e monte a agenda semanal no mesmo fluxo.</p></div>
        <a class="btn secondary" asp-action="Index">Voltar</a>
    </div>
    <form asp-action="Create" method="post" class="doctor-form-shell">
        <partial name="_Form" model="Model" />
        <div class="v16-sticky-actions"><div><small>Revise os horários antes de salvar.</small></div><div><a class="btn secondary" asp-action="Index">Cancelar</a><button class="btn" type="submit">Cadastrar médico</button></div></div>
    </form>
</section>
