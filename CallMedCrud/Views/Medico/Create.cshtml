@model MKSANCrud.ViewModels.MedicoFormViewModel
@{ ViewData["Title"] = "Novo profissional"; var criarAcesso = ViewData["CriarAcesso"] is true; }
<section class="cm25-screen cm25-page v16-page doctor-edit-page" data-cm25-view="Medico/Create.cshtml">
    <div class="cm25-page-hero v16-page-head compact-head"><div class="cm25-hero-mark" aria-hidden="true"><svg><use href="/icons/callmed-ui.svg#doctor"></use></svg></div>
        <div><span class="cm25-kicker v16-eyebrow">PROFISSIONAIS</span><h1>Novo profissional</h1><p>@(criarAcesso ? "Primeiro, cadastre o profissional e a agenda. Depois, defina o e-mail e a senha de acesso." : "Cadastre o profissional e monte a agenda semanal no mesmo fluxo.")</p></div>
        <a class="btn secondary" asp-action="Index">Voltar</a>
    </div>
    <form asp-action="Create" method="post" class="doctor-form-shell">
        <input type="hidden" name="criarAcesso" value="@criarAcesso.ToString().ToLowerInvariant()" />
        <partial name="_Form" model="Model" />
        <div class="cm25-sticky-actions v16-sticky-actions"><div><small>Revise os horários antes de salvar.</small></div><div><a class="btn secondary" asp-action="Index">Cancelar</a><button class="btn" type="submit">@(criarAcesso ? "Continuar para criar acesso" : "Cadastrar profissional")</button></div></div>
    </form>
</section>
