@model Medico
@{
    ViewData["Title"] = "Médico";
    string Dia(int numero) => numero switch { 1 => "Segunda-feira", 2 => "Terça-feira", 3 => "Quarta-feira", 4 => "Quinta-feira", 5 => "Sexta-feira", 6 => "Sábado", _ => "Domingo" };
    var agenda = Model.HorariosSemanais.Where(x => x.Ativo).GroupBy(x => x.DiaSemana).OrderBy(g => g.Key == 0 ? 7 : g.Key).ToList();
}
<section class="cm25-screen cm25-page" data-cm25-view="Medico/Details.cshtml">
    <header class="cm25-profile-hero"><div class="cm25-profile-avatar">@(Model.Nome?.Substring(0,1).ToUpper() ?? "M")</div><div><span class="cm25-kicker">MÉDICO</span><h1>@Model.Nome</h1><p>@(Model.EspecialidadeCadastro?.Nome ?? Model.Especialidade) · @(string.IsNullOrWhiteSpace(Model.Crm) ? "CRM não informado" : Model.Crm)</p><div class="cm25-inline-pills"><span class="status-dot-pill @(Model.Ativo ? "active" : "inactive")"><i></i>@(Model.Ativo ? "Ativo" : "Inativo")</span><span class="soft-pill">@agenda.Sum(g => g.Count()) horários/semana</span></div></div><div class="cm25-hero-actions"><a class="btn" asp-action="Edit" asp-route-id="@Model.Id">Editar médico</a>@if(User.IsInRole("Admin")){<a class="btn secondary" asp-controller="MedicoAcesso" asp-action="Gerenciar" asp-route-id="@Model.Id">Acesso</a>}<a class="btn secondary" asp-action="Index">Voltar</a></div></header>
    <div class="cm25-detail-grid"><article class="cm25-detail-card"><header><span>DADOS PROFISSIONAIS</span><h2>Perfil do médico</h2></header><dl class="cm25-definition-grid"><div><dt>Nome</dt><dd>@Model.Nome</dd></div><div><dt>Especialidade</dt><dd>@(Model.EspecialidadeCadastro?.Nome ?? Model.Especialidade)</dd></div><div><dt>CRM</dt><dd>@(string.IsNullOrWhiteSpace(Model.Crm) ? "—" : Model.Crm)</dd></div><div><dt>Situação</dt><dd>@(Model.Ativo ? "Recebe novos agendamentos" : "Inativo")</dd></div></dl></article><aside class="cm25-detail-side"><div class="cm25-aside-card"><span>▦</span><h2>Agenda semanal</h2><p>@agenda.Count dia@(agenda.Count == 1 ? "" : "s") com atendimento configurado.</p></div></aside></div>
    <section class="cm25-panel cm25-schedule-panel"><header class="cm25-panel-head"><div><span class="cm25-kicker">ROTINA</span><h2>Agenda semanal</h2><p>Dias e horários configurados para atendimento regular.</p></div></header>@if(agenda.Count==0){<div class="v16-empty"><span>▦</span><strong>Nenhum horário semanal cadastrado.</strong><p>Edite o médico para montar a agenda.</p></div>}else{<div class="cm25-week-grid">@foreach(var grupo in agenda){<article class="cm25-week-day"><header><strong>@Dia(grupo.Key)</strong><span>@grupo.Count()</span></header><div>@foreach(var item in grupo.OrderBy(x=>x.Horario)){<span class="time-chip">@item.Horario</span>}</div></article>}</div>}</section>
</section>
