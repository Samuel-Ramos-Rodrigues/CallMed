@model IEnumerable<Medico>
@{
    ViewData["Title"] = "Médicos";
    var lista = Model.ToList();
    var especialidades = lista.Where(x => x.Ativo).Select(x => x.Especialidade).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).Count();
}
<section class="cm25-screen cm25-page v16-page crud-v16" data-cm25-view="Medico/Index.cshtml">
    <div class="cm25-page-hero v16-page-head"><div class="cm25-hero-mark" aria-hidden="true"><svg><use href="/icons/callmed-ui.svg#doctor"></use></svg></div>
        <div><span class="cm25-kicker v16-eyebrow">CADASTROS</span><h1>Médicos</h1><p>Profissionais, especialidades, acesso e agenda semanal.</p></div>
        <a class="btn" asp-action="Create">+ Novo médico</a>
    </div>

    <div class="cm25-kpi-grid agenda-summary compact-summary">
        <div class="cm25-kpi v16-stat"><span>Profissionais</span><strong>@lista.Count</strong><small>cadastrados</small></div>
        <div class="cm25-kpi v16-stat"><span>Ativos</span><strong>@lista.Count(x => x.Ativo)</strong><small>recebendo agenda</small></div>
        <div class="cm25-kpi v16-stat"><span>Especialidades</span><strong>@especialidades</strong><small>em atendimento</small></div>
        <div class="cm25-kpi v16-stat"><span>Com acesso</span><strong>@lista.Count(x => !string.IsNullOrWhiteSpace(x.UsuarioId))</strong><small>área do médico</small></div>
    </div>

    <div class="cm25-panel v16-card table-card">
        <div class="v16-card-head"><div><h2>Profissionais</h2><p>Abra a agenda ou edite as informações do médico.</p></div></div>
        <p class="table-scroll-hint">Deslize a tabela para os lados para ver as demais colunas e ações.</p><div class="table-scroll">
            <table class="table modern-table v16-table cm-record-table cm-record-table--doctors">
                <thead><tr><th>Profissional</th><th>Especialidade</th><th>CRM</th><th>Acesso</th><th>Situação</th><th></th></tr></thead>
                <tbody>
                @foreach (var item in lista)
                {
                    <tr>
                        <td><div class="entity-cell"><span class="entity-avatar doctor">@(item.Nome?.Substring(0,1).ToUpper() ?? "M")</span><div><strong>@item.Nome</strong><small class="entity-sub">@(string.IsNullOrWhiteSpace(item.Email) ? "Sem e-mail de acesso" : item.Email)</small></div></div></td>
                        <td><span class="soft-pill">@item.Especialidade</span></td>
                        <td>@(string.IsNullOrWhiteSpace(item.Crm) ? "—" : item.Crm)</td>
                        <td><span class="access-pill @(!string.IsNullOrWhiteSpace(item.UsuarioId) ? "linked" : "unlinked")">@(!string.IsNullOrWhiteSpace(item.UsuarioId) ? "Vinculado" : "Não configurado")</span></td>
                        <td><span class="status-dot-pill @(item.Ativo ? "active" : "inactive")"><i></i>@(item.Ativo ? "Ativo" : "Inativo")</span></td>
                        <td class="row-actions-cell">
                            <div class="row-actions" aria-label="Ações de @item.Nome">
                                <a class="row-action" asp-controller="Agenda" asp-action="Index" asp-route-medicoId="@item.Id">Agenda</a>
                                <a class="row-action" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                                <a class="row-action" asp-action="Details" asp-route-id="@item.Id">Detalhes</a>
                                <a class="row-action danger" asp-action="Delete" asp-route-id="@item.Id">Desativar</a>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (!lista.Any())
        {
            <div class="v16-empty"><span>✚</span><strong>Nenhum médico cadastrado.</strong><p>Cadastre o primeiro profissional e configure sua agenda.</p></div>
        }
    </div>
</section>
