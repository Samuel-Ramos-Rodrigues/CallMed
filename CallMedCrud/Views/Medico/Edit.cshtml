@model MKSANCrud.ViewModels.MedicoFormViewModel
@{ ViewData["Title"] = "Editar médico"; }
<section class="v16-page doctor-edit-page">
    <div class="v16-page-head compact-head">
        <div><span class="v16-eyebrow">MÉDICOS</span><h1>Editar médico</h1><p>Atualize os dados e a agenda semanal sem mexer nas consultas já protegidas pelo sistema.</p></div>
        <a class="btn secondary" asp-action="Index">Voltar</a>
    </div>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="doctor-form-shell">
        <input type="hidden" asp-for="Id" />
        <partial name="_Form" model="Model" />
        <div class="v16-sticky-actions"><div><small>Consultas futuras impedem a remoção de horários em uso.</small></div><div><a class="btn secondary" asp-action="Index">Cancelar</a><button class="btn" type="submit">Salvar alterações</button></div></div>
    </form>
</section>
