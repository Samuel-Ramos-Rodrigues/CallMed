@model MKSANCrud.ViewModels.MinhaContaViewModel
@{ ViewData["Title"] = "Editar minha conta"; }
<section class="cm25-screen cm25-page" data-cm25-view="MinhaConta/Edit.cshtml"><header class="cm25-page-hero"><div class="cm25-hero-mark"><svg><use href="/icons/callmed-ui.svg#user"></use></svg></div><div class="cm25-hero-copy"><span class="cm25-kicker">MINHA CONTA</span><h1>Editar dados pessoais</h1><p>Mantenha contato, nascimento e convênio atualizados para facilitar confirmações e agendamentos.</p></div><div class="cm25-hero-actions"><a class="btn secondary" asp-action="Index">Voltar ao perfil</a></div></header>
<form asp-action="Edit" method="post" class="cm25-editor-shell"><input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<section class="cm25-section-card"><div class="patient-form-section-head"><span class="patient-form-section-icon"><svg><use href="/icons/callmed-ui.svg#user"></use></svg></span><div><h2>Dados pessoais</h2><p>Informações básicas do seu cadastro.</p></div></div><div class="patient-form-section-body"><div class="form-grid"><div class="field"><label asp-for="Nome">Nome completo</label><input asp-for="Nome"/><span asp-validation-for="Nome" class="text-danger"></span></div><div class="field"><label asp-for="Email">E-mail</label><input asp-for="Email"/><span asp-validation-for="Email" class="text-danger"></span></div><div class="field"><label asp-for="Telefone">Telefone</label><input asp-for="Telefone"/></div><div class="field"><label asp-for="CanalPreferido">Canal preferido</label><select asp-for="CanalPreferido"><option value="WhatsApp">WhatsApp</option><option value="SMS">SMS</option><option value="Email">E-mail</option><option value="Telefone">Telefone (contato manual)</option></select><small>A CallMed tenta este canal primeiro em lembretes e confirmações.</small></div><div class="field full"><label asp-for="DataNascimento">Data de nascimento</label><input asp-for="DataNascimento" type="hidden" id="dataNascimentoConta"/><div class="date-select" data-date-select data-target="dataNascimentoConta" data-mode="birth"></div></div></div></div></section>
<section class="cm25-section-card"><div class="patient-form-section-head"><span class="patient-form-section-icon"><svg><use href="/icons/callmed-ui.svg#card"></use></svg></span><div><h2>Convênio</h2><p>Dados usados na triagem administrativa.</p></div></div><div class="patient-form-section-body"><div class="form-grid"><div class="field full"><label class="cm25-toggle-row"><input asp-for="TemConvenio"/><span><strong>Possuo convênio</strong><small>Ative para manter os dados da carteirinha.</small></span></label></div><div class="field"><label asp-for="NomeConvenio">Nome do convênio</label><input asp-for="NomeConvenio"/></div><div class="field"><label asp-for="NumeroConvenio">Número da carteirinha</label><input asp-for="NumeroConvenio"/></div><div class="field full"><label asp-for="ValidadeConvenio">Validade</label><input asp-for="ValidadeConvenio" type="hidden" id="validadeConvenioConta"/><div class="date-select" data-date-select data-target="validadeConvenioConta" data-mode="validity"></div></div></div></div></section>
<div class="cm25-sticky-actions"><span>As alterações serão usadas nos próximos atendimentos.</span><div><a class="btn secondary" asp-action="Index">Cancelar</a><button class="btn" type="submit">Salvar meus dados</button></div></div></form></section>
