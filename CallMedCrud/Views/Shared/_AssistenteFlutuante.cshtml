@{
    var autenticado = User.Identity?.IsAuthenticated == true;
    var podeUsarAssistente = User.IsInRole("Paciente") || User.IsInRole("Funcionario") || User.IsInRole("Admin");
}

@if (autenticado && podeUsarAssistente)
{
    <div class="mksan-floating-actions"
         data-user-id="@(User.Identity?.Name ?? "anon")">

        <button type="button"
                id="mksan-ai-fab" data-design="cm25"
                class="mksan-fab mksan-ai-fab"
                aria-label="Abrir assistente virtual CallMed"
                aria-controls="mksan-ai-widget"
                aria-expanded="false"
                title="Assistente virtual CallMed">

            <span class="mksan-ai-ring" aria-hidden="true"></span>

            <img src="~/images/logo-callmed-mark.png"
                 alt=""
                 class="mksan-fab-logo" />

            <span class="mksan-online-dot"
                  aria-hidden="true"></span>
        </button>
    </div>

    <section id="mksan-ai-widget"
             class="mksan-ai-widget"
             aria-hidden="true"
             aria-label="Assistente virtual CallMed">

        <header class="mksan-ai-widget-header">
            <div class="mksan-widget-brand">
                <span class="mksan-widget-brand-icon">
                    <img src="~/images/logo-callmed-mark.png"
                         alt="" />
                </span>

                <div class="mksan-widget-brand-copy">
                    <small>ASSISTENTE VIRTUAL</small>
                    <strong>CallMed</strong>

                    <span class="mksan-widget-status ia">
                        <i aria-hidden="true"></i>
                        <span>Assistente IA</span>
                    </span>
                </div>
            </div>

            <div class="mksan-ai-widget-actions">
                <button type="button"
                        id="mksan-widget-new"
                        title="Limpar mensagens"
                        aria-label="Limpar mensagens exibidas">
                    ↻
                </button>

                <button type="button"
                        id="mksan-widget-close"
                        title="Fechar"
                        aria-label="Fechar assistente">
                    ×
                </button>
            </div>
        </header>

        <div id="mksan-widget-messages"
             class="mksan-ai-widget-messages"
             role="log"
             aria-live="polite"
             aria-relevant="additions"></div>

        <div class="mksan-widget-endbar"><span id="mksan-widget-end-status" role="status"></span><button type="button" id="mksan-widget-end">Encerrar e avaliar</button></div>
        <template id="mksan-feedback-template">
            <form class="mksan-feedback-card" aria-label="Avaliação do atendimento">
                <strong>Como foi seu atendimento?</strong>
                <p>Escolha uma nota de 1 a 5. Sua opinião é opcional.</p>
                <fieldset><legend class="visually-hidden">Nota do atendimento</legend><div class="mksan-feedback-options">
                    @foreach (var item in new[] { (1, "Muito ruim"), (2, "Ruim"), (3, "Regular"), (4, "Bom"), (5, "Muito bom") })
                    { <label><input type="radio" name="nota" value="@item.Item1" required /><span><b>@item.Item1</b><small>@item.Item2</small></span></label> }
                </div></fieldset>
                <label class="mksan-feedback-comment">Quer contar mais? <small>(opcional)</small><textarea name="comentario" rows="2" maxlength="1000" placeholder="O que podemos melhorar?"></textarea></label>
                <div class="mksan-feedback-actions"><button type="submit" class="btn">Enviar avaliação</button><button type="button" class="btn secondary" data-feedback-skip>Agora não</button></div>
                <p class="mksan-feedback-result" role="status" aria-live="polite"></p>
            </form>
        </template>

        <form id="mksan-widget-form"
              class="mksan-ai-widget-form">

            @Html.AntiForgeryToken()

            <textarea id="mksan-widget-input"
                      rows="1"
                      maxlength="1000"
                      autocomplete="off"
                      aria-label="Mensagem para o assistente"
                      placeholder="Digite sua mensagem..."></textarea>

            <button id="mksan-widget-send"
                    type="submit"
                    aria-label="Enviar mensagem"
                    title="Enviar">
                ➤
            </button>
        </form>
    </section>
}
