<!DOCTYPE html>
<html lang="pt-BR">
<head><partial name="_DocumentHead" /><link rel="stylesheet" href="~/css/identity.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/clinic-theme.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/clinic-redesign.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/clinic-final-fixes.css" asp-append-version="true" /></head>
<body class="identity-body">
<div class="identity-access-tools" aria-label="Opções de acessibilidade">
    <span class="identity-access-label">Acessibilidade</span>
    <button type="button" class="identity-a11y-button" data-a11y-toggle="large" aria-pressed="false">Aa <span>Texto maior</span><small data-a11y-status>Desativado</small></button>
    <button type="button" class="identity-a11y-button" data-a11y-toggle="contrast" aria-pressed="false">◐ <span>Alto contraste</span><small data-a11y-status>Desativado</small></button>
</div>
@RenderBody()
<script src="~/js/accessibility.js" asp-append-version="true"></script>
<script src="~/js/theme.js" asp-append-version="true"></script>
<script src="~/js/pwa.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
