@model List<MKSANCrud.Models.PedidoPrivacidade>
@{ViewData["Title"]="Meus dados e privacidade";var respostas=(Dictionary<Guid,string>)ViewBag.Respostas;}
<section class="jornada cm-workspace"><header class="cm-page-intro"><span class="cm-intro-icon" aria-hidden="true"><svg><use href="/icons/callmed-ui.svg#shield-check"></use></svg></span><div><span class="eyebrow">SEUS DIREITOS</span><h1>Meus dados e privacidade</h1><p>Registre solicitações e acompanhe as respostas da clínica em um espaço autenticado.</p></div></header>
<div class="cm-two-columns"><section class="cm-action-panel"><span class="eyebrow">NOVO PEDIDO</span><h2>Como podemos ajudar?</h2><p>Solicite acesso, correção, análise de eliminação ou revogação de consentimento.</p><form asp-action="Solicitar" method="post" class="j-form"><label>O que deseja solicitar?<select name="tipo"><option value="Acesso">Acesso e cópia dos meus dados</option><option value="Correcao">Correção de dados</option><option value="Eliminacao">Análise de eliminação de dados</option><option value="Revogacao">Revogação de consentimento</option></select></label><label class="j-check"><input type="checkbox" name="confirmar" value="true" required/><span>Quero registrar este pedido em meu nome.</span></label><button class="btn" type="submit">Registrar pedido</button></form></section>
<aside class="cm-action-panel cm-privacy-guide"><span class="cm-guide-icon" aria-hidden="true"><svg><use href="/icons/callmed-ui.svg#shield-check"></use></svg></span><h2>Você acompanha cada etapa</h2><ol class="cm-numbered-steps"><li><strong>Registre seu pedido</strong><span>Escolha o tipo de solicitação nesta página.</span></li><li><strong>A clínica faz a análise</strong><span>Registros sujeitos a guarda profissional ou obrigação legal exigem análise antes da eliminação.</span></li><li><strong>Consulte a resposta</strong><span>A resposta ficará disponível em Meus pedidos, logo abaixo.</span></li></ol><p class="cm-panel-footnote">A solicitação não apaga automaticamente o prontuário nem altera suas consultas.</p></aside></div>
<div class="cm-section-heading"><div><span class="eyebrow">ACOMPANHAMENTO</span><h2>Meus pedidos</h2></div><span class="cm-status-pill">@Model.Count registrados</span></div>
@if(Model.Count==0){<div class="cm-empty-state"><span class="cm-guide-icon" aria-hidden="true"><svg><use href="/icons/callmed-ui.svg#clipboard-check"></use></svg></span><h3>Nenhum pedido registrado</h3><p>Quando você registrar uma solicitação, o protocolo e a resposta aparecerão aqui.</p></div>}
@foreach(var p in Model){<article class="j-card"><div class="cm-section-heading"><h3>@p.Tipo</h3><span class="cm-status-pill">@p.Estado</span></div><dl class="cm-request-meta"><dt>Protocolo</dt><dd>@p.Id</dd><dt>Recebido em</dt><dd>@p.CriadoEm.ToString("dd/MM/yyyy HH:mm 'UTC'")</dd></dl>@if(respostas.TryGetValue(p.Id,out var texto)){<div class="cm-info-banner cm-text-preserve">@texto</div>}else{<p class="cm-panel-footnote">Aguardando análise da clínica.</p>}</article>}
<a asp-controller="MinhaConta" asp-action="Index">← Voltar à minha conta</a></section>
