@model List<MKSANCrud.Models.PedidoPrivacidade>
@{ViewData["Title"]="Pedidos de privacidade";}

<section class="jornada cm-workspace"><div class="cm-page-intro"><span class="cm-intro-icon" aria-hidden="true"><svg><use href="/icons/callmed-ui.svg#shield-check"></use></svg></span><div><span class="eyebrow">PRIVACIDADE</span><h1>Pedidos de privacidade</h1><p>Analise os pedidos e registre uma resposta para cada paciente.</p></div></div><p>Restrito ao responsável administrativo autorizado. Use o identificador da conta para conferir a identidade em Usuários. O conteúdo clínico deve ser analisado pelo profissional responsável. Não copie conteúdo de sessões nesta resposta.</p>@if(Model.Count==0){<div class="cm-empty-state"><span class="cm-guide-icon" aria-hidden="true"><svg><use href="/icons/callmed-ui.svg#shield-check"></use></svg></span><h2>Nenhum pedido para analisar</h2><p>As solicitações dos pacientes aparecerão aqui com o protocolo e o estado de cada análise.</p></div>}@foreach(var p in Model){<article class="j-card"><h2>@p.Tipo · @p.Estado</h2><p>Protocolo: @p.Id · Conta: @p.UsuarioId</p><p>Recebido em @p.CriadoEm.ToString("dd/MM/yyyy HH:mm 'UTC'")</p>@if(p.RespondidoEm==null){<form asp-action="Responder" method="post" class="j-form"><input type="hidden" name="id" value="@p.Id"/><input type="hidden" name="versao" value="@p.Versao"/><label>Resultado da análise<select name="decisao"><option value="Atendido">Atendido</option><option value="Parcial">Parcialmente atendido</option><option value="Justificado">Não atendido com justificativa</option></select></label><label>Resposta ao titular, fundamento e referência de entrega<textarea name="resposta" maxlength="3000" rows="4" required></textarea></label><label class="j-check"><input type="checkbox" name="confirmar" value="true" required/> Conferi a identidade, a análise pelo responsável e a efetivação das medidas descritas.</label><button class="btn" type="submit">Disponibilizar resposta</button></form>}else{<p>Respondido em @p.RespondidoEm.Value.ToString("dd/MM/yyyy HH:mm 'UTC'") · responsável @p.RespondidoPor</p>}</article>}
<a asp-controller="Jornada" asp-action="Index">Voltar ao fluxo</a></section>
