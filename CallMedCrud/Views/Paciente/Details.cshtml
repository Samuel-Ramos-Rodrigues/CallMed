@model Paciente
@{
    ViewData["Title"] = "Paciente";
    var consultas = Model.Consultas.OrderByDescending(x => x.Data).ThenByDescending(x => x.Horario).Take(8).ToList();
    var iniciais = string.Join("", (Model.Nome ?? "P").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x.Substring(0,1).ToUpper()));
    var solicitacoes = ViewBag.Solicitacoes as IEnumerable<MKSANCrud.Models.SolicitacaoAtendimento> ?? Enumerable.Empty<MKSANCrud.Models.SolicitacaoAtendimento>();
    var listaEspera = ViewBag.ListaEspera as IEnumerable<MKSANCrud.Models.ListaEspera> ?? Enumerable.Empty<MKSANCrud.Models.ListaEspera>();
}
<section class="cm19-patient-record">
    <header class="cm19-record-head cm19-card">
        <div class="cm19-record-profile"><span class="cm19-record-avatar">@iniciais</span><div><h1>@Model.Nome <span class="cm19-status-dot @(Model.Ativo ? "on" : "off")">@(Model.Ativo ? "Ativo" : "Inativo")</span></h1><p>@(Model.Ativo ? "Paciente ativo na CallMed" : "Cadastro inativo")</p></div></div>
        <div class="cm19-head-actions"><a class="btn secondary" asp-action="Index">Voltar</a><a class="btn" asp-action="Edit" asp-route-id="@Model.Id">Editar perfil</a></div>
    </header>

    <nav class="cm19-record-tabs"><a href="#dados" class="active">Dados</a><a href="#consultas">Consultas</a><a href="#solicitacoes">Solicitações</a><a href="#espera">Lista de espera</a><a asp-controller="Atendimento" asp-action="Index">Atendimentos</a></nav>

    <div class="cm19-record-grid" id="dados">
        <section class="cm19-card cm19-data-card">
            <div class="cm19-card-head"><div><h2>Dados pessoais</h2><p>Informações principais do paciente.</p></div></div>
            <dl class="cm19-data-list">
                <div><dt><svg><use href="/icons/callmed-ui.svg#mail"></use></svg>E-mail</dt><dd>@Model.Email</dd></div>
                <div><dt><svg><use href="/icons/callmed-ui.svg#phone"></use></svg>Telefone</dt><dd>@(string.IsNullOrWhiteSpace(Model.Telefone) ? "Não informado" : Model.Telefone)</dd></div>
                <div><dt><svg><use href="/icons/callmed-ui.svg#bell"></use></svg>Canal preferido</dt><dd>@Model.CanalPreferido</dd></div>
                <div><dt><svg><use href="/icons/callmed-ui.svg#user"></use></svg>CPF</dt><dd>@Model.Cpf</dd></div>
                <div><dt><svg><use href="/icons/callmed-ui.svg#calendar"></use></svg>Data de nascimento</dt><dd>@(Model.DataNascimento?.ToString("dd/MM/yyyy") ?? "Não informada")</dd></div>
            </dl>
        </section>
        <section class="cm19-card cm19-data-card">
            <div class="cm19-card-head"><div><h2>Convênio e atendimento</h2><p>Dados utilizados no agendamento.</p></div></div>
            <dl class="cm19-data-list">
                <div><dt><svg><use href="/icons/callmed-ui.svg#card"></use></svg>Atendimento</dt><dd>@(Model.TemConvenio ? "Convênio" : "Particular")</dd></div>
                <div><dt>Convênio</dt><dd>@(Model.TemConvenio ? Model.NomeConvenio ?? "Não informado" : "—")</dd></div>
                <div><dt>Carteirinha</dt><dd>@(Model.TemConvenio ? Model.NumeroConvenio ?? "Não informada" : "—")</dd></div>
                <div><dt>Validade</dt><dd>@(Model.TemConvenio ? Model.ValidadeConvenio?.ToString("dd/MM/yyyy") ?? "Não informada" : "—")</dd></div>
            </dl>
        </section>
    </div>

    <section class="cm19-card cm19-history-card" id="consultas">
        <div class="cm19-card-head"><div><h2>Consultas</h2><p>Atendimentos recentes deste paciente.</p></div><a class="btn small" asp-controller="Consulta" asp-action="Create" asp-route-pacienteId="@Model.Id">+ Nova consulta</a></div>
        @if (!consultas.Any()) { <div class="cm19-empty">Nenhuma consulta registrada.</div> }
        else
        {
            <div class="cm19-record-appointments">
                @foreach (var item in consultas)
                {
                    <a asp-controller="Consulta" asp-action="Details" asp-route-id="@item.Id"><time><strong>@item.Data.ToString("dd")</strong><small>@item.Data.ToString("MMM")</small></time><span><strong>@item.Medico?.Nome</strong><small>@item.Medico?.Especialidade · @item.Horario</small></span><em class="cm19-status status-@item.Status.ToLowerInvariant()">@item.Status</em><b>›</b></a>
                }
            </div>
        }
    </section>
    <section class="cm19-card cm19-history-card" id="solicitacoes">
        <div class="cm19-card-head"><div><h2>Solicitações e triagens</h2><p>Histórico integrado de pedidos recebidos por todos os canais.</p></div><a class="btn small secondary" asp-controller="Solicitacoes" asp-action="Create">+ Nova solicitação</a></div>
        @if (!solicitacoes.Any()) { <div class="cm19-empty">Nenhuma solicitação registrada.</div> }
        else {
            <div class="cm21-patient-request-list">
            @foreach (var item in solicitacoes) {
                <a asp-controller="Solicitacoes" asp-action="Triagem" asp-route-id="@item.Id"><span><strong>#@item.Id · @item.Canal</strong><small>@(item.Especialidade?.Nome ?? "Especialidade não definida") · @ClinicaClock.ConverterUtc(item.CriadoEm).ToString("dd/MM/yyyy HH:mm")</small></span><em>@item.Status</em></a>
            }
            </div>
        }
    </section>
    <section class="cm19-card cm19-history-card" id="espera">
        <div class="cm19-card-head"><div><h2>Lista de espera</h2><p>Pedidos de antecipação e vagas monitoradas.</p></div></div>
        @if (!listaEspera.Any()) { <div class="cm19-empty">Nenhum pedido de lista de espera.</div> }
        else {
            <div class="cm21-patient-request-list">
            @foreach (var item in listaEspera) {
                <div><span><strong>@(item.Medico?.Nome ?? item.Especialidade?.Nome ?? "Preferência")</strong><small>@(item.DataPreferida?.ToString("dd/MM/yyyy") ?? "Qualquer data") · @item.Periodo</small></span><em>@(item.Ativa ? "Ativa" : "Encerrada")</em></div>
            }
            </div>
        }
    </section>
</section>
