@model Paciente
@{ ViewData["Title"] = "Novo paciente"; }
<section class="cm25-screen cm25-page patient-editor-page" data-cm25-view="Paciente/Create.cshtml">
    <header class="cm25-page-hero"><div class="cm25-hero-mark"><svg aria-hidden="true"><use href="/icons/callmed-ui.svg#user"></use></svg></div><div class="cm25-hero-copy"><span class="cm25-kicker">PACIENTES · NOVO CADASTRO</span><h1>Novo paciente</h1><p>Cadastre identificação, contato e convênio em um fluxo organizado.</p></div><div class="cm25-hero-actions"><a class="btn secondary" asp-action="Index">Voltar para pacientes</a></div></header>
    <form asp-action="Create" method="post" class="patient-form-shell cm25-editor-shell"><partial name="_Form" model="Model" /><div class="cm25-sticky-actions"><span>Os campos serão validados antes de criar o cadastro.</span><div><a class="btn secondary" asp-action="Index">Cancelar</a><button class="btn" type="submit">Cadastrar paciente</button></div></div></form>
</section>
