@model Paciente
@{
    ViewData["Title"] = "Novo paciente";
}
<section class="v16-page patient-editor-page">
    <form asp-action="Create" method="post" class="patient-form-shell">
        <partial name="_Form" model="Model" />
        <div class="patient-form-actions">
            <a class="btn secondary" asp-action="Index">← Voltar</a>
            <button class="btn" type="submit">Cadastrar paciente</button>
        </div>
    </form>
</section>
