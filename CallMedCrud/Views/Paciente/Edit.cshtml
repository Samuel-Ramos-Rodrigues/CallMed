@model Paciente
@{
    ViewData["Title"] = "Editar paciente";
}
<section class="v16-page patient-editor-page">
    <form asp-action="Edit" method="post" class="patient-form-shell">
        <input type="hidden" asp-for="Id" />
        <partial name="_Form" model="Model" />
        <div class="patient-form-actions">
            <a class="btn secondary" asp-action="Index">← Voltar</a>
            <button class="btn" type="submit">Salvar alterações</button>
        </div>
    </form>
</section>
