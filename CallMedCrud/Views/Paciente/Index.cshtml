@using MKSANCrud.Services.Clinica
@model IEnumerable<Paciente>
@{
    ViewData["Title"] = "Pacientes";
    var lista = Model.ToList();
}
<section class="cm25-screen cm25-page v16-page crud-v16" data-cm25-view="Paciente/Index.cshtml">
    <div class="cm25-page-hero v16-page-head"><div class="cm25-hero-mark" aria-hidden="true"><svg><use href="/icons/callmed-ui.svg#user"></use></svg></div>
        <div><span class="cm25-kicker v16-eyebrow">CADASTROS</span><h1>Pacientes</h1><p>Dados, contato, convênio e histórico de atendimento em um só cadastro.</p></div>
        <a class="btn" asp-action="Create">+ Novo paciente</a>
    </div>

    <div class="patient-toolbar v16-card">
        <form method="get" class="v16-search-form">
            <div class="v16-search-box"><span aria-hidden="true"><svg><use href="/icons/callmed-ui.svg#search"></use></svg></span><input name="busca" value="@ViewBag.Busca" placeholder="Buscar por nome, CPF ou e-mail" /></div>
            <input type="hidden" name="incluirInativos" value="@(ViewBag.IncluirInativos == true ? "true" : "false")" />
            <button class="btn" type="submit">Buscar</button>
            <a class="btn secondary" asp-action="Index">Limpar</a>
        </form>
        <a class="filter-toggle-link" asp-action="Index" asp-route-busca="@ViewBag.Busca" asp-route-incluirInativos="@(ViewBag.IncluirInativos != true)">@(ViewBag.IncluirInativos == true ? "Ocultar inativos" : "Mostrar inativos")</a>
    </div>

    <div class="cm25-kpi-grid agenda-summary compact-summary cm-patient-summary">
        <div class="cm25-kpi v16-stat"><span>Resultados</span><strong>@(ViewBag.TotalResultados ?? lista.Count)</strong><small>na busca atual</small></div>
        <div class="cm25-kpi v16-stat"><span>Ativos</span><strong>@(ViewBag.TotalAtivos ?? lista.Count(x => x.Ativo))</strong><small>com acesso disponível</small></div>
        <div class="cm25-kpi v16-stat"><span>Convênio</span><strong>@(ViewBag.TotalConvenio ?? lista.Count(x => x.Ativo && x.TemConvenio))</strong><small>pacientes conveniados</small></div>
        <div class="cm25-kpi v16-stat"><span>Particular</span><strong>@(ViewBag.TotalParticular ?? lista.Count(x => x.Ativo && !x.TemConvenio))</strong><small>atendimento particular</small></div>
    </div>

    <div class="cm25-panel v16-card table-card">
        <div class="v16-card-head"><div><h2>Pacientes</h2><p>@lista.Count registro@(lista.Count == 1 ? "" : "s") encontrado@(lista.Count == 1 ? "" : "s").</p></div></div>
        <p class="table-scroll-hint">Deslize a tabela para os lados para ver as demais colunas e ações.</p><div class="table-scroll" tabindex="0" aria-label="Tabela com rolagem horizontal">
            <table class="table modern-table v16-table cm-record-table cm-record-table--patients">
                <thead><tr><th>Paciente</th><th>CPF</th><th>Telefone</th><th>Convênio</th><th>Situação</th><th></th></tr></thead>
                <tbody>
                @foreach (var item in lista)
                {
                    <tr>
                        <td><div class="entity-cell"><span class="entity-avatar">@(item.Nome?.Substring(0,1).ToUpper() ?? "P")</span><div><strong>@item.Nome</strong><small class="entity-sub">@item.Email</small></div></div></td>
                        <td>@ContatoFormato.Cpf(item.Cpf)</td>
                        <td>@(string.IsNullOrWhiteSpace(item.Telefone) ? "—" : item.Telefone)</td>
                        <td><span class="soft-pill">@(item.TemConvenio ? item.NomeConvenio ?? "Convênio" : "Particular")</span></td>
                        <td><span class="status-dot-pill @(item.Ativo ? "active" : "inactive")"><i></i>@(item.Ativo ? "Ativo" : "Inativo")</span></td>
                        <td class="row-actions-cell">
                            <div class="row-actions" aria-label="Ações de @item.Nome">
                                <a class="row-action" asp-action="Details" asp-route-id="@item.Id">Detalhes</a>
                                <a class="row-action" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                                @if (item.Ativo) { <a class="row-action danger" asp-action="Delete" asp-route-id="@item.Id">Desativar</a> }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (!lista.Any())
        {
            <div class="v16-empty"><span aria-hidden="true"><svg><use href="/icons/callmed-ui.svg#user"></use></svg></span><strong>Nenhum paciente encontrado.</strong><p>Tente mudar os filtros ou cadastre um novo paciente.</p></div>
        }
    </div>
@if((ViewBag.TotalPaginas as int? ?? 1)>1) {
<nav class="cm-consult-pagination" aria-label="Páginas de pacientes"><span>Página @ViewBag.Pagina de @ViewBag.TotalPaginas</span><div class="cm-task-actions">
@if((int)ViewBag.Pagina>1){<a class="btn secondary" asp-action="Index" asp-route-pagina="@((int)ViewBag.Pagina-1)" asp-route-busca="@ViewBag.Busca" asp-route-incluirInativos="@ViewBag.IncluirInativos" rel="prev">Anterior</a>}
@if((int)ViewBag.Pagina<(int)ViewBag.TotalPaginas){<a class="btn secondary" asp-action="Index" asp-route-pagina="@((int)ViewBag.Pagina+1)" asp-route-busca="@ViewBag.Busca" asp-route-incluirInativos="@ViewBag.IncluirInativos" rel="next">Próxima</a>}
</div></nav>}
</section>
