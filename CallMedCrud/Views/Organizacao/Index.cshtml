@model MKSANCrud.Services.Usuarios.ItemNavegacao[]
@{ViewData["Title"]="Áreas do sistema";}

<section class="cm-organizacao" id="cm-organizacao"><header class="cm-page-intro"><span class="cm-intro-icon" aria-hidden="true"><svg><use href="/icons/callmed-ui.svg#menu"></use></svg></span><div><span class="eyebrow">ÁREAS DO SISTEMA</span><h1>O que você precisa fazer?</h1><p>As funções estão organizadas por objetivo. A rotina diária fica no menu principal; as demais áreas ficam aqui.</p></div></header>
<div class="cm-directory-search"><label for="cm-buscar-funcao">Buscar uma função<input id="cm-buscar-funcao" type="search" placeholder="Ex.: remarcar, convênio, profissional" autocomplete="off"/></label></div><p id="cm-busca-status" role="status" aria-live="polite"></p>
@foreach(var grupo in Model.GroupBy(x=>x.Grupo)){<details class="cm-area" open="@(grupo.Key is "Rotina" or "Meu cuidado" or "Meu atendimento")"><summary><strong>@grupo.Key</strong><span>@grupo.Count() funções</span></summary><div class="cm-area-cards">@foreach(var i in grupo){<a class="cm-funcao" href="@Url.Action(i.Action,i.Controller)"><span class="cm-function-top"><svg aria-hidden="true"><use href="/icons/callmed-ui.svg#@(i.Grupo.Contains("Gest")?"chart":i.Grupo.Contains("Cadastro")?"team":i.Grupo.Contains("cuidado")?"heart-pulse":"clipboard-check")"></use></svg><span aria-hidden="true"><svg class="cm-direction-icon"><use href="/icons/callmed-ui.svg#arrow-up-right"></use></svg></span></span><strong>@i.Titulo</strong><span>@i.Descricao</span></a>}</div></details>}
<p id="cm-busca-vazia" hidden>Nenhuma função encontrada. Tente outro termo ou abra uma das áreas.</p>
</section><script src="~/js/organizacao.js" asp-append-version="true" defer></script>
