@model Funcionario
@{
    ViewData["Title"]="Novo funcionário";
}
<div class="page-head">
    <h1>Novo funcionário</h1>
</div>
<form asp-action="Create" method="post" class="form-card">
    <partial name="_Form" model="Model" />
    <div class="form-actions">
        <button class="btn" type="submit">Cadastrar</button>
        <a class="btn secondary" asp-action="Index">Voltar</a>
    </div>
</form>
