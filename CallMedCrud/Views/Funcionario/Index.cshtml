@model IEnumerable<Funcionario>
@{ ViewData["Title"]="Funcionários"; var lista=Model.ToList(); }
<section class="v16-page"><div class="v16-page-head"><div><span class="v16-eyebrow">EQUIPE</span><h1>Funcionários</h1><p>Gerencie os acessos da recepção e da administração da clínica.</p></div><a class="btn" asp-action="Create">+ Novo funcionário</a></div>
<div class="agenda-summary"><div class="v16-stat"><span>Total</span><strong>@lista.Count</strong><small>cadastros</small></div><div class="v16-stat"><span>Ativos</span><strong>@lista.Count(x=>x.Ativo)</strong><small>com acesso</small></div><div class="v16-stat"><span>Inativos</span><strong>@lista.Count(x=>!x.Ativo)</strong><small>acesso bloqueado</small></div><div class="v16-stat"><span>Perfis</span><strong class="stat-date">Equipe</strong><small>recepção e admin</small></div></div>
<div class="v16-card table-card">@if(!lista.Any()){<div class="v16-empty"><strong>Nenhum funcionário cadastrado.</strong></div>}else{<div class="table-scroll"><table class="v16-table"><thead><tr><th>Nome</th><th>E-mail</th><th>Cargo</th><th>Situação</th><th></th></tr></thead><tbody>@foreach(var item in lista){<tr><td><strong>@item.Nome</strong></td><td>@item.Email</td><td><span class="soft-pill">@item.Cargo</span></td><td><span class="status-dot-pill @(item.Ativo?"active":"inactive")"><i></i>@(item.Ativo?"Ativo":"Inativo")</span></td><td><details class="row-menu"><summary>•••</summary><div><a asp-action="Details" asp-route-id="@item.Id">Detalhes</a><a asp-action="Edit" asp-route-id="@item.Id">Editar</a>@if(item.Ativo){<a class="danger" asp-action="Delete" asp-route-id="@item.Id">Desativar</a>}</div></details></td></tr>}</tbody></table></div>}</div></section>
