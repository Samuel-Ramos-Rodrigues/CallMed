@model Funcionario
<div asp-validation-summary="ModelOnly" class="validation"></div>
<div class="form-grid">
    <div class="field full">
        <label asp-for="Nome"></label>
        <input asp-for="Nome" />
        <span asp-validation-for="Nome" class="validation"></span>
    </div>
    <div class="field full">
        <label asp-for="Email">E-mail</label>
        <input asp-for="Email" />
        <span asp-validation-for="Email" class="validation"></span>
    </div>
    @if (Model == null || Model.Id == 0)
    {
        <div class="field full">
            <label asp-for="Senha">Senha de acesso</label>
            <input asp-for="Senha" autocomplete="new-password" placeholder="Mínimo de 8 caracteres, com letra e número" />
            <span asp-validation-for="Senha" class="validation"></span>
        </div>
    }
    <div class="field">
        <label asp-for="Cargo"></label>
        <select asp-for="Cargo">
            <option>Atendente</option>
            <option>Recepcionista</option>
            <option>Administrador</option>
        </select>
    </div>
    <div class="field check">
        <input asp-for="Ativo" />
        <label asp-for="Ativo">Ativo</label>
    </div>
</div>
