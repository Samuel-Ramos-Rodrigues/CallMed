@model Funcionario
@{ ViewData["Title"] = "Funcionário"; }
<section class="cm25-screen cm25-page" data-cm25-view="Funcionario/Details.cshtml">
    <header class="cm25-profile-hero">
        <div class="cm25-profile-avatar">@(Model.Nome?.Substring(0,1).ToUpper() ?? "F")</div>
        <div><span class="cm25-kicker">EQUIPE CALLMED</span><h1>@Model.Nome</h1><p>@Model.Email</p><div class="cm25-inline-pills"><span class="soft-pill">@Model.Cargo</span><span class="status-dot-pill @(Model.Ativo ? "active" : "inactive")"><i></i>@(Model.Ativo ? "Ativo" : "Inativo")</span></div></div>
        <div class="cm25-hero-actions"><a class="btn" asp-action="Edit" asp-route-id="@Model.Id">Editar perfil</a><a class="btn secondary" asp-action="Index">Voltar</a></div>
    </header>
    <div class="cm25-detail-grid">
        <article class="cm25-detail-card"><header><span>IDENTIFICAÇÃO</span><h2>Dados do funcionário</h2></header><dl class="cm25-definition-grid"><div><dt>Nome</dt><dd>@Model.Nome</dd></div><div><dt>E-mail</dt><dd>@Model.Email</dd></div><div><dt>Cargo</dt><dd>@Model.Cargo</dd></div><div><dt>Situação</dt><dd>@(Model.Ativo ? "Acesso liberado" : "Acesso bloqueado")</dd></div><div><dt>Criado em</dt><dd>@ClinicaClock.ConverterUtc(Model.CriadoEm).ToString("dd/MM/yyyy HH:mm")</dd></div></dl></article>
        <aside class="cm25-detail-side"><div class="cm25-aside-card"><span>i</span><h2>Rastreabilidade</h2><p>Este cadastro é usado para identificar ações administrativas registradas pela auditoria.</p></div></aside>
    </div>
</section>
