@model Funcionario
@{
    ViewData["Title"]="Funcionário";
}
<div class="page-head">
    <h1>Detalhes do funcionário</h1>
</div>
<div class="details-card">
    <dl class="details-list">
        <dt>Nome</dt>
        <dd>@Model.Nome</dd>
        <dt>E-mail</dt>
        <dd>@Model.Email</dd>
        <dt>Cargo</dt>
        <dd>@Model.Cargo</dd>
        <dt>Ativo</dt>
        <dd>@(Model.Ativo ? "Sim" : "Não")</dd>
        <dt>Criado em</dt>
        <dd>@ClinicaClock.ConverterUtc(Model.CriadoEm).ToString("dd/MM/yyyy HH:mm")</dd>
    </dl>
    <div class="form-actions">
        <a class="btn" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
        <a class="btn secondary" asp-action="Index">Voltar</a>
    </div>
</div>
