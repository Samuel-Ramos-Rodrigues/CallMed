@model MKSANCrud.ViewModels.SolicitacoesPainelViewModel
@using MKSANCrud.Models
@using MKSANCrud.Models.Atendimento
@{
    ViewData["Title"] = "Solicitações de atendimento";
    string CanalNome(CanalAtendimento c) => c switch
    {
        CanalAtendimento.WhatsApp => "WhatsApp",
        CanalAtendimento.Sms => "SMS",
        CanalAtendimento.Email => "E-mail",
        CanalAtendimento.Telefone => "Telefone",
        CanalAtendimento.Presencial => "Presencial",
        _ => "Site/PWA"
    };
    string StatusNome(StatusSolicitacaoAtendimento s) => s switch
    {
        StatusSolicitacaoAtendimento.Nova => "Recebida",
        StatusSolicitacaoAtendimento.EmTriagem => "Recebida", // compatibilidade com solicitações legadas
        StatusSolicitacaoAtendimento.BuscandoHorario => "Escolhendo horário",
        StatusSolicitacaoAtendimento.AguardandoPaciente => "Aguardando paciente",
        StatusSolicitacaoAtendimento.Confirmada => "Consulta agendada",
        StatusSolicitacaoAtendimento.Cancelada => "Cancelada",
        _ => "Encerrada"
    };
    var colunas = new[]
    {
        StatusSolicitacaoAtendimento.Nova,
        StatusSolicitacaoAtendimento.BuscandoHorario,
        StatusSolicitacaoAtendimento.AguardandoPaciente,
        StatusSolicitacaoAtendimento.Confirmada
    };
}
<section class="cm25-screen cm21-request-page clinic-workflow-page" data-cm25-view="Solicitacoes/Index.cshtml">
    <header class="cm25-page-hero cm21-page-head">
        <div class="cm25-hero-mark" aria-hidden="true"><svg><use href="/icons/callmed-ui.svg#mail"></use></svg></div>
        <div><span class="cm25-kicker v16-eyebrow">CENTRAL DE ATENDIMENTO</span><h1>Solicitações recebidas</h1><p>Organize pedidos de qualquer canal e siga diretamente para a escolha de horário. A consulta é confirmada ao concluir o agendamento.</p></div>
        <a class="btn" asp-action="Create"><svg aria-hidden="true"><use href="/icons/callmed-ui.svg#plus"></use></svg> Nova solicitação</a>
    </header>

    <form method="get" class="cm25-filterbar cm21-filterbar clinic-filterbar">
        <label class="clinic-search"><svg aria-hidden="true"><use href="/icons/callmed-ui.svg#chat"></use></svg><input type="search" name="busca" value="@Model.Busca" placeholder="Paciente, CPF, telefone ou e-mail" /></label>
        <select name="canal" aria-label="Filtrar pelo canal">
            <option value="">Todos os canais</option>
            @foreach (var c in Enum.GetValues<CanalAtendimento>())
            {
                <option value="@c" selected="@(Model.Canal == c.ToString() ? "selected" : null)">@CanalNome(c)</option>
            }
        </select>
        <button class="btn secondary" type="submit"><svg aria-hidden="true"><use href="/icons/callmed-ui.svg#settings"></use></svg> Filtrar</button>
    </form>

    <div class="clinic-inline-actions"><a class="btn secondary" asp-action="Contingencia"><svg aria-hidden="true"><use href="/icons/callmed-ui.svg#clipboard"></use></svg> Pedidos recebidos offline</a><a class="text-link" href="/contingencia.html">Abrir formulário de contingência ↗</a></div>
    <div class="cm25-kpi-grid cm21-request-kpis clinic-request-kpis">
        <article><span class="clinic-kpi-icon received"><svg><use href="/icons/callmed-ui.svg#mail"></use></svg></span><small>Recebidas</small><strong>@Model.TotalRecebidas</strong><span class="clinic-kpi-foot">Aguardando organização</span></article>
        <article><span class="clinic-kpi-icon calendar"><svg><use href="/icons/callmed-ui.svg#calendar"></use></svg></span><small>Escolhendo horário</small><strong>@Model.TotalBuscando</strong><span class="clinic-kpi-foot">Dados já vinculados</span></article>
        <article><span class="clinic-kpi-icon waiting"><svg><use href="/icons/callmed-ui.svg#message-circle"></use></svg></span><small>Aguardando paciente</small><strong>@Model.TotalAguardando</strong><span class="clinic-kpi-foot">Retorno necessário</span></article>
        <article><span class="clinic-kpi-icon confirmed"><svg><use href="/icons/callmed-ui.svg#calendar-check"></use></svg></span><small>Consultas agendadas</small><strong>@Model.TotalConfirmadas</strong><span class="clinic-kpi-foot">Agendamento concluído</span></article>
    </div>

    <div class="cm21-kanban clinic-request-kanban">
        @foreach (var coluna in colunas)
        {
            var itens = Model.Itens.Where(x => coluna == StatusSolicitacaoAtendimento.Nova
                ? x.Status is StatusSolicitacaoAtendimento.Nova or StatusSolicitacaoAtendimento.EmTriagem
                : x.Status == coluna).ToList();
            <section class="cm21-kanban-column status-@coluna.ToString().ToLowerInvariant()">
                <header><div><span class="clinic-column-dot"></span><strong>@(coluna == StatusSolicitacaoAtendimento.Nova ? "Recebidas" : StatusNome(coluna))</strong></div><span>@itens.Count</span></header>
                <div class="cm21-kanban-list">
                    @if (itens.Count == 0)
                    {
                        <div class="cm21-kanban-empty"><svg aria-hidden="true"><use href="/icons/callmed-ui.svg#badge-check"></use></svg><span>Nenhuma solicitação nesta etapa.</span></div>
                    }
                    @foreach (var item in itens)
                    {
                        <article class="cm21-request-card clinic-request-card">
                            <div class="cm21-request-meta"><span class="cm21-channel">@CanalNome(item.Canal)</span><time>@ClinicaClock.ConverterUtc(item.CriadoEm).ToString("dd/MM HH:mm")</time></div>
                            <h2>@(item.Paciente?.Nome ?? item.NomeContato ?? "Contato não identificado")</h2>
                            <p>@(item.Especialidade?.Nome ?? "Especialidade a definir")</p>
                            @if (item.Consulta is not null)
                            {
                                <div class="cm21-success"><svg aria-hidden="true"><use href="/icons/callmed-ui.svg#calendar-check"></use></svg> Consulta #@item.Consulta.Id · @item.Consulta.Data.ToString("dd/MM") às @item.Consulta.Horario</div>
                            }
                            <div class="clinic-request-bottom"><span class="clinic-status-text">@StatusNome(item.Status)</span><a class="btn secondary" asp-action="Detalhes" asp-route-id="@item.Id">@(item.Consulta is null ? "Organizar agendamento" : "Ver solicitação") <span aria-hidden="true">→</span></a></div>
                            @if (item.ConversaAtendimentoId.HasValue)
                            {
                                <a class="clinic-conversation-link" asp-controller="Atendimento" asp-action="Index" asp-route-id="@item.ConversaAtendimentoId">Abrir conversa de origem ↗</a>
                            }
                        </article>
                    }
                </div>
            </section>
        }
    </div>

    @{ var encerradas = Model.Itens.Where(x => x.Status is StatusSolicitacaoAtendimento.Cancelada or StatusSolicitacaoAtendimento.Encerrada).Take(20).ToList(); }
    @if (encerradas.Any())
    {
        <details class="cm21-closed-list clinic-closed-list"><summary>Consultar canceladas/encerradas recentes (@encerradas.Count)</summary>
            @foreach (var item in encerradas)
            {
                <a asp-action="Detalhes" asp-route-id="@item.Id"><strong>#@item.Id · @(item.Paciente?.Nome ?? item.NomeContato)</strong><span>@StatusNome(item.Status) · @CanalNome(item.Canal)</span></a>
            }
        </details>
    }
</section>
