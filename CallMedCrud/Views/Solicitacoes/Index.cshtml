@model MKSANCrud.ViewModels.SolicitacoesPainelViewModel
@using MKSANCrud.Models
@using MKSANCrud.Models.Atendimento
@{
    ViewData["Title"] = "Solicitações e consultas";
    var abaConsultas = Model.Aba == "consultas";
    var pedidos = Model.PedidosAbertos;
    var historicoPedidos = Model.HistoricoPedidos;
    var consultas = Model.Consultas;
    var temFiltro = !string.IsNullOrWhiteSpace(Model.Busca) || !string.IsNullOrWhiteSpace(Model.Canal);
    var colunas = new[] { StatusSolicitacaoAtendimento.Nova, StatusSolicitacaoAtendimento.BuscandoHorario, StatusSolicitacaoAtendimento.AguardandoPaciente };
    string CanalNome(CanalAtendimento c) => c switch { CanalAtendimento.WhatsApp => "WhatsApp", CanalAtendimento.Sms => "SMS", CanalAtendimento.Email => "E-mail", CanalAtendimento.Telefone => "Telefone", CanalAtendimento.Presencial => "Presencial", _ => "Site/PWA" };
    string EtapaNome(StatusSolicitacaoAtendimento s) => s switch { StatusSolicitacaoAtendimento.Nova => "Novos pedidos", StatusSolicitacaoAtendimento.BuscandoHorario => "Definir horário", _ => "Aguardando resposta" };
    string EtapaAjuda(StatusSolicitacaoAtendimento s) => s switch { StatusSolicitacaoAtendimento.Nova => "Confira paciente, contato e especialidade.", StatusSolicitacaoAtendimento.BuscandoHorario => "Escolha uma vaga e conclua o agendamento.", _ => "Retome o pedido quando o paciente responder." };
    (string Valor, string Rotulo, int Total)[] filtrosConsulta =
    [
        ("todas", "Todas", consultas.Count), ("pendentes", "A confirmar", Model.Pendentes.Count),
        ("agendadas", "Agendadas", Model.ConsultasAgendadas.Count), ("realizadas", "Realizadas", Model.Realizadas.Count),
        ("historico", "Outros registros", Model.HistoricoConsultas.Count)
    ];
}
<section class="cm25-screen cm21-request-page cm-requests-screen cm-requests-organized" data-cm25-view="Solicitacoes/Index.cshtml" data-active-tab="@Model.Aba">
    <header class="cm-requests-hero">
        <div class="cm-requests-title"><span class="cm-requests-hero-icon" aria-hidden="true"><svg><use href="/icons/callmed-ui.svg#headset"></use></svg></span><div><span class="eyebrow">ADMINISTRAÇÃO E ATENDIMENTO</span><h1>Solicitações e consultas</h1><p>Organize os pedidos e acompanhe as consultas em suas respectivas abas.</p></div></div>
        <div class="cm-requests-hero-actions"><a class="btn" asp-action="Create"><svg aria-hidden="true"><use href="/icons/callmed-ui.svg#plus"></use></svg>Nova solicitação</a><a class="text-link" asp-controller="Consulta" asp-action="Create">Agendar consulta ↗</a></div>
    </header>
    <nav class="cm-requests-tabs" aria-label="Solicitações e consultas">
        <a class="@(!abaConsultas ? "active" : "")" aria-current="@(!abaConsultas ? "page" : null)" asp-action="Index" asp-route-aba="solicitacoes" asp-route-busca="@Model.Busca" asp-route-canal="@Model.Canal"><svg aria-hidden="true"><use href="/icons/callmed-ui.svg#mail"></use></svg><span>Solicitações</span><b>@pedidos.Count</b><small>Pedidos para organizar</small></a>
        <a class="@(abaConsultas ? "active" : "")" aria-current="@(abaConsultas ? "page" : null)" asp-action="Index" asp-route-aba="consultas" asp-route-busca="@Model.Busca" asp-route-canal="@Model.Canal"><svg aria-hidden="true"><use href="/icons/callmed-ui.svg#calendar"></use></svg><span>Consultas</span><b>@consultas.Count</b><small>Agendamentos e histórico</small></a>
    </nav>
    <section class="cm-requests-filter-panel" aria-labelledby="requests-filter-title">
        <div class="cm-requests-filter-heading"><h2 id="requests-filter-title">@(abaConsultas ? "Buscar consulta" : "Buscar solicitação")</h2><span>Paciente, contato ou canal de origem.</span></div>
        <form method="get" class="cm-requests-filters">
            <input type="hidden" name="aba" value="@Model.Aba" />
            @if (abaConsultas) { <input type="hidden" name="situacao" value="@Model.SituacaoConsulta" /> }
            <label class="cm-requests-search"><span class="visually-hidden">Buscar por paciente, CPF, telefone ou e-mail</span><svg aria-hidden="true"><use href="/icons/callmed-ui.svg#user"></use></svg><input type="search" name="busca" value="@Model.Busca" placeholder="Paciente, CPF, telefone ou e-mail" /></label>
            <label class="cm-requests-channel-filter"><span class="visually-hidden">Canal de origem</span><select name="canal"><option value="">Todos os canais</option>@foreach (var c in Enum.GetValues<CanalAtendimento>()) { <option value="@c" selected="@(Model.Canal == c.ToString() ? "selected" : null)">@CanalNome(c)</option> }<option value="SemCanal" selected="@(Model.Canal == "SemCanal" ? "selected" : null)">Canal não informado</option></select></label>
            <button class="btn secondary" type="submit">Buscar</button>
            @if (temFiltro) { <a class="text-link" asp-action="Index" asp-route-aba="@Model.Aba" asp-route-situacao="@Model.SituacaoConsulta">Limpar busca e canal</a> }
        </form>
        @if (temFiltro) { <p class="cm-requests-result-note">A busca e o canal estão aplicados aos resultados e às contagens das abas.</p> }
    </section>
    @if (!abaConsultas)
    {
        <section class="cm-request-workspace" aria-labelledby="requests-workspace-title">
            <div class="cm-requests-board-heading"><div><h2 id="requests-workspace-title">Pedidos antes do agendamento</h2><p>Ao concluir o agendamento, o atendimento passa para a aba Consultas.</p></div></div>
            @if (pedidos.Count == 0)
            {
                <div class="cm-requests-empty cm-requests-tab-empty"><svg aria-hidden="true"><use href="/icons/callmed-ui.svg#badge-check"></use></svg><div><h3>@(temFiltro ? "Nenhuma solicitação encontrada" : "Nenhum pedido para organizar")</h3><p>@(temFiltro ? "Altere a busca ou o canal para encontrar outro pedido." : "Os pedidos recebidos aparecerão aqui. As consultas já marcadas ficam na outra aba.")</p>
                    @if (consultas.Count > 0) { <a class="btn secondary" asp-action="Index" asp-route-aba="consultas" asp-route-busca="@Model.Busca" asp-route-canal="@Model.Canal">Ver consultas <span aria-hidden="true">→</span></a> }
                </div></div>
            }
            else
            {
                <div class="cm-requests-board">
                    @foreach (var coluna in colunas)
                    {
                        var itens = pedidos.Where(x => coluna == StatusSolicitacaoAtendimento.Nova ? x.Etapa is StatusSolicitacaoAtendimento.Nova or StatusSolicitacaoAtendimento.EmTriagem : x.Etapa == coluna).ToList();
                        <section class="cm-request-column status-@coluna.ToString().ToLowerInvariant()" aria-label="@EtapaNome(coluna)">
                            <header><div><span class="cm-request-column-dot" aria-hidden="true"></span><h3>@EtapaNome(coluna)</h3><span class="cm-request-column-count">@itens.Count</span></div><p>@EtapaAjuda(coluna)</p></header>
                            <div class="cm-request-list" tabindex="0" aria-label="@EtapaNome(coluna)">
                                @if (itens.Count == 0) { <p class="cm-request-stage-empty">Nenhum pedido nesta etapa.</p> }
                                @foreach (var item in itens) { <partial name="~/Views/Solicitacoes/_Card.cshtml" model="item" /> }
                            </div>
                        </section>
                    }
                </div>
            }
        </section>
        @if (historicoPedidos.Count > 0)
        {
            <details class="cm-requests-closed"><summary>Histórico de solicitações <span>@historicoPedidos.Count</span></summary><div>@foreach (var item in historicoPedidos) { <a asp-action="Detalhes" asp-route-id="@(item.Solicitacao!.Id)"><strong>Pedido #@(item.Solicitacao!.Id) · @item.NomePaciente</strong><span>@item.Situacao · @item.CanalNome<b aria-hidden="true">↗</b></span></a> }</div></details>
        }
        <details class="cm-requests-more">
            <summary>Mais opções</summary>
            <aside class="cm-requests-offline" aria-labelledby="requests-offline-title"><span class="cm-requests-offline-icon" aria-hidden="true"><svg><use href="/icons/callmed-ui.svg#clipboard"></use></svg></span><div><h2 id="requests-offline-title">Pedidos recebidos sem conexão</h2><p>Use durante uma falha de conexão. Depois, revise e envie os pedidos para continuar o agendamento.</p></div><a class="btn secondary" asp-action="Contingencia">Ver pedidos offline</a><a class="text-link" href="/contingencia.html">Registrar sem conexão ↗</a></aside>
        </details>
    }
    else
    {
        <section class="cm-consult-workspace" aria-labelledby="consult-workspace-title">
            <header class="cm-consult-workspace-head"><div><h2 id="consult-workspace-title">Consultas marcadas</h2><p>Acompanhe o estado de cada consulta ou confirme as que estão pendentes.</p></div><a class="text-link" asp-controller="Confirmacoes" asp-action="Index">Central de confirmações ↗</a></header>
            <nav class="cm-consult-status-filters" aria-label="Filtrar consultas por situação">
                @foreach (var filtro in filtrosConsulta)
                { <a class="@(Model.SituacaoConsulta == filtro.Valor ? "active" : "")" aria-current="@(Model.SituacaoConsulta == filtro.Valor ? "page" : null)" asp-action="Index" asp-route-aba="consultas" asp-route-situacao="@filtro.Valor" asp-route-busca="@Model.Busca" asp-route-canal="@Model.Canal">@filtro.Rotulo <b>@filtro.Total</b></a> }
            </nav>
            @if (Model.SituacaoConsulta == "pendentes")
            { <p class="cm-consult-context">Consultas pendentes ou remarcadas de hoje em diante. Confirme pelos botões abaixo ou pelo sino.</p> }
            else if (Model.SituacaoConsulta == "realizadas")
            { <p class="cm-consult-context">Atendimentos marcados como realizados no sistema.</p> }
            else if (Model.SituacaoConsulta == "historico")
            { <p class="cm-consult-context">Cancelamentos, ausências e pendências de datas anteriores a hoje.</p> }
            @if (Model.ConsultasFiltradas.Any(x => x.Consulta!.Data.Date < x.Hoje.Date && x.Consulta.Status == ConsultaStatus.Confirmada))
            { <p class="cm-consult-date-note"><svg aria-hidden="true"><use href="/icons/callmed-ui.svg#clock"></use></svg>Há consultas de datas anteriores ainda confirmadas. Abra a consulta para registrar se foi realizada, cancelada ou se houve ausência.</p> }
            <partial name="~/Views/Solicitacoes/_Consultas.cshtml" model="Model" />
        </section>
    }
</section>
