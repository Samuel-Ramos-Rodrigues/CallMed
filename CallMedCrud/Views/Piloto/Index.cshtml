@model MKSANCrud.Services.Clinica.ComparacaoPiloto
@using MKSANCrud.Models
@{ViewData["Title"]="Comparação antes e depois";string P(double? x)=>x.HasValue?x.Value.ToString("0.0")+"%":"Sem amostra";string N(decimal? x)=>x?.ToString("0.00")??"Sem amostra";string D(double? x)=>x.HasValue?x.Value.ToString("+0.0;-0.0;0.0")+" p.p.":"Sem comparação";string V(decimal? x)=>x?.ToString("+0.00;-0.00;0.00")??"Sem comparação";}


<section class="jornada cm-workspace" id="piloto-comparacao"><header><div class="cm-page-intro"><span class="cm-intro-icon" aria-hidden="true"><svg><use href="/icons/callmed-ui.svg#chart"></use></svg></span><div><span class="eyebrow">MEDIÇÃO DE RESULTADOS</span><h1>Comparação antes e depois</h1><p>Compare os indicadores antes e depois, com a origem dos dados registrada.</p></div></div><p>Medições conferidas da clínica. A comparação é descritiva: diferenças de público, duração das sessões, profissionais e dias da semana também influenciam os resultados.</p><div class="j-actions"><a asp-action="Medicao" class="btn">Registrar medição</a><a asp-controller="Operacao" asp-action="Index">Ver indicadores e rotinas</a></div></header>
<div asp-validation-summary="All" role="alert"></div>
<form method="get" class="j-form">
 <fieldset><legend>Antes — linha de base</legend><label>Primeiro dia da linha de base<input type="date" name="antesInicio" value="@(Model?.Antes.Inicio.ToString("yyyy-MM-dd")??Context.Request.Query["antesInicio"].ToString())" required/></label><label>Último dia da linha de base<input type="date" name="antesFim" value="@(Model?.Antes.Fim.ToString("yyyy-MM-dd")??Context.Request.Query["antesFim"].ToString())" required/></label></fieldset>
 <fieldset><legend>Piloto — uso da CallMed</legend><label>Primeiro dia do piloto<input type="date" name="pilotoInicio" value="@(Model?.Piloto.Inicio.ToString("yyyy-MM-dd")??Context.Request.Query["pilotoInicio"].ToString())" required/></label><label>Último dia do piloto<input type="date" name="pilotoFim" value="@(Model?.Piloto.Fim.ToString("yyyy-MM-dd")??Context.Request.Query["pilotoFim"].ToString())" required/></label></fieldset>
 <p>Use dias encerrados e períodos comparáveis, com a linha de base terminando antes do piloto. Cada período aceita até 366 dias.</p>
 <button type="submit" class="btn">Comparar períodos</button><button type="submit" name="exportar" value="true" class="btn secondary">Baixar comparação e fontes (JSON)</button>
</form>
@if(Model!=null){
 <h2>Cobertura das medições</h2>
 <div class="j-grid">@foreach(var par in new[]{("Antes",Model.Antes),("Piloto",Model.Piloto)}){var r=par.Item2;<article class="j-card"><h3>@par.Item1 · @r.Inicio.ToString("dd/MM/yyyy") a @r.Fim.ToString("dd/MM/yyyy")</h3><p><strong>@r.DiasMedidos de @r.DiasEsperados dias com medição</strong> · @(r.DiasEsperados-r.DiasMedidos) dias sem dados.</p><p>@r.Realizadas realizadas · @r.Faltas faltas · @r.Canceladas canceladas · @r.SemDesfecho sem desfecho</p><p>Ocupação: @r.DiasOcupacao dias com minutos agendados e capacidade conhecida (@r.MinutosAgendados / @r.MinutosDisponiveis min).</p><p>Recepção: @r.DiasRecepcao dias medidos (@r.MinutosRecepcao min / @r.ConsultasRecepcao agendamentos). Custo: @r.DiasCusto dias com tempo e custo/h conhecidos (@N(r.CustoRecepcao) reais / @r.ConsultasCusto agendamentos).</p></article>}</div>
 @if(Model.Antes.DiasMedidos<Model.Antes.DiasEsperados||Model.Piloto.DiasMedidos<Model.Piloto.DiasEsperados){<p class="j-etapa" role="status">Comparação parcial: há dias sem medição. Resultados usam apenas os dias registrados e as amostras indicadas. Não interprete dias ausentes como zero.</p>}
 <div class="table-wrap" tabindex="0" role="region" aria-label="Indicadores antes e depois, com rolagem horizontal"><table><caption>Diferença = Piloto menos Antes. p.p. significa pontos percentuais.</caption><thead><tr><th scope="col">Indicador</th><th scope="col">Antes</th><th scope="col">Piloto</th><th scope="col">Diferença</th></tr></thead><tbody>
 <tr><th scope="row">Taxa de faltas</th><td>@P(Model.Antes.TaxaFaltas)</td><td>@P(Model.Piloto.TaxaFaltas)</td><td>@D(Model.DiferencaFaltasPp)</td></tr>
 <tr><th scope="row">Ocupação da agenda</th><td>@P(Model.Antes.Ocupacao)</td><td>@P(Model.Piloto.Ocupacao)</td><td>@D(Model.DiferencaOcupacaoPp)</td></tr>
 <tr><th scope="row">Recepção: minutos por agendamento</th><td>@N(Model.Antes.MinutosPorConsulta)</td><td>@N(Model.Piloto.MinutosPorConsulta)</td><td>@V(Model.DiferencaMinutosPorConsulta) min</td></tr>
 <tr><th scope="row">Recepção: reais por agendamento</th><td>@N(Model.Antes.CustoPorConsulta)</td><td>@N(Model.Piloto.CustoPorConsulta)</td><td>@V(Model.DiferencaCustoPorConsulta) reais</td></tr>
 </tbody></table></div>
 <details><summary>Como interpretar os indicadores</summary><p>Faltas = ausentes / (realizadas + ausentes). Canceladas e sem desfecho ficam fora desse denominador. Confira a quantidade sem desfecho antes de concluir.</p><p>Ocupação = minutos agendados não cancelados / minutos de capacidade profissional disponível. Inclui faltas e consultas sem desfecho; mede uso da agenda, não atendimento efetivo. Acima de 100% indica excesso de agendamento. Sem capacidade medida não há taxa.</p><p>Tempo e custo da recepção por agendamento usam apenas os dias com esses dados, divididos por todas as consultas do mesmo conjunto de dias, incluindo canceladas. São médias ponderadas, calculadas pelos totais, e não médias das taxas diárias. O custo é tempo × custo/hora ÷ 60. Uma diferença negativa indica menor tempo ou custo por agendamento; não comprova economia causada pelo sistema.</p><p>Registre todos os dias do período, inclusive dias fechados com valores zero conferidos, ou escolha períodos que correspondam aos dias estudados. Use o mesmo escopo e método. Medições antigas de “consultas previstas” não são convertidas automaticamente.</p></details>
 <h2>Fontes consideradas</h2>
 @if(((MedicaoPiloto[])ViewBag.Medicoes).Length==0){<p>Sem medições conferidas nesses períodos. Registre os dados reais da clínica para iniciar a comparação.</p>}
 @foreach(var m in (MedicaoPiloto[])ViewBag.Medicoes){<article class="j-card"><h3>@m.Data.ToString("dd/MM/yyyy") · @m.Periodo · revisão @m.Revisao</h3><p>@m.Fonte</p><p>@m.Motivo</p><a asp-action="Medicao" asp-route-data="@m.Data.ToString("yyyy-MM-dd")" asp-route-periodo="@m.Periodo">Conferir este dia e o histórico</a></article>}
}
</section>
