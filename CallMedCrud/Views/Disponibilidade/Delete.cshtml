@model Disponibilidade
@{ ViewData["Title"] = "Excluir horário excepcional"; }
<section class="cm25-screen cm25-page cm25-confirm-page" data-cm25-view="Disponibilidade/Delete.cshtml"><header class="cm25-page-hero"><div class="cm25-hero-mark danger"><svg><use href="/icons/callmed-ui.svg#flag"></use></svg></div><div class="cm25-hero-copy"><span class="cm25-kicker">AGENDA · AÇÃO CRÍTICA</span><h1>Excluir horário excepcional</h1><p>Confirme a remoção desse registro específico da agenda.</p></div></header><div class="cm25-confirm-card"><div class="cm25-confirm-icon">!</div><h2>Excluir este horário?</h2><p><strong>@Model.Medico?.Nome</strong><br/>@(Model.Data?.ToString("dd/MM/yyyy") ?? "Data não definida") às @Model.Horario</p><form asp-action="Delete" method="post"><input type="hidden" asp-for="Id"/><div class="cm25-actions"><a class="btn secondary" asp-action="Index">Cancelar</a><button type="submit" class="btn danger">Excluir horário</button></div></form></div></section>
