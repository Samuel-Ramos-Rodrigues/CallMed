@model Disponibilidade
@{ ViewData["Title"] = "Editar horário excepcional"; }
<section class="cm25-screen cm25-page" data-cm25-view="Disponibilidade/Edit.cshtml"><header class="cm25-page-hero"><div class="cm25-hero-mark"><svg><use href="/icons/callmed-ui.svg#flag"></use></svg></div><div class="cm25-hero-copy"><span class="cm25-kicker">AGENDA · EXCEÇÃO</span><h1>Editar horário excepcional</h1><p>Atualize o profissional, a data, o horário ou a situação da vaga.</p></div><div class="cm25-hero-actions"><a class="btn secondary" asp-action="Details" asp-route-id="@Model.Id">Ver detalhes</a></div></header><form asp-action="Edit" method="post" class="cm25-form-layout"><input type="hidden" asp-for="Id"/><div class="cm25-form-main cm25-form-card"><partial name="_Form" model="Model" /></div><aside class="cm25-form-aside"><div class="cm25-aside-card"><span>i</span><h2>Ajuste pontual</h2><p>Use esta tela para um horário isolado. Para rotina semanal, edite a agenda do médico.</p></div></aside><div class="cm25-sticky-actions"><span>O calendário será recalculado depois de salvar.</span><div><a class="btn secondary" asp-action="Index">Cancelar</a><button class="btn" type="submit">Salvar alterações</button></div></div></form></section>
