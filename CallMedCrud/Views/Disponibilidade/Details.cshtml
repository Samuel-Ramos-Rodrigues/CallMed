@model Disponibilidade
@{
    ViewData["Title"]="Horário excepcional";
}
<div class="page-head">
    <h1>Detalhes do horário excepcional</h1>
</div>
<div class="details-card">
    <dl class="details-list">
        <dt>Médico</dt>
        <dd>@Model.Medico?.Nome</dd>
        <dt>Data</dt>
        <dd>@(Model.Data?.ToString("dd/MM/yyyy") ?? "Data não definida")</dd>
        <dt>Horário</dt>
        <dd>@Model.Horario</dd>
        <dt>Ativo</dt>
        <dd>@(Model.Ativo ? "Sim" : "Não")</dd>
    </dl>
    <div class="form-actions">
        <a class="btn" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
        <a class="btn secondary" asp-action="Index">Voltar</a>
    </div>
</div>
