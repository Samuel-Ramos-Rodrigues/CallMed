@model Disponibilidade
@{ ViewData["Title"] = "Horário excepcional"; }
<section class="cm25-screen cm25-page" data-cm25-view="Disponibilidade/Details.cshtml">
    <header class="cm25-profile-hero"><div class="cm25-profile-avatar"><svg aria-hidden="true"><use href="/icons/callmed-ui.svg#flag"></use></svg></div><div><span class="cm25-kicker">AGENDA · EXCEÇÃO</span><h1>@Model.Medico?.Nome</h1><p>@(Model.Data?.ToString("dd/MM/yyyy") ?? "Data não definida") · @Model.Horario</p><div class="cm25-inline-pills"><span class="status-dot-pill @(Model.Ativo ? "active" : "inactive")"><i></i>@(Model.Ativo ? "Ativo" : "Inativo")</span></div></div><div class="cm25-hero-actions"><a class="btn" asp-action="Edit" asp-route-id="@Model.Id">Editar</a><a class="btn secondary" asp-action="Index">Voltar</a></div></header>
    <div class="cm25-detail-grid"><article class="cm25-detail-card"><header><span>RESUMO</span><h2>Dados do horário excepcional</h2></header><dl class="cm25-definition-grid"><div><dt>Médico</dt><dd>@Model.Medico?.Nome</dd></div><div><dt>Data</dt><dd>@(Model.Data?.ToString("dd/MM/yyyy") ?? "Não definida")</dd></div><div><dt>Horário</dt><dd>@Model.Horario</dd></div><div><dt>Situação</dt><dd>@(Model.Ativo ? "Ativo" : "Inativo")</dd></div></dl></article><aside class="cm25-detail-side"><div class="cm25-aside-card"><span>i</span><h2>Agenda</h2><p>Horários excepcionais complementam a configuração regular do médico.</p></div></aside></div>
</section>
