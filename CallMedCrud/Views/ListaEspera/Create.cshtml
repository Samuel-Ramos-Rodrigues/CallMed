@model MKSANCrud.ViewModels.ListaEsperaFormViewModel
@{ ViewData["Title"] = "Entrar na lista de espera"; }
<section class="v16-page form-page-v16"><div class="v16-page-head compact-head"><div><span class="v16-eyebrow">LISTA DE ESPERA</span><h1>Encontrar uma vaga para mim</h1><p>Defina suas preferências. A CallMed monitora a agenda e avisa quando surgir uma opção compatível.</p></div><a class="btn secondary" asp-action="Index">Voltar</a></div>
<form asp-action="Create" method="post" class="v16-card form-card v16-main-form"><div asp-validation-summary="All" class="validation"></div><div class="form-grid v16-form-grid">
@if(!User.IsInRole("Paciente")){<div class="field full"><label asp-for="PacienteId">Paciente</label><select asp-for="PacienteId" asp-items="ViewBag.Pacientes"><option value="">Selecione...</option></select></div>}
<div class="field"><label asp-for="MedicoId">Médico específico <small>(opcional)</small></label><select asp-for="MedicoId" asp-items="ViewBag.Medicos"><option value="">Qualquer médico</option></select></div><div class="field"><label asp-for="EspecialidadeId"></label><select asp-for="EspecialidadeId" asp-items="ViewBag.Especialidades"><option value="">Selecione...</option></select></div><div class="field"><label asp-for="DataPreferida"></label><input asp-for="DataPreferida" type="date"/><small class="field-help">Deixe vazio para procurar nos próximos 90 dias.</small></div><div class="field"><label asp-for="Periodo"></label><select asp-for="Periodo"><option>Qualquer</option><option>Manhã</option><option>Tarde</option><option>Noite</option></select></div><div class="field full"><label asp-for="Observacao"></label><textarea asp-for="Observacao" rows="3" placeholder="Ex.: prefiro depois das 15h"></textarea></div></div><div class="form-actions"><button class="btn" type="submit">Entrar na lista</button><a class="btn secondary" asp-action="Index">Cancelar</a></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }
