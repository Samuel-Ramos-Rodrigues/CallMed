@model IEnumerable<MKSANCrud.Models.ListaEspera>
@inject MKSANCrud.Services.Clinica.IClinicaClock Clock
@{
    ViewData["Title"] = "Lista de espera";
    var lista = Model.ToList();
    var ativas = lista.Count(x => x.Ativa);
    var ofertas = ViewBag.OfertasAtivas as IDictionary<int, MKSANCrud.Models.Oferta>
        ?? new Dictionary<int, MKSANCrud.Models.Oferta>();
}
<section class="cm25-screen cm25-page v16-page" data-cm25-view="ListaEspera/Index.cshtml">
    <div class="cm25-page-hero v16-page-head"><div class="cm25-hero-mark" aria-hidden="true"><svg><use href="/icons/callmed-ui.svg#clock"></use></svg></div>
        <div>
            <span class="cm25-kicker v16-eyebrow">VAGAS INTELIGENTES</span>
            <h1>Lista de espera</h1>
            <p>A CallMed acompanha vagas reais e avisa pelo canal preferido. Se o canal digital não estiver disponível, a equipe pode receber uma tarefa para contato telefônico.</p>
        </div>
        <a class="btn" asp-action="Create">+ Entrar na lista</a>
    </div>

    <div class="cm25-kpi-grid agenda-summary">
        <div class="cm25-kpi v16-stat"><span>Pedidos</span><strong>@lista.Count</strong><small>total exibido</small></div>
        <div class="cm25-kpi v16-stat"><span>Ativos</span><strong>@ativas</strong><small>aguardando vaga</small></div>
        <div class="cm25-kpi v16-stat"><span>Encerrados</span><strong>@(lista.Count - ativas)</strong><small>concluídos/cancelados</small></div>
        <div class="cm25-kpi v16-stat"><span>Automação</span><strong class="stat-date">Automática</strong><small>busca contínua e ofertas com prazo</small></div>
    </div>

    <div class="cm25-panel v16-card table-card">
        @if (!lista.Any())
        {
            <div class="v16-empty">
                <span>◷</span>
                <strong>Nenhum pedido na lista de espera.</strong>
                <p>Crie uma preferência para receber aviso quando surgir uma vaga compatível.</p>
            </div>
        }
        else
        {
            <div class="table-scroll" tabindex="0" aria-label="Tabela com rolagem horizontal">
                <table class="v16-table">
                    <thead>
                        <tr><th>Paciente</th><th>Preferência</th><th>Data</th><th>Período</th><th>Situação</th><th>Último aviso</th><th>Ação</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var item in lista)
                    {
                        ofertas.TryGetValue(item.Id, out var oferta);
                        <tr>
                            <td><strong>@item.Paciente?.Nome</strong></td>
                            <td>@(item.Medico?.Nome ?? item.Especialidade?.Nome ?? "—")</td>
                            <td>@(item.DataPreferida?.ToString("dd/MM/yyyy") ?? "Próximos 90 dias")</td>
                            <td><span class="soft-pill">@item.Periodo</span></td>
                            <td>
                                @if (item.Ativa && oferta is not null)
                                {
                                    <span class="status-dot-pill active"><i></i>Vaga encontrada</span>
                                    <small class="cm21-wait-offer">@oferta.Data.ToString("dd/MM") às @oferta.Horario · aceite até @Clock.ConverterUtc(oferta.ExpiraEm).ToString("HH:mm")</small>
                                }
                                else
                                {
                                    <span class="status-dot-pill @(item.Ativa ? "active" : "inactive")"><i></i>@(item.Ativa ? "Aguardando" : "Encerrada")</span>
                                }
                            </td>
                            <td>@(item.NotificadoEm.HasValue ? Clock.ConverterUtc(item.NotificadoEm.Value).ToString("dd/MM HH:mm") : "—")</td>
                            <td>
                                @if (item.Ativa && oferta is not null && User.IsInRole("Paciente"))
                                {
                                    <form asp-action="AceitarVaga" method="post" class="cm21-inline-form">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button class="btn small" type="submit">Aceitar vaga</button>
                                    </form>
                                }
                                @if (item.Ativa)
                                {
                                    <form asp-action="Cancelar" method="post" class="cm21-inline-form" data-cm-confirm="Sair desta lista de espera?" data-cm-confirm-title="Sair da lista de espera" data-cm-confirm-accept="Sair da lista" data-cm-confirm-tone="danger">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button class="btn-link-clean danger-link" type="submit">Cancelar</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

<p><a class="btn secondary" asp-controller="Jornada" asp-action="Index" asp-fragment="ofertas">Ver ofertas com prazo de aceite</a></p>
@if(User.IsInRole("Funcionario")||User.IsInRole("Admin")){<details><summary>Prioridade dos pedidos ativos</summary>@foreach(var pedido in Model.Where(x=>x.Ativa)){<form asp-controller="Jornada" asp-action="Prioridade" method="post"><input name="id" value="@pedido.Id" type="hidden"/><label>Pedido #@pedido.Id · @pedido.Paciente?.Nome — prioridade administrativa (0 a 10)<input type="number" name="prioridade" min="0" max="10" value="@pedido.Prioridade" required/></label><button class="btn secondary" type="submit">Salvar prioridade</button></form>}</details>}
