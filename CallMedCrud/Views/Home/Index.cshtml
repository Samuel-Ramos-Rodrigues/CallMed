@model MKSANCrud.ViewModels.HomeViewModel
@{
    Layout = Model.Autenticado ? "_Layout" : "_PublicLayout";
    ViewData["Title"] = Model.Autenticado ? "Meu início" : "Sua saúde, mais perto";
    var proxima = Model.ProximasConsultas.FirstOrDefault();
    string StatusPedido(MKSANCrud.Models.StatusSolicitacaoAtendimento status) => status switch
    {
        MKSANCrud.Models.StatusSolicitacaoAtendimento.Nova => "Recebida",
        MKSANCrud.Models.StatusSolicitacaoAtendimento.EmTriagem => "Em triagem",
        MKSANCrud.Models.StatusSolicitacaoAtendimento.BuscandoHorario => "Buscando horário",
        MKSANCrud.Models.StatusSolicitacaoAtendimento.AguardandoPaciente => "Aguardando sua resposta",
        MKSANCrud.Models.StatusSolicitacaoAtendimento.Confirmada => "Consulta marcada",
        MKSANCrud.Models.StatusSolicitacaoAtendimento.Cancelada => "Cancelada",
        _ => "Encerrada"
    };
}
@if (Model.Autenticado)
{
    <section class="patient-home">
        <section class="cm21-simple-home" aria-label="Modo simplificado"><h1>Olá, @Model.NomePaciente!</h1><p>O que você deseja fazer?</p><div class="cm21-simple-actions"><a asp-controller="Consulta" asp-action="Create">Marcar consulta</a><a asp-controller="Consulta" asp-action="Index">Minhas consultas</a><button type="button" data-open-callmed-ai>Falar com atendimento</button><a asp-controller="ListaEspera" asp-action="Index">Lista de espera</a></div><button type="button" class="btn secondary" data-a11y-toggle="simple">Sair do modo fácil</button></section>
        <div class="patient-standard">
            <header class="workspace-heading"><div><span class="eyebrow">SEU ESPAÇO DE CUIDADO</span><h1>Olá, @Model.NomePaciente<span class="heading-dot">.</span></h1><p>Vamos cuidar do seu próximo passo?</p></div><button type="button" class="btn secondary" data-a11y-toggle="simple">Aa · Modo fácil</button></header>
            <div class="patient-overview">
                <section class="patient-appointment"><span class="eyebrow">SUA PRÓXIMA CONSULTA</span>
                @if (proxima is not null)
                {
                    <div class="patient-appointment-body"><div class="appointment-date"><strong>@proxima.Data.ToString("dd")</strong><span>@proxima.Data.ToString("MMMM")</span></div><div><span class="status-pill status-@proxima.Status.ToLowerInvariant()">@proxima.Status</span><h2>@proxima.Medico?.Nome</h2><p>@proxima.Medico?.Especialidade</p><strong>@proxima.Data.ToString("dddd") · @proxima.Horario</strong></div></div>
                    <a class="btn light" asp-controller="Consulta" asp-action="Details" asp-route-id="@proxima.Id">Ver detalhes e orientações <span aria-hidden="true">↗</span></a>
                }
                else
                {
                    <h2>Um horário<br />para cuidar de você.</h2><p>Escolha a especialidade e encontre uma vaga disponível.</p><a class="btn light" asp-controller="Consulta" asp-action="Create">Marcar minha consulta <span aria-hidden="true">↗</span></a>
                }
                </section>
                <nav class="patient-quicklinks" aria-label="Seu atendimento"><a asp-controller="Consulta" asp-action="Create"><svg aria-hidden="true"><use href="/icons/callmed-ui.svg#plus"></use></svg><span><strong>Marcar uma consulta</strong><small>Encontre um horário para você</small></span><b aria-hidden="true">↗</b></a><a asp-controller="Consulta" asp-action="Index"><svg aria-hidden="true"><use href="/icons/callmed-ui.svg#calendar"></use></svg><span><strong>Minhas consultas</strong><small>Acompanhe sua agenda</small></span><b aria-hidden="true">↗</b></a><a asp-controller="HistoricoExames" asp-action="Index"><svg aria-hidden="true"><use href="/icons/callmed-ui.svg#check"></use></svg><span><strong>Meus exames</strong><small>Consulte seu histórico</small></span><b aria-hidden="true">↗</b></a><button type="button" data-open-callmed-ai><svg aria-hidden="true"><use href="/icons/callmed-ui.svg#chat"></use></svg><span><strong>Preciso de ajuda</strong><small>Converse com o atendimento</small></span><b aria-hidden="true">↗</b></button></nav>
            </div>
            <div class="patient-details-grid"><section class="panel"><header class="panel-heading"><div><span class="eyebrow">ACOMPANHAMENTO</span><h2>Seus pedidos</h2></div></header>
                @if (Model.SolicitacoesRecentes.Any())
                {
                    @foreach(var pedido in Model.SolicitacoesRecentes.Take(4))
                    {
                        <div class="request-row"><span class="request-dot"></span><div><strong>@(pedido.Especialidade?.Nome ?? "Solicitação de consulta")</strong><small>@ClinicaClock.ConverterUtc(pedido.CriadoEm).ToString("dd/MM · HH:mm")</small></div><span class="soft-pill">@StatusPedido(pedido.Status)</span></div>
                    }
                }
                else { <div class="empty-state compact"><h3>Tudo tranquilo por aqui.</h3><p>O andamento das suas solicitações aparecerá neste espaço.</p></div> }
            </section><section class="patient-support"><span class="eyebrow">DO SEU JEITO</span><h2>Seu atendimento,<br />suas preferências.</h2><p>Convênio: <strong>@Model.Convenio</strong></p><a class="text-link" asp-controller="MinhaConta" asp-action="Index">Conferir meus dados ↗</a><hr /><a class="text-link" asp-controller="ListaEspera" asp-action="Index">Acompanhar lista de espera ↗</a></section></div>
            @if (Model.ProximasConsultas.Skip(1).Any())
            {
                <section class="panel"><header class="panel-heading"><h2>Mais adiante na sua agenda</h2><a class="text-link" asp-controller="Consulta" asp-action="Index">Ver todas ↗</a></header>
                @foreach(var consulta in Model.ProximasConsultas.Skip(1).Take(3)) { <a class="request-row" asp-controller="Consulta" asp-action="Details" asp-route-id="@consulta.Id"><time>@consulta.Data.ToString("dd/MM")<small>@consulta.Horario</small></time><div><strong>@consulta.Medico?.Nome</strong><small>@consulta.Medico?.Especialidade</small></div><span aria-hidden="true">↗</span></a> }
                </section>
            }
        </div>
    </section>
}
else
{
    <section class="public-hero"><div class="public-hero-copy"><span class="eyebrow">MENOS DISTÂNCIA. MAIS CUIDADO.</span><h1>Sua saúde,<br /><em>mais perto.</em></h1><p>Marcar uma consulta pode ser simples. Encontre um horário, acompanhe sua agenda e conte com a clínica em cada etapa.</p><div class="public-actions"><a class="btn" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="/Consulta/Create">Quero marcar uma consulta <span aria-hidden="true">↗</span></a><a class="text-link" href="#como-funciona">Conhecer a CallMed ↓</a></div><div class="public-channel-note"><svg aria-hidden="true"><use href="/icons/callmed-ui.svg#chat"></use></svg><span>No site, pelo telefone ou na recepção.<br /><strong>O atendimento continua perto de você.</strong></span></div></div>
    <div class="care-illustration" aria-label="Da escolha do horário ao atendimento"><div class="care-orbit orbit-one"></div><div class="care-orbit orbit-two"></div><span class="care-plus" aria-hidden="true">+</span><div class="care-ticket"><span class="eyebrow">CADA ETAPA CONTA</span><h2>Um tempo<br />para você.</h2><div class="care-step"><span>01</span><strong>Escolha a especialidade</strong><svg aria-hidden="true"><use href="/icons/callmed-ui.svg#check"></use></svg></div><div class="care-step"><span>02</span><strong>Encontre seu horário</strong><svg aria-hidden="true"><use href="/icons/callmed-ui.svg#check"></use></svg></div><div class="care-step"><span>03</span><strong>Acompanhe sua consulta</strong><svg aria-hidden="true"><use href="/icons/callmed-ui.svg#check"></use></svg></div><small>CallMed · cuidado em conexão</small></div><span class="care-caption">SIMPLES PARA AGENDAR.<br />PRÓXIMO PARA CUIDAR.</span></div></section>
    <section class="public-how" id="como-funciona"><header><span class="eyebrow">COMECE POR AQUI</span><h2>Mais clareza.<br />Em cada passo.</h2></header><div class="public-how-item"><span>01 / ACESSO</span><h3>Seu espaço, sempre à mão.</h3><p>Crie sua conta de paciente e reúna seus dados e consultas em um só lugar.</p><a asp-area="Identity" asp-page="/Account/Register">Criar minha conta ↗</a></div><div class="public-how-item"><span>02 / AGENDA</span><h3>Um horário que funciona.</h3><p>Escolha entre as datas e os horários disponíveis para a especialidade desejada.</p><a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="/Consulta/Create">Encontrar um horário ↗</a></div><div class="public-how-item"><span>03 / ACOMPANHAMENTO</span><h3>Saiba o que vem depois.</h3><p>Veja as orientações, confirme sua presença e acompanhe o atendimento.</p><a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="/Consulta">Ver minhas consultas ↗</a></div></section>
    <section class="public-install"><div><span class="eyebrow">CALLMED NO SEU DIA</span><h2>Um toque.<br />E você já está perto.</h2><p>Adicione a CallMed à tela inicial ou continue acessando pelo navegador.</p></div><button type="button" class="btn light" data-pwa-install>Instalar aplicativo <svg aria-hidden="true"><use href="/icons/callmed-ui.svg#download"></use></svg></button></section>
}
