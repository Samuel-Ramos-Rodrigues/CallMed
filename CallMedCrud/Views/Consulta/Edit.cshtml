@model Consulta
@{ ViewData["Title"] = "Editar consulta"; }
<section class="cm25-screen cm25-page" data-cm25-view="Consulta/Edit.cshtml">
    <header class="cm25-page-hero"><div class="cm25-hero-mark" aria-hidden="true"><svg><use href="/icons/callmed-ui.svg#calendar"></use></svg></div><div class="cm25-hero-copy"><span class="cm25-kicker">CONSULTAS · EDIÇÃO</span><h1>Editar consulta</h1><p>Revise paciente, agenda e observações sem perder as validações de disponibilidade.</p></div><div class="cm25-hero-actions"><a class="btn secondary" asp-action="Details" asp-route-id="@Model.Id">Ver detalhes</a></div></header>
    <form asp-action="Edit" method="post" class="cm25-editor-shell"><input type="hidden" asp-for="Id"/><div class="cm25-form-card cm25-form-main"><partial name="_Form" model="Model" /></div><div class="cm25-sticky-actions"><span>A disponibilidade será validada novamente ao salvar.</span><div><a class="btn secondary" asp-action="Index">Cancelar</a><button class="btn" type="submit">Salvar alterações</button></div></div></form>
</section>
