@model Consulta
@{ ViewData["Title"] = "Agendar consulta"; }
<section class="cm19-booking-page">
    <header class="cm19-page-head booking-head">
        <div><span>AGENDAMENTO</span><h1>Agendar consulta</h1><p>Escolha especialidade, médico, data e horário. A CallMed mostra somente vagas disponíveis.</p></div>
        @if(User.IsInRole("Funcionario") || User.IsInRole("Admin")){<a class="btn secondary" asp-controller="Agenda" asp-action="Index">Ver agenda</a>}
    </header>
    <form asp-action="Create" method="post" class="cm19-booking-card cm19-card" id="cm19BookingForm">
        @if (ViewBag.SolicitacaoId is int solicitacaoId)
        {
            <input type="hidden" name="solicitacaoId" value="@solicitacaoId" />
            <div class="cm21-linked-request">Agendamento vinculado à solicitação <strong>#@solicitacaoId</strong>. Ao confirmar, o fluxo será atualizado automaticamente.</div>
        }
        <partial name="_Form" model="Model" />
        <div class="cm19-booking-actions"><a class="btn secondary" asp-action="Index">Cancelar</a><button class="btn" type="submit">Confirmar agendamento</button></div>
    </form>
</section>
