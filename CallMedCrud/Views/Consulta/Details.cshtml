@model Consulta
@{
    ViewData["Title"] = "Detalhes da consulta";
    var ehEquipe = User.IsInRole("Funcionario") || User.IsInRole("Admin");
    var hojeClinica = ViewBag.HojeClinica is DateTime h ? h.Date : DateTime.Today;
    var podeRemarcar = ConsultaStatus.PodeRemarcar(Model.Status);
    var podeCancelar = ConsultaStatus.PodeCancelar(Model.Status);
    var podeConfirmar = ConsultaStatus.PodeConfirmar(Model.Status);
    var podeRealizar = ConsultaStatus.PodeRealizar(Model.Status);
    var podeAusente = ConsultaStatus.PodeMarcarAusente(Model.Status) && Model.Data.Date <= hojeClinica;
}
<link rel="stylesheet" href="~/css/comprovante.css" asp-append-version="true" />
<section class="cm25-screen cm25-page v16-page comprovante-consulta" data-cm25-view="Consulta/Details.cshtml">
    <div class="cm25-page-hero v16-page-head compact-head"><div class="cm25-hero-mark" aria-hidden="true"><svg><use href="/icons/callmed-ui.svg#calendar"></use></svg></div><div><span class="cm25-kicker v16-eyebrow">CONSULTA #@Model.Id</span><h1>Detalhes da consulta</h1><p>@Model.Data.ToString("dddd, dd/MM/yyyy") às @Model.Horario.</p></div><span class="status-pill status-@Model.Status.ToLowerInvariant()">@Model.Status</span></div>
    <div class="consultation-detail-grid-v16">
        <section class="cm25-panel v16-card consultation-main-v16"><div class="v16-card-head"><div><h2>Atendimento</h2><p>Profissional e paciente.</p></div></div><div class="detail-info-stack"><div><span>Paciente</span><strong>@Model.Paciente?.Nome</strong></div><div><span>Médico</span><strong>@Model.Medico?.Nome</strong></div><div><span>Especialidade</span><strong>@Model.Medico?.Especialidade</strong></div><div><span>Data</span><strong>@Model.Data.ToString("dd/MM/yyyy")</strong></div><div><span>Horário</span><strong>@Model.Horario</strong></div></div></section>
        <section class="cm25-panel v16-card"><div class="v16-card-head"><div><h2>Financeiro e observações</h2></div></div><div class="detail-info-stack"><div><span>Pagamento</span><strong>@Model.TipoPagamento</strong></div><div><span>Convênio</span><strong>@(string.IsNullOrWhiteSpace(Model.ConvenioUsado) ? "—" : Model.ConvenioUsado)</strong></div><div><span>Observação</span><strong>@(string.IsNullOrWhiteSpace(Model.Observacao) ? "—" : Model.Observacao)</strong></div></div></section>
    </div>
    <partial name="_OrientacoesConsulta" model="Model" />
    <div class="cm25-sticky-actions v16-sticky-actions">
        <button class="btn secondary" type="button" onclick="window.print()">Imprimir comprovante</button>
        @if(podeConfirmar){<form asp-action="Confirmar" asp-route-id="@Model.Id" method="post"><button class="btn" type="submit">Confirmar presença</button></form>}
        @if(ehEquipe && podeRealizar){<form asp-action="Realizar" asp-route-id="@Model.Id" method="post"><button class="btn" type="submit">Marcar realizada</button></form>}
        @if(ehEquipe && podeAusente){<form asp-action="Ausente" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Confirmar ausência deste paciente?');"><button class="btn secondary" type="submit">Marcar ausência</button></form>}
        @if(podeRemarcar){<a class="btn secondary" asp-action="Remarcar" asp-route-id="@Model.Id">Remarcar</a>}
        @if(ehEquipe && podeRemarcar){<a class="btn secondary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>}
        @if(podeCancelar){<form asp-action="Cancelar" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Deseja cancelar esta consulta?');"><button class="btn danger" type="submit">Cancelar</button></form>}
        <a class="btn secondary" asp-action="Index">Voltar</a>
    </div>
<p><a class="btn secondary" asp-controller="HistoricoExames" asp-action="Index" asp-route-pacienteId="@Model.PacienteId">Histórico de exames realizados</a></p>
</section>
