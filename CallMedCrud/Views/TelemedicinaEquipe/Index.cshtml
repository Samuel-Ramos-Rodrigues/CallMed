@model IReadOnlyList<MKSANCrud.Controllers.FilaTelemedicinaLinha>
@{
    ViewData["Title"] = "Telemedicina";
}
@functions {
    static string Situacao(MKSANCrud.Controllers.FilaTelemedicinaLinha c) =>
        c.FimEm is not null ? "Encerrado" :
        c.InicioEm is not null ? "Em atendimento" :
        c.AdmitidoEm is not null ? "Admitido" :
        c.SalaEsperaEm is not null ? "Na sala de espera" : "Aguardando entrada";
}
<section>
    <h1>Telemedicina: fila de hoje</h1>

    @if (TempData["Erro"] is string erro)
    {
        <p role="alert">@erro</p>
    }
    @if (TempData["Sucesso"] is string sucesso)
    {
        <p role="status">@sucesso</p>
    }

    @if (Model.Count == 0)
    {
        <p>Nenhum atendimento online com consentimento para hoje.</p>
    }
    else
    {
        <table>
            <caption>Atendimentos online de hoje</caption>
            <thead>
                <tr>
                    <th scope="col">Horário</th>
                    <th scope="col">Paciente</th>
                    <th scope="col">Situação</th>
                    <th scope="col">Ação</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.Horario</td>
                        <td>@c.Paciente</td>
                        <td>@Situacao(c)</td>
                        <td>
                            @if (c.FimEm is null)
                            {
                                @if (c.SalaEsperaEm is not null && c.AdmitidoEm is null)
                                {
                                    <form asp-action="Admitir" asp-route-id="@c.Id" method="post">
                                        <button class="btn" type="submit">Admitir paciente</button>
                                    </form>
                                }
                                @if (c.AdmitidoEm is not null && c.InicioEm is null)
                                {
                                    <form asp-action="Iniciar" asp-route-id="@c.Id" method="post">
                                        <button class="btn" type="submit">Iniciar atendimento</button>
                                    </form>
                                }
                                @if (c.InicioEm is not null)
                                {
                                    <form asp-action="Encerrar" asp-route-id="@c.Id" method="post">
                                        <label for="registro-@c.Id">Registro do atendimento (cifrado)</label>
                                        <textarea id="registro-@c.Id" name="registro" rows="3" maxlength="4000"></textarea>
                                        <button class="btn" type="submit">Encerrar atendimento</button>
                                    </form>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
