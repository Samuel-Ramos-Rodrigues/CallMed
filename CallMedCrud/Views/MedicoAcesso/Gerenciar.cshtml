@model MKSANCrud.ViewModels.MedicoAcessoViewModel
@{ ViewData["Title"] = "Acesso do médico"; }
<section class="cm25-screen cm25-page" data-cm25-view="MedicoAcesso/Gerenciar.cshtml"><header class="cm25-page-hero"><div class="cm25-hero-mark"><svg><use href="/icons/callmed-ui.svg#shield"></use></svg></div><div class="cm25-hero-copy"><span class="cm25-kicker">MÉDICOS · CREDENCIAIS</span><h1>Acesso de @Model.MedicoNome</h1><p>@(Model.PossuiAcesso ? "Atualize o e-mail vinculado à conta médica." : "Crie as credenciais para liberar a área Minha Agenda.")</p></div><div class="cm25-hero-actions"><a class="btn secondary" asp-controller="Medico" asp-action="Details" asp-route-id="@Model.MedicoId">Voltar ao médico</a></div></header>
<form asp-action="Gerenciar" method="post" class="cm25-form-layout"><input type="hidden" asp-for="MedicoId"/><input type="hidden" asp-for="MedicoNome"/><input type="hidden" asp-for="PossuiAcesso"/><div class="cm25-form-main cm25-form-card"><div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid"><div class="field full"><label asp-for="Email">E-mail de acesso</label><input asp-for="Email" autocomplete="email" placeholder="medico@clinica.com"/><span asp-validation-for="Email" class="validation"></span></div>@if(!Model.PossuiAcesso){<div class="field full"><label asp-for="Senha">Senha inicial</label><input asp-for="Senha" autocomplete="new-password"/><span asp-validation-for="Senha" class="validation"></span><small class="field-help">Use uma senha inicial segura e oriente o médico a manter a credencial privada.</small></div>}else{<div class="alert success full">Este médico já possui acesso ativo. Salvar atualizará o e-mail vinculado.</div>}</div></div><aside class="cm25-form-aside"><div class="cm25-aside-card"><span>🔐</span><h2>Área médica</h2><p>O médico acessa somente sua agenda e ações previstas para o perfil profissional.</p></div></aside><div class="cm25-sticky-actions"><span>As permissões são validadas no servidor.</span><div><a class="btn secondary" asp-controller="Medico" asp-action="Details" asp-route-id="@Model.MedicoId">Cancelar</a><button class="btn" type="submit">Salvar acesso</button></div></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }
