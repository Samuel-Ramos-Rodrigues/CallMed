@model MKSANCrud.ViewModels.ConveniosRegrasViewModel
@using MKSANCrud.Models
@{
    var especialidades = ViewBag.Especialidades as IEnumerable<Especialidade> ?? Enumerable.Empty<Especialidade>();
}
<section class="cm21-rules-page">
    <header class="cm21-page-head"><div><span class="v16-eyebrow">REGRAS DE ELEGIBILIDADE</span><h1>Convênios × Especialidades</h1><p>A triagem usa esta matriz para reduzir conferências manuais e inconsistências.</p></div></header>
    <div class="cm21-rules-grid">
        <form asp-action="Salvar" method="post" class="cm21-form-card">
            <h2>Adicionar/atualizar regra</h2>
            <label><span>Convênio</span><input name="convenioNome" list="convenios-list" required placeholder="Ex.: Unimed" /></label>
            <datalist id="convenios-list">@foreach(var c in Model.ConveniosCadastrados){<option value="@c"></option>}</datalist>
            <label><span>Especialidade</span><select name="especialidadeId" required><option value="">Selecione</option>@foreach(var e in especialidades){<option value="@e.Id">@e.Nome</option>}</select></label>
            <label><span>Cobertura</span><select name="coberta"><option value="true">Coberta</option><option value="false">Não coberta</option></select></label>
            <label><span>Observação</span><textarea name="observacao" rows="3" placeholder="Regra, autorização, observação administrativa..."></textarea></label>
            <button class="btn" type="submit">Salvar regra</button>
        </form>
        <section class="cm21-rule-list">
            @if (!Model.Regras.Any()) { <div class="cm21-empty-state"><strong>Nenhuma matriz configurada.</strong><p>Sem matriz de cobertura, agendamentos por convênio ficam em triagem até a regra ser cadastrada ou uma liberação manual justificada ser registrada.</p></div> }
            @foreach(var grupo in Model.Regras.GroupBy(x=>x.ConvenioNome))
            {
                <article class="cm21-rule-group"><header><strong>@grupo.Key</strong><span>@grupo.Count() especialidade(s)</span></header>
                    @foreach(var item in grupo){<div><span>@item.Especialidade?.Nome</span><b class="@(item.Coberta?"ok":"no")">@(item.Coberta?"Coberta":"Não coberta")</b><small>@item.Observacao</small><form asp-action="Desativar" method="post"><input type="hidden" name="id" value="@item.Id"/><button type="submit">Remover</button></form></div>}
                </article>
            }
        </section>
    </div>
</section>
