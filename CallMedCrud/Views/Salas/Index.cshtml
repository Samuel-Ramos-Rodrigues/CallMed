@model SalasPainel
@using MKSANCrud.Services.Clinica
@inject IClinicaClock Clock
@{ViewData["Title"]=Model.Aba=="online" ? "Teleconsultas" : "Salas físicas";var data=Model.Data.ToString("yyyy-MM-dd");}
<section class="cm-salas" id="salas-painel" data-aba="@Model.Aba">
 <header class="cm-page-heading"><div><span class="eyebrow">@(Model.Aba=="online" ? "TELECONSULTAS · ATENDIMENTO DIGITAL" : "AGENDA · RECURSOS")</span><h1>@(Model.Aba=="online" ? "Teleconsultas" : "Salas de atendimento")</h1><p>@(Model.Aba=="online" ? "Acompanhe a presença dos participantes e o estado das consultas online do dia." : Model.Equipe ? "Organize os espaços físicos da clínica." : "Encontre as salas dos seus atendimentos.")</p></div><div class="cm-page-actions"><a class="btn secondary" asp-controller="@(Model.Equipe?"Agenda":"MedicoPainel")" asp-action="Index">Voltar à agenda</a>@if(Model.Equipe&&Model.Aba=="fisicas"){<a class="btn" href="#nova-sala">+ Cadastrar sala</a>}</div></header>
 <nav class="cm-section-tabs" aria-label="Tipo de sala"><a asp-action="Index" asp-route-data="@data" asp-route-aba="fisicas" asp-route-profissionalId="@Model.ProfissionalId" class="@(Model.Aba=="fisicas"?"active":"")" aria-current="@(Model.Aba=="fisicas"?"page":null)">Salas físicas</a><a asp-action="Index" asp-route-data="@data" asp-route-aba="online" asp-route-profissionalId="@Model.ProfissionalId" class="@(Model.Aba=="online"?"active":"")" aria-current="@(Model.Aba=="online"?"page":null)">Consultas online</a></nav>
 <form method="get" class="cm-filter-bar" id="salas-filtros"><input type="hidden" name="aba" value="@Model.Aba"/><label>Dia do atendimento<input type="date" name="data" value="@data" required/></label>@if(Model.Equipe){<label>Profissional<select name="profissionalId"><option value="">Todos os profissionais</option>@foreach(var p in Model.Profissionais){<option value="@p.Id" selected="@(p.Id==Model.ProfissionalId)">@p.Nome</option>}</select></label>}<button class="btn secondary" type="submit">Aplicar filtros</button><a asp-action="Index" asp-route-aba="@Model.Aba">Hoje</a></form>
 @if(Model.LimiteAtingido){<p class="alert warning" role="status">Exibindo até 500 consultas. Selecione um profissional para reduzir os resultados.</p>}
 @if(Model.Aba=="online"){
 <div class="cm-refresh-line"><p id="salas-status" role="status">Atualização automática a cada 10 segundos.</p><button type="button" class="btn secondary" id="salas-atualizar">Atualizar agora</button></div>
 <div data-salas-live>
  <div class="cm-summary-strip" aria-label="Resumo do dia"><div><span>Consultas online</span><strong>@Model.Online.Count</strong></div><div><span>Paciente na sala</span><strong>@Model.Online.Count(x=>x.PacientePresente)</strong></div><div><span>Em atendimento</span><strong>@Model.Online.Count(x=>x.Jornada?.InicioEm!=null&&x.Jornada.FimEm==null&&!JornadaService.Encerrada(x.Consulta))</strong></div></div>
  <p class="cm-muted">Cada sala pertence a uma consulta. A presença expira após 60 segundos sem atualização. A conexão é informada pelos dispositivos; áudio e vídeo não são gravados.</p>
  @if(Model.Online.Count==0){<div class="cm-empty-state"><h2>Nenhuma consulta online neste dia</h2><p>As consultas aparecem aqui quando a equipe define a modalidade online no agendamento.</p><a class="btn secondary" asp-controller="Jornada" asp-action="Index">Acompanhar consultas</a></div>}
  else{<div class="cm-online-list">@foreach(var l in Model.Online){var c=l.Consulta;var encerrada=JornadaService.Encerrada(c);
   <article class="cm-online-card" data-consulta="@c.Id"><div class="cm-online-time"><strong>@c.Horario</strong><span>@(l.Jornada?.Duracao??c.DuracaoMinutos) min</span></div><div class="cm-online-info"><h2>@c.Paciente?.Nome</h2><p>@c.Medico?.Nome</p><span class="cm-status-pill @(encerrada?"neutral":l.PacientePresente&&l.ProfissionalPresente?"success":"info")">@l.Estado</span></div>
   <dl class="cm-presence"><div><dt>Paciente</dt><dd><span class="cm-presence-dot @(l.PacientePresente?"present":"")" aria-hidden="true"></span>@(l.PacientePresente?"Na sala":"Sem presença recente")</dd></div><div><dt>Profissional</dt><dd><span class="cm-presence-dot @(l.ProfissionalPresente?"present":"")" aria-hidden="true"></span>@(l.ProfissionalPresente?"Na sala":"Sem presença recente")</dd></div><div class="cm-connection"><dt>Conexão</dt><dd>@l.Conexao</dd></div></dl>
   <div class="cm-online-actions">@if(!Model.Equipe&&!encerrada){<a class="btn" href="/Jornada/Tele/@c.Id">Entrar na sala</a>}<a class="btn secondary" asp-controller="Jornada" asp-action="Consulta" asp-route-id="@c.Id">Detalhes da consulta</a></div>
   <details class="cm-room-history" id="historico-tele-@c.Id"><summary>Entradas e saídas</summary>@if(l.Historico.Count==0){<p>Ainda não há entradas registradas.</p>}else{
    <p>Últimas 20 entradas, em horário de Brasília. Sem confirmação de saída, mostramos a última presença recebida.</p><div class="cm-table-scroll" tabindex="0" aria-label="Histórico de participantes da consulta às @c.Horario"><table><caption class="sr-only">Histórico da sala da consulta às @c.Horario</caption><thead><tr><th scope="col">Participante</th><th scope="col">Entrada</th><th scope="col">Saída ou última presença</th></tr></thead><tbody>@foreach(var s in l.Historico){<tr><td>@s.Papel</td><td>@Clock.ConverterUtc(s.EntradaEm).ToString("dd/MM HH:mm:ss")</td><td>@if(s.SaidaEm.HasValue){<span>@Clock.ConverterUtc(s.SaidaEm.Value).ToString("dd/MM HH:mm:ss") · @s.MotivoSaida</span>}else if(TeleconsultaPresencaService.Presente(s,c,DateTime.UtcNow)){<span>Presença ativa</span>}else{<span>@Clock.ConverterUtc(s.UltimoSinalEm).ToString("dd/MM HH:mm:ss") · sem confirmação de saída</span>}</td></tr>}</tbody></table></div>
   }</details></article>
  }</div>}
 </div>
 }else{
 <div class="cm-summary-strip" aria-label="Resumo das salas"><div><span>Salas ativas</span><strong>@Model.Salas.Count(x=>x.Sala.Ativa)</strong></div><div><span>Consultas sem sala</span><strong>@Model.SemSala.Count</strong></div><div><span>Bloqueios no dia</span><strong>@Model.Salas.Sum(x=>x.Bloqueios.Count)</strong></div></div>
 @if(Model.SemSala.Count>0){<details class="cm-room-unassigned"><summary>@Model.SemSala.Count consulta(s) presencial(is) aguardando definição de sala</summary><ul>@foreach(var l in Model.SemSala){<li><span><strong>@l.Consulta.Horario</strong> · @l.Consulta.Paciente?.Nome · @l.Consulta.Medico?.Nome</span><a asp-controller="Jornada" asp-action="Consulta" asp-route-id="@l.Consulta.Id">@(Model.Equipe?"Definir sala":"Ver consulta")</a></li>}</ul></details>}
 @if(Model.Salas.Count==0){<div class="cm-empty-state"><h2>Organize os espaços da clínica</h2><p>@(Model.Equipe?"Cadastre a primeira sala e associe as reservas às consultas.":"A equipe ainda não cadastrou salas físicas.")</p></div>}
 <div class="cm-rooms-grid">@foreach(var l in Model.Salas){var s=l.Sala;
  <article class="cm-room-card" id="sala-@s.Id"><header><div class="cm-room-icon" aria-hidden="true"><svg><use href="/icons/callmed-ui.svg#home"></use></svg></div><div><h2>@s.Nome</h2><p>@(string.IsNullOrWhiteSpace(s.Localizacao)?"Localização a informar":s.Localizacao)</p></div><span class="cm-status-pill @(l.Estado=="Livre agora"?"success":l.Estado=="Bloqueada"?"warning":"neutral")">@l.Estado</span></header>
  @if(!string.IsNullOrWhiteSpace(s.Recursos)){<p class="cm-room-resources"><strong>Recursos:</strong> @s.Recursos</p>}
  <div class="cm-room-schedule"><h3>Reservas · @Model.Data.ToString("dd/MM")</h3>@if(l.Reservas.Count==0){<p class="cm-muted">@(Model.Equipe?"Nenhuma reserva neste dia.":"Você não tem reservas nesta sala neste dia.")</p>}else{<ul>@foreach(var r in l.Reservas){<li><div><strong>@r.Consulta.Horario</strong><span>@r.Consulta.Paciente?.Nome</span><small>@r.Consulta.Medico?.Nome · @(JornadaService.Encerrada(r.Consulta)?r.Consulta.Status:$"{r.Jornada?.Duracao??r.Consulta.DuracaoMinutos} min")</small></div><a asp-controller="Jornada" asp-action="Consulta" asp-route-id="@r.Consulta.Id">@(Model.Equipe?"Organizar":"Detalhes")</a></li>}</ul>}</div>
  @foreach(var b in l.Bloqueios){<div class="cm-room-block"><strong>Bloqueio · @b.Inicio.ToString("dd/MM HH:mm") a @b.Fim.ToString("dd/MM HH:mm")</strong><p>@b.Motivo</p>@if(Model.Equipe){<form asp-action="Liberar" method="post"><input type="hidden" name="id" value="@b.Id"/><input type="hidden" name="data" value="@data"/><button class="btn secondary" type="submit">Liberar este bloqueio</button></form>}</div>}
  @if(Model.Equipe){
   <details class="cm-room-tools"><summary>Editar sala</summary><form asp-action="Salvar" method="post" class="cm-form-grid"><input type="hidden" name="id" value="@s.Id"/><input type="hidden" name="data" value="@data"/><label>Nome<input name="nome" value="@s.Nome" maxlength="80" required/></label><label>Localização<input name="localizacao" value="@s.Localizacao" maxlength="120"/></label><label>Recursos disponíveis<textarea name="recursos" maxlength="500" rows="2">@s.Recursos</textarea></label><label class="cm-checkbox-label"><input name="ativa" type="checkbox" value="true" checked="@s.Ativa"/> Ativa para novas reservas</label><button class="btn secondary" type="submit">Salvar alterações</button></form></details>
   @if(s.Ativa){<details class="cm-room-tools"><summary>Bloquear para manutenção ou uso interno</summary><form asp-action="Bloquear" method="post" class="cm-form-grid"><input type="hidden" name="salaId" value="@s.Id"/><input type="hidden" name="data" value="@data"/><label>Início<input name="inicio" type="datetime-local" required/></label><label>Fim<input name="fim" type="datetime-local" required/></label><label>Motivo<input name="motivo" maxlength="200" placeholder="Ex.: manutenção do ar-condicionado" required/></label><p class="cm-muted">Horário de Brasília. Transfira as reservas antes de bloquear a sala.</p><button class="btn secondary" type="submit">Registrar bloqueio</button></form></details>}
  }
  </article>
 }</div>
 @if(Model.Equipe){<section class="cm-room-create" id="nova-sala"><h2>Cadastrar sala física</h2><p>Informe os dados que ajudam a recepção a escolher o espaço adequado.</p><form asp-action="Salvar" method="post" class="cm-form-grid"><input type="hidden" name="ativa" value="true"/><input type="hidden" name="data" value="@data"/><label>Nome da sala<input name="nome" maxlength="80" placeholder="Ex.: Consultório 03" required/></label><label>Localização<input name="localizacao" maxlength="120" placeholder="Ex.: térreo, próximo à recepção"/></label><label>Recursos disponíveis<textarea name="recursos" maxlength="500" rows="2" placeholder="Ex.: acesso sem degraus, mesa e maca"></textarea></label><button class="btn" type="submit">Cadastrar sala</button></form></section>}
 }
</section>
<script src="~/js/salas.js" asp-append-version="true" defer></script>
