@model MKSANCrud.ViewModels.AuditoriaPageViewModel
<section class="cm21-audit-page">
    <header class="cm21-page-head"><div><span class="v16-eyebrow">RASTREABILIDADE</span><h1>Auditoria</h1><p>Quem fez, quando fez e em qual registro.</p></div></header>
    <form method="get" class="cm21-filterbar"><input name="busca" value="@Model.Busca" placeholder="Usuário, ação ou descrição"/><select name="entidade"><option value="">Todas as entidades</option>@foreach(var e in Model.Itens.Select(x=>x.Entidade).Distinct().OrderBy(x=>x)){<option value="@e" selected="@(Model.Entidade==e?"selected":null)">@e</option>}</select><button class="btn secondary">Filtrar</button></form>
    <div class="table-wrap cm21-audit-table"><table><thead><tr><th>Data</th><th>Usuário</th><th>Ação</th><th>Entidade</th><th>Descrição</th></tr></thead><tbody>@foreach(var x in Model.Itens){<tr><td>@ClinicaClock.ConverterUtc(x.CriadoEm).ToString("dd/MM/yyyy HH:mm:ss")</td><td>@(x.UsuarioNome??"Sistema")</td><td><strong>@x.Acao</strong></td><td>@x.Entidade #@x.EntidadeId</td><td>@x.Descricao</td></tr>}</tbody></table></div>
</section>
