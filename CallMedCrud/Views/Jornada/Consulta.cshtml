@model Consulta
@using MKSANCrud.Services.Clinica
@{ViewData["Title"]="Preparar e acompanhar consulta";var j=(Jornada)ViewBag.J;bool p=ViewBag.P;bool m=ViewBag.M;bool equipe=ViewBag.E;var encerrada=JornadaService.Encerrada(Model);}

<section class="jornada cm-workspace" id="j-detalhe" data-id="@Model.Id"><a asp-action="Index">← Voltar ao acompanhamento</a><header class="cm-journey-heading"><h1>Preparar consulta</h1><p><strong>@Model.Medico?.Nome</strong> · @Model.Medico?.RegistroExibicao · @Model.Data.ToString("dd/MM/yyyy") às @Model.Horario</p></header>@if(User.HasClaim(c=>c.Type=="clinical.consulta")){<aside class="j-card"><p>Este acesso temporário é restrito a esta sessão. Ao terminar, encerre o acesso neste navegador.</p><form asp-controller="ClinicalHandoff" asp-action="Encerrar" method="post"><button class="btn secondary" type="submit">Encerrar acesso temporário</button></form></aside>}<p class="j-etapa">@(encerrada?Model.Status:JornadaService.Etapa(j)) · @(j.Tele?"Teleconsulta":j.Sala?.Nome??"Sala a informar")</p>
@if(j.Tele&&!encerrada){<section class="j-card tele-resumo"><h2>Consulta online</h2><p>@(p?"Autorize o vídeo, confira o horário de abertura e entre na chamada em uma única página.":m?"Confira a autorização e entre na chamada com o paciente.":"O paciente autoriza e acessa o vídeo pela própria conta. O profissional responsável participa com a conta dele.")</p><p>A sala abre 30 minutos antes da consulta. Os dados e formulários abaixo podem ser preparados com antecedência.</p><a class="btn" href="/Jornada/Tele/@Model.Id">@(p||m?"Acessar consulta online":"Ver orientações de acesso")</a></section>}
@if(p&&!encerrada)
{
    <aside class="cm-journey-next" role="status"><span class="eyebrow">PRÓXIMO PASSO</span><strong>@(j.PresencaConfirmadaEm==null?"Confirme que pretende comparecer.":j.CadastroEm==null?"Confira seus dados de cadastro.":j.CheckInEm==null?"Faça o check-in nas 24 horas anteriores à consulta.":j.Tele?"Sua preparação está registrada. Acesse a consulta online no horário indicado.":"Sua preparação está registrada. Ao chegar, identifique-se na recepção.")</strong></aside>
    <details class="j-card cm-journey-step" open="@(j.PresencaConfirmadaEm==null)"><summary><h2>1. Confirmar presença</h2><span>@(j.PresencaConfirmadaEm!=null?"Concluído":"Pendente")</span></summary>
    @if(j.PresencaConfirmadaEm!=null){<p>Presença confirmada.</p>}else{<p>Seu horário já está agendado. Avise que pretende comparecer.</p><form asp-action="Mover" asp-route-id="@Model.Id" method="post"><input type="hidden" name="acao" value="confirmar"/><button type="submit" class="btn">Confirmar presença</button></form>}</details>
    <details class="j-card cm-journey-step" open="@(j.PresencaConfirmadaEm!=null&&j.CadastroEm==null)"><summary><h2>2. Conferir pré-cadastro</h2><span>@(j.CadastroEm!=null?"Concluído":"Pendente")</span></summary>
    <dl><dt>Nome</dt><dd>@Model.Paciente?.Nome</dd><dt>Telefone</dt><dd>@MKSANCrud.Services.Clinica.ContatoFormato.Telefone(Model.Paciente?.Telefone)</dd><dt>Pagamento</dt><dd>@Model.TipoPagamento @Model.ConvenioUsado</dd></dl><a asp-controller="MinhaConta" asp-action="Index">Corrigir meus dados</a>
    @if(j.CadastroEm==null){<form asp-action="Mover" asp-route-id="@Model.Id" method="post"><input name="acao" value="cadastro" type="hidden"/><label class="j-check"><input name="confirmar" type="checkbox" value="true" required/><span>Conferi meus dados e o pagamento ou convênio.</span></label><button class="btn" type="submit">Confirmar pré-cadastro</button></form>}</details>
    <details class="j-card cm-journey-step" open="@(j.CadastroEm!=null&&j.CheckInEm==null)"><summary><h2>3. Check-in antecipado</h2><span>@(j.CheckInEm!=null?"Concluído":"Nas 24 horas anteriores")</span></summary>
    <p>@(j.Tele?"Disponível a partir de 24 horas antes. Para participar por vídeo, use Acessar consulta online.":"Disponível a partir de 24 horas antes. Ao chegar, identifique-se na recepção para validar sua presença.")</p>
    @if(j.CheckInEm!=null){<p>Check-in registrado.</p>}else{<form asp-action="Mover" asp-route-id="@Model.Id" method="post"><input name="acao" value="checkin" type="hidden"/><button class="btn secondary" type="submit">Fazer check-in antecipado</button></form>}</details>
}
@if(equipe&&!encerrada){<section class="j-card"><h2>Recepção</h2><p>Paciente: @Model.Paciente?.Nome</p><p>Pré-cadastro: @(j.CadastroEm!=null?"conferido":"pendente") · Check-in: @(j.CheckInEm!=null?"feito":"pendente")</p><div class="j-actions">@foreach(var acao in new[]{"chegada","pagamento"}){<form asp-action="Mover" asp-route-id="@Model.Id" method="post"><input name="acao" value="@acao" type="hidden"/><input name="confirmar" value="true" type="hidden"/><button class="btn secondary" type="submit">@(acao=="chegada"?"Validar presença":"Confirmar conferência do pagamento")</button></form>}</div><p>@(j.PagamentoConferido?"Pagamento ou convênio conferido.":"Conferência pendente.")</p><form asp-action="Alocar" asp-route-id="@Model.Id" method="post" class="j-form"><label>Sala presencial<select name="salaId"><option value="">A informar</option>@foreach(var sala in (List<SalaAtendimento>)ViewBag.Salas){<option value="@sala.Id" selected="@(j.SalaId==sala.Id)">@sala.Nome</option>}</select></label><label>Duração em minutos<input type="number" name="duracao" value="@j.Duracao" min="5" max="240" required/></label><label>Modalidade do atendimento<select name="tele"><option value="false" selected="@(!j.Tele)">Presencial, na clínica</option><option value="true" selected="@j.Tele">Online, por vídeo</option></select></label><p>A sala física só é usada no atendimento presencial. Para a modalidade online, o paciente e o profissional acessam o vídeo pelas próprias contas.</p><button class="btn" type="submit">Salvar modalidade e sala</button></form></section>}
@if(m&&!encerrada){<section class="j-card"><h2>Atendimento profissional</h2>@if(j.Tele&&j.InicioEm==null){<p>Depois de encontrar o paciente na chamada, confira a identidade e inicie o atendimento. A consulta online não exige validação presencial pela recepção.</p>}<div class="j-actions">@foreach(var acao in (j.InicioEm==null?new[]{"iniciar"}:new[]{"concluir"})){<form asp-action="Mover" asp-route-id="@Model.Id" method="post"><input name="acao" value="@acao" type="hidden"/>@if(j.Tele&&acao=="iniciar"){<label class="j-check"><input type="checkbox" name="confirmar" value="true" required/><span>Conferi a identidade do paciente na chamada e posso iniciar o atendimento.</span></label>}<button class="btn" type="submit">@(acao=="iniciar"?"Iniciar atendimento":"Concluir atendimento")</button></form>}</div></section>}
@if(p||m){<section class="j-card" id="j-clinico"><h2>Preparação para a sessão</h2><p>Responda às perguntas do profissional para preparar seu atendimento. Se precisar de atendimento urgente, procure um serviço de urgência.</p>@Html.AntiForgeryToken()<p id="clinico-status" role="status" aria-live="polite">Carregando formulário…</p><details id="chaves"><summary>Configurar minha chave de acesso</summary><p>A chave protege suas respostas. Guarde a cópia com senha para acessar em outro dispositivo. Se perder todas as chaves e cópias, o servidor não consegue recuperar respostas antigas.</p><label>Senha da cópia (mínimo 12 caracteres)<input id="chave-senha" type="password" minlength="12" autocomplete="new-password"/></label><div class="j-actions"><button id="chave-criar" class="btn" type="button">Criar chave e baixar cópia</button><label>Restaurar cópia<input id="chave-restaurar" type="file" accept="application/json,.json"/></label></div></details><div id="clinico-conteudo"></div>
@if(Model.Medico?.EhPsicologia==true){<section aria-labelledby="titulo-registros"><h3 id="titulo-registros">Registros psicológicos</h3><p>Separados do formulário de preparação e do assistente virtual. A recepção e a administração não acessam o conteúdo.</p><div id="registros-conteudo"></div></section>}
@if(m){<details><summary>Publicar perguntas para minhas consultas</summary><p>Uma publicação cria uma nova versão. Formulários já respondidos preservam suas perguntas. A ferramenta não gera diagnósticos ou classificação clínica automática.</p><form asp-action="Formulario" asp-route-id="@Model.Id" method="post" class="j-form"><label>Título<input name="titulo" maxlength="120" required/></label><label>Perguntas (uma por linha, até 20)<textarea name="perguntas" maxlength="5500" rows="5" required></textarea></label><button class="btn" type="submit">Publicar formulário</button></form></details>}
</section>}
@if(m&&(bool)ViewBag.Menor){<section class="j-card"><h2>Autorização de responsável legal</h2><p>O atendimento de menor de idade exige conferência pelo profissional. Guarde a autorização e a documentação no acervo protegido da clínica; informe apenas a referência abaixo.</p>
@foreach(var a in (List<AutorizacaoResponsavel>)ViewBag.Autorizacoes){<p>@a.Nome · @a.Vinculo · @(a.RevogadaEm!=null?"Revogada":a.ValidaAte>DateTime.UtcNow?"Vigente":"Expirada")</p>@if(a.RevogadaEm==null){<form asp-controller="Psicologia" asp-action="RevogarResponsavel" method="post"><input name="id" value="@a.Id" type="hidden"/><input name="consultaId" value="@Model.Id" type="hidden"/><button class="btn secondary" type="submit">Revogar autorização de @a.Nome</button></form>}}
<form asp-controller="Psicologia" asp-action="Responsavel" asp-route-id="@Model.Id" method="post" class="j-form"><label>Nome do responsável<input name="nome" maxlength="150" required/></label><label>Vínculo e legitimidade conferidos<input name="vinculo" maxlength="80" required/></label><label>Referência da autorização guardada pela clínica<input name="referencia" maxlength="300" required/></label><label>Validade em dias<input name="dias" value="90" type="number" min="1" max="365" required/></label><label class="j-check"><input name="confirmar" type="checkbox" value="true" required/><span>Conferi a identidade, a legitimidade e a autorização do responsável, e avaliei a adequação do atendimento.</span></label><button class="btn" type="submit">Registrar conferência</button></form></section>}
</section><script src="~/js/fhir-clinico.js" asp-append-version="true" defer></script><script src="~/js/clinico.js" asp-append-version="true" defer></script>
