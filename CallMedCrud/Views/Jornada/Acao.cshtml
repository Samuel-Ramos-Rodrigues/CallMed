@model Consulta
@{Layout="_PublicLayout";ViewData["Title"]="Gerenciar minha consulta";}

<section class="jornada j-card"><h1>Gerenciar minha consulta</h1>@if(ViewBag.Token==null){<p role="status">@ViewBag.Resultado</p><a href="/Consulta">Ver minhas consultas</a>}else{<p>Consulta em @Model.Data.ToString("dd/MM/yyyy") às @Model.Horario.</p><p>Abrir este link não altera sua consulta. Escolha a ação abaixo.</p><div class="j-actions">@foreach(var acao in new[]{"confirmar","cancelar"}){<form action="/consulta-acao" method="post">@Html.AntiForgeryToken()<input name="token" value="@ViewBag.Token" type="hidden"/><input name="acao" value="@acao" type="hidden"/><button class="btn secondary" type="submit">@(acao=="confirmar"?"Confirmar consulta":"Cancelar e liberar horário")</button></form>}</div><details><summary>Escolher outro horário</summary><form action="/consulta-acao" method="post" class="j-form" id="link-form">@Html.AntiForgeryToken()<input name="token" value="@ViewBag.Token" type="hidden"/><input name="acao" value="remarcar" type="hidden"/><label>Nova data<select name="data" id="link-data" required><option value="">Escolha a data</option>@foreach(var d in (IReadOnlyList<DateTime>)ViewBag.Datas){<option value="@d.ToString("yyyy-MM-dd")">@d.ToString("dd/MM/yyyy")</option>}</select></label><label>Novo horário<select name="horario" id="link-horario" required disabled><option value="">Escolha uma data primeiro</option></select></label><p id="link-status" role="status"></p><button type="submit" class="btn">Confirmar reagendamento</button></form></details><p>Para preparar o atendimento ou acessar dados clínicos, <a href="/Consulta">entre em sua conta</a>.</p>}</section><script src="~/js/consulta-acao.js" asp-append-version="true" defer></script>
