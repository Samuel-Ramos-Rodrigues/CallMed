@model IEnumerable<MKSANCrud.Models.Especialidade>
@{ ViewData["Title"] = "Especialidades"; var lista=Model.ToList(); }
<section class="cm25-screen cm25-page v16-page" data-cm25-view="Especialidade/Index.cshtml"><div class="cm25-page-hero v16-page-head"><div class="cm25-hero-mark" aria-hidden="true"><svg><use href="/icons/callmed-ui.svg#spark"></use></svg></div><div><span class="cm25-kicker v16-eyebrow">CATÁLOGO DINÂMICO</span><h1>Especialidades</h1><p>As áreas oferecidas nascem dos médicos cadastrados; não existe mais um catálogo fixo independente.</p></div><a class="btn" asp-controller="Medico" asp-action="Create">+ Cadastrar médico</a></div>
<div class="cm25-panel v16-card table-card">@if(!lista.Any()){<div class="v16-empty"><strong>Nenhuma especialidade oferecida.</strong><p>Cadastre um médico para criar a primeira especialidade.</p></div>}else{<div class="table-scroll"><table class="v16-table"><thead><tr><th>Especialidade</th><th>Médicos ativos</th><th>Situação</th><th></th></tr></thead><tbody>@foreach(var item in lista){<tr><td><strong>@item.Nome</strong></td><td>@(item.Medicos?.Count(m=>m.Ativo) ?? 0)</td><td><span class="status-dot-pill @(item.Ativo?"active":"inactive")"><i></i>@(item.Ativo?"Ativa":"Inativa")</span></td><td><a class="btn small secondary" asp-action="Edit" asp-route-id="@item.Id">Editar</a></td></tr>}</tbody></table></div>}</div></section>
