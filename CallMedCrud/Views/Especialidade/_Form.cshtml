@model MKSANCrud.Models.Especialidade
<div asp-validation-summary="ModelOnly" class="validation"></div>
<div class="form-grid">
    <div class="field full">
        <label asp-for="Nome">Nome da especialidade</label>
        <input asp-for="Nome" placeholder="Ex.: Pediatria" />
        <span asp-validation-for="Nome" class="validation"></span>
    </div>
    <div class="field full check">
        <input asp-for="Ativo" />
        <label asp-for="Ativo">Especialidade ativa</label>
    </div>
</div>
