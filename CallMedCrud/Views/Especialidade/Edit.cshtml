@model MKSANCrud.Models.Especialidade
@{
    ViewData["Title"] = "Editar especialidade";
}
<div class="page-head"><h1>Editar especialidade</h1></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="form-card">
    <input asp-for="Id" type="hidden" />
    <partial name="_Form" model="Model" />
    <div class="form-actions">
        <button class="btn" type="submit">Salvar</button>
        <a class="btn secondary" asp-action="Index">Voltar</a>
    </div>
</form>
