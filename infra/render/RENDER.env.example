# Preserve as variáveis atuais de banco, Gmail/Brevo, Evolution, httpSMS, IA e TURN.
# Origem oficial, sem caminho. Troque se usar domínio próprio.
PublicOrigin=https://callmed.onrender.com
AllowedHosts=callmed.onrender.com;localhost;127.0.0.1
# Gere estes valores no seu computador com scripts/gerar-certificado-render.ps1 ou .sh.
DataProtection__CertificateBase64=PREENCHER_COM_O_PFX_EM_BASE64
DataProtection__CertificatePassword=PREENCHER_COM_A_SENHA_GERADA
# Alternativa ao job --migrate: true SOMENTE durante a primeira implantação V35.
Database__ApplyOnStartup=false
# Ao trocar certificado, mantenha anteriores para leitura das chaves antigas:
# DataProtection__PreviousCertificates__0=BASE64_DO_PFX_ANTERIOR
# Todos os PFX de PreviousCertificates usam CertificatePassword. Reexporte-os com
# a mesma senha antes de trocar a senha, sem alterar a chave privada do certificado.

# Opcional: embedded (padrão), external (worker separado) ou disabled
# Jobs__Mode=embedded
